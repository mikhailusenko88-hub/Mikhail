{"dur":326.07817750117283,"names":{"К103":"Рон","К105":"Филя","К102":"Пик","К101":"Барсик","К104":"Топа","Р":"Рассказчик"},"speech":[{"t":0.85,"dur":2.439,"who":"К103","name":"Рон","text":"Смотрите! Он опять повторяет за мной!","vocal":false},{"t":5.189,"dur":3.312,"who":"К103","name":"Рон","text":"Я машу — и он машет! Эй, хватит копировать!","vocal":false},{"t":9.701,"dur":1.126,"who":"К103","name":"Рон","text":"И прыгает со мной!","vocal":false},{"t":11.277,"dur":2.692,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":14.069,"dur":1.674,"who":"К102","name":"Пик","text":"Рон, это же твоё отражение.","vocal":false},{"t":16.043,"dur":4.288,"who":"К103","name":"Рон","text":"Такая же кепка. Такой же нос. Даже выражение мордочки моё!","vocal":false},{"t":20.63,"dur":0.96,"who":"К101","name":"Барсик","text":"Ах-ха-ха!","vocal":true},{"t":21.71,"dur":1.499,"who":"К101","name":"Барсик","text":"Вчера ты сам себя узнал.","vocal":false},{"t":23.509,"dur":2.733,"who":"К103","name":"Рон","text":"Узнал. Но почему оно всё за мной повторяет?","vocal":false},{"t":26.542,"dur":4.288,"who":"К102","name":"Пик","text":"Зеркало отражает свет. Свет от тебя попадает в зеркало, а от него — в твои глаза.","vocal":false},{"t":31.13,"dur":2.41,"who":"К105","name":"Филя","text":"Поэтому мы видим своё изображение?","vocal":false},{"t":33.84,"dur":1.833,"who":"К102","name":"Пик","text":"Да. Внутри нет другого щенка.","vocal":false},{"t":35.973,"dur":3.207,"who":"К103","name":"Рон","text":"Жаль. Я уже хотел попросить его убрать игрушки.","vocal":false},{"t":39.481,"dur":1.52,"who":"К104","name":"Топа","text":"Тогда придётся самому?","vocal":false},{"t":41.801,"dur":1.988,"who":"К103","name":"Рон","text":"Или позвать настоящих друзей!","vocal":false},{"t":44.089,"dur":2.532,"who":"К101","name":"Барсик","text":"А с друзьями можно поиграть в живое зеркало.","vocal":false},{"t":46.921,"dur":1.464,"who":"К105","name":"Филя","text":"Я хочу попробовать!","vocal":false},{"t":55.485,"dur":3.033,"who":"К103","name":"Рон","text":"Я показываю движение. Пик смотрит и повторяет.","vocal":false},{"t":58.818,"dur":1.324,"who":"К102","name":"Пик","text":"А потом поменяемся ролями.","vocal":false},{"t":64.042,"dur":0.824,"who":"К104","name":"Топа","text":"Получилось!","vocal":false},{"t":65.165,"dur":1.006,"who":"К103","name":"Рон","text":"Теперь веди ты.","vocal":false},{"t":70.072,"dur":1.89,"who":"К103","name":"Рон","text":"Ура! Я умею быть зеркалом!","vocal":false},{"t":72.262,"dur":3.308,"who":"К105","name":"Филя","text":"А настоящее зеркало может придумать своё движение?","vocal":false},{"t":75.87,"dur":4.724,"who":"К101","name":"Барсик","text":"Нет. Отражение повторяет тебя. А друг сам решает, что делать.","vocal":false},{"t":80.894,"dur":2.272,"who":"К104","name":"Топа","text":"Поэтому мы и можем меняться ролями.","vocal":false},{"t":84.866,"dur":1.724,"who":"К105","name":"Филя","text":"Можно теперь я попробую?","vocal":false},{"t":86.89,"dur":1.874,"who":"К103","name":"Рон","text":"Конечно. Смотри на меня.","vocal":false},{"t":93.965,"dur":2.204,"who":"К104","name":"Топа","text":"Филя повторил каждое движение!","vocal":false},{"t":96.469,"dur":0.98,"who":"К105","name":"Филя","text":"Это весело!","vocal":false},{"t":97.749,"dur":3.554,"who":"К102","name":"Пик","text":"А теперь сыграем иначе. Сначала посмотри, потом повтори по памяти.","vocal":false},{"t":101.603,"dur":1.416,"who":"К101","name":"Барсик","text":"Начнём с двух движений.","vocal":false},{"t":103.319,"dur":3.671,"who":"К103","name":"Рон","text":"Я покажу их целиком. Ты дождись, когда я закончу.","vocal":false},{"t":113.49,"dur":2.528,"who":"К105","name":"Филя","text":"Ой. Я начал с поклона.","vocal":false},{"t":116.319,"dur":3.058,"who":"К103","name":"Рон","text":"Движения ты запомнил. Только поменял их местами.","vocal":false},{"t":121.077,"dur":2.248,"who":"К105","name":"Филя","text":"Когда смотрел, всё было легко.","vocal":false},{"t":123.624,"dur":1.851,"who":"К104","name":"Топа","text":"А повторять по памяти труднее.","vocal":false},{"t":125.775,"dur":1.422,"who":"К102","name":"Пик","text":"Придумаем короткую подсказку.","vocal":false},{"t":127.498,"dur":2.209,"who":"К103","name":"Рон","text":"Сначала привет, потом поклон!","vocal":false},{"t":130.006,"dur":1.08,"who":"К101","name":"Барсик","text":"Покажем медленно.","vocal":false},{"t":132.986,"dur":0.57,"who":"К103","name":"Рон","text":"Привет.","vocal":false},{"t":136.856,"dur":0.705,"who":"К103","name":"Рон","text":"Поклон.","vocal":false},{"t":137.861,"dur":2.201,"who":"К105","name":"Филя","text":"Сначала привет, потом поклон.","vocal":false},{"t":142.962,"dur":0.824,"who":"К104","name":"Топа","text":"Получилось!","vocal":false},{"t":144.085,"dur":2.363,"who":"К105","name":"Филя","text":"Слова помогли мне вспомнить порядок.","vocal":false},{"t":146.749,"dur":1.953,"who":"К103","name":"Рон","text":"Теперь мы очень вежливые зеркала!","vocal":false},{"t":149.001,"dur":1.921,"who":"К102","name":"Пик","text":"И умеем здороваться до прощального поклона.","vocal":false},{"t":151.372,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":156.959,"dur":3.704,"who":"Р","name":"Рассказчик","text":"На площадке друзья добавили к игре новое движение.","vocal":false},{"t":160.963,"dur":1.86,"who":"К104","name":"Топа","text":"После поклона будет хлопок.","vocal":false},{"t":163.123,"dur":2.299,"who":"К105","name":"Филя","text":"Значит, теперь надо запомнить три?","vocal":false},{"t":165.722,"dur":2.692,"who":"К101","name":"Барсик","text":"Первые два ты уже знаешь. Добавим к ним одно.","vocal":false},{"t":174.915,"dur":1.868,"who":"К105","name":"Филя","text":"Привет, поклон, хлопок.","vocal":false},{"t":181.283,"dur":1.422,"who":"К102","name":"Пик","text":"Ты повторил все три по порядку!","vocal":false},{"t":183.005,"dur":2.265,"who":"К105","name":"Филя","text":"И никто не подсказывал движениями!","vocal":false},{"t":185.57,"dur":1.651,"who":"К104","name":"Топа","text":"Хочешь теперь показать нам?","vocal":false},{"t":187.52,"dur":2.764,"who":"К105","name":"Филя","text":"Я? А если вы не поймёте?","vocal":false},{"t":190.584,"dur":2.161,"who":"К103","name":"Рон","text":"Объяснишь. Мы ведь тоже учимся.","vocal":false},{"t":194.445,"dur":5.091,"who":"К105","name":"Филя","text":"Тогда новая задача. Проверяем порядок: привет, поклон, хлопок.","vocal":false},{"t":199.836,"dur":1.375,"who":"К104","name":"Топа","text":"А кто будет показывать?","vocal":false},{"t":201.51,"dur":2.566,"who":"К103","name":"Рон","text":"Я! И специально что-нибудь перепутаю.","vocal":false},{"t":204.377,"dur":3.248,"who":"К105","name":"Филя","text":"Мы сначала досмотрим, а потом назовём замену.","vocal":false},{"t":212.224,"dur":1.935,"who":"К105","name":"Филя","text":"Какое движение Рон заменил?","vocal":false},{"t":217.46,"dur":1.379,"who":"К102","name":"Пик","text":"Вместо поклона он присел.","vocal":false},{"t":219.138,"dur":1.962,"who":"К104","name":"Топа","text":"А привет и хлопок оставил.","vocal":false},{"t":221.4,"dur":2.115,"who":"К103","name":"Рон","text":"Проверял, хорошо ли видно снизу!","vocal":false},{"t":223.814,"dur":0.966,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":224.9,"dur":2.847,"who":"К105","name":"Филя","text":"Видно. Но в нашем порядке нужен поклон.","vocal":false},{"t":232.248,"dur":1.235,"who":"К101","name":"Барсик","text":"Теперь всё по порядку.","vocal":false},{"t":233.783,"dur":1.519,"who":"К105","name":"Филя","text":"Я сам провёл игру!","vocal":false},{"t":235.602,"dur":2.396,"who":"К103","name":"Рон","text":"А я сам запутал. И сам исправил!","vocal":false},{"t":239.697,"dur":4.962,"who":"К105","name":"Филя","text":"А теперь снова живое зеркало. Повторяйте каждое движение сразу за мной!","vocal":false},{"t":244.959,"dur":0.888,"who":"К101","name":"Барсик","text":"Все готовы?","vocal":false},{"t":246.147,"dur":0.373,"who":"К105","name":"Филя","text":"Да!","vocal":false},{"t":246.147,"dur":0.428,"who":"К101","name":"Барсик","text":"Да!","vocal":false},{"t":256.374,"dur":0.725,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":257.219,"dur":1.847,"who":"К103","name":"Рон","text":"Целая команда прыгающих зеркал!","vocal":false},{"t":259.367,"dur":1.385,"who":"К105","name":"Филя","text":"И все смотрят на меня!","vocal":false},{"t":261.052,"dur":3.551,"who":"К104","name":"Топа","text":"Ты показывал понятно. Нам было легко повторять.","vocal":false},{"t":264.902,"dur":1.948,"who":"К101","name":"Барсик","text":"Теперь у нас есть ещё один ведущий.","vocal":false},{"t":267.151,"dur":2.519,"who":"К103","name":"Рон","text":"А я хочу показать самое сонное движение.","vocal":false},{"t":270.12,"dur":1.574,"who":"К103","name":"Рон","text":"А-а-а-ах.","vocal":true},{"t":272.12,"dur":1.317,"who":"К102","name":"Пик","text":"А-а-а-ах.","vocal":true},{"t":274.12,"dur":2.211,"who":"К104","name":"Топа","text":"А-а-а-ах.","vocal":true},{"t":276.581,"dur":1.464,"who":"К105","name":"Филя","text":"А-а-а-ах.","vocal":true},{"t":278.431,"dur":2.52,"who":"К101","name":"Барсик","text":"Кажется, эту игру пора заканчивать.","vocal":false},{"t":281.251,"dur":2.771,"who":"К103","name":"Рон","text":"Осторожно. Следующее движение — спать!","vocal":false},{"t":284.322,"dur":2.692,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":284.322,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":284.322,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":284.322,"dur":1.642,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":284.322,"dur":2.643,"who":"К104","name":"Топа","text":"Ха-ха-ха-ха!","vocal":true},{"t":293.478,"dur":2.52,"who":"К104","name":"Топа","text":"Смотрите, дуб! А здесь лежит жёлудь.","vocal":false},{"t":296.898,"dur":1.193,"who":"К105","name":"Филя","text":"Такой маленький.","vocal":false},{"t":298.392,"dur":1.541,"who":"К103","name":"Рон","text":"И со своей шапочкой!","vocal":false},{"t":300.233,"dur"