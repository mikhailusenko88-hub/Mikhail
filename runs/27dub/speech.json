{"dur":345.33068597969486,"names":{"К103":"Рон","К102":"Пик","К104":"Топа","К105":"Филя","К101":"Барсик","Р":"Рассказчик"},"speech":[{"t":1.95,"dur":1.608,"who":"К103","name":"Рон","text":"Бульк! Камень утонул!","vocal":false},{"t":3.858,"dur":2.713,"who":"К102","name":"Пик","text":"Смотрите, а вот лодка! Большая — и не тонет!","vocal":false},{"t":6.871,"dur":3.885,"who":"К103","name":"Рон","text":"Нечестно! Маленький камень тонет, а большая лодка плавает!","vocal":false},{"t":11.055,"dur":0.967,"who":"К104","name":"Топа","text":"Почему так?","vocal":false},{"t":12.472,"dur":2.692,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":16.364,"dur":1.757,"who":"К105","name":"Филя","text":"Рон, а зонтик зачем?","vocal":false},{"t":18.421,"dur":3.677,"who":"К103","name":"Рон","text":"Мы раскрываем секрет лодки. Вдруг секрет окажется мокрым!","vocal":false},{"t":22.398,"dur":2.339,"who":"К105","name":"Филя","text":"Даже кепку приготовился защищать?","vocal":false},{"t":25.037,"dur":2.047,"who":"К103","name":"Рон","text":"Конечно. Она плавать не умеет.","vocal":false},{"t":27.884,"dur":3.308,"who":"К103","name":"Рон","text":"Может, лодка училась плавать? А камень прогуливал!","vocal":false},{"t":31.492,"dur":0.96,"who":"К101","name":"Барсик","text":"Ах-ха-ха!","vocal":true},{"t":32.572,"dur":1.441,"who":"К101","name":"Барсик","text":"Тогда кто учил лодку?","vocal":false},{"t":35.913,"dur":1.37,"who":"К103","name":"Рон","text":"Очень терпеливая рыба?","vocal":false},{"t":37.582,"dur":2.574,"who":"К102","name":"Пик","text":"Давайте найдём объяснение, которое можно проверить.","vocal":false},{"t":45.457,"dur":2.143,"who":"К101","name":"Барсик","text":"Вот точно такой же камень, как утонул.","vocal":false},{"t":48.9,"dur":2.944,"who":"К103","name":"Рон","text":"Здравствуйте. Сегодня вопросов будет больше.","vocal":false},{"t":52.144,"dur":3.143,"who":"К105","name":"Филя","text":"Он маленький. Но тяжёлый для своего размера.","vocal":false},{"t":55.587,"dur":2.979,"who":"К104","name":"Топа","text":"А лодка большая. И ещё людей возит.","vocal":false},{"t":58.866,"dur":2.11,"who":"К102","name":"Пик","text":"Значит, одного размера для ответа мало.","vocal":false},{"t":61.775,"dur":1.475,"who":"К101","name":"Барсик","text":"Из чего делают лодки?","vocal":false},{"t":66.55,"dur":0.809,"who":"К104","name":"Топа","text":"Из дерева!","vocal":false},{"t":67.659,"dur":1.896,"who":"К103","name":"Рон","text":"Разгадали! Дерево плавает.","vocal":false},{"t":69.855,"dur":1.655,"who":"К102","name":"Пик","text":"Но бывают и металлические корабли.","vocal":false},{"t":71.86,"dur":0.538,"who":"К103","name":"Рон","text":"Ого!","vocal":true},{"t":72.61,"dur":1.956,"who":"К103","name":"Рон","text":"Металлические? Как ложка?","vocal":false},{"t":74.866,"dur":3.326,"who":"К102","name":"Пик","text":"Да. Обычная металлическая ложка тонет. А корабль может плавать.","vocal":false},{"t":78.491,"dur":2.488,"who":"К105","name":"Филя","text":"Тогда надо искать другую подсказку.","vocal":false},{"t":82.68,"dur":3.942,"who":"Р","name":"Рассказчик","text":"Друзья отправились на кухню сравнить знакомые предметы.","vocal":false},{"t":87.522,"dur":2.485,"who":"К103","name":"Рон","text":"Чем не корабль? Даже длинный хвост есть!","vocal":false},{"t":90.907,"dur":2.062,"who":"К104","name":"Топа","text":"А это похоже на круглую лодку.","vocal":false},{"t":93.268,"dur":3.784,"who":"К105","name":"Филя","text":"У неё есть дно и стенки. А внутри свободное место!","vocal":false},{"t":97.603,"dur":1.71,"who":"К103","name":"Рон","text":"И обед далеко искать не надо.","vocal":false},{"t":99.613,"dur":1.288,"who":"К104","name":"Топа","text":"Ха-ха-ха-ха!","vocal":true},{"t":101.02,"dur":3.495,"who":"К104","name":"Топа","text":"Если туда налить суп, свободного места станет меньше.","vocal":false},{"t":104.816,"dur":3.049,"who":"К102","name":"Пик","text":"Филя заметил важное отличие. Корабль внутри тоже не сплошной.","vocal":false},{"t":108.164,"dur":2.066,"who":"К101","name":"Барсик","text":"Но почему это помогает ему плавать?","vocal":false},{"t":111.53,"dur":1.07,"who":"К105","name":"Филя","text":"Пока не знаю.","vocal":false},{"t":112.9,"dur":2.273,"who":"К102","name":"Пик","text":"У меня есть книга о кораблях. Поищем ответ.","vocal":false},{"t":115.473,"dur":3.166,"who":"К103","name":"Рон","text":"Хорошо. Кастрюля всё равно ничего не рассказывает.","vocal":false},{"t":126.766,"dur":3.487,"who":"К105","name":"Филя","text":"Вода выталкивает погружённые в неё предметы вверх","vocal":false},{"t":130.554,"dur":0.98,"who":"К103","name":"Рон","text":"Даже камень?","vocal":false},{"t":131.833,"dur":1.948,"who":"К102","name":"Пик","text":"Даже камень. Но удержать его не может.","vocal":false},{"t":138.49,"dur":3.668,"who":"К101","name":"Барсик","text":"Корпус корабля делают полым. Внутри остаётся место для воздуха","vocal":false},{"t":142.457,"dur":3.532,"who":"К104","name":"Топа","text":"Значит, большой корабль не набит металлом целиком!","vocal":false},{"t":146.29,"dur":2.663,"who":"К102","name":"Пик","text":"Да. Он занимает много места в воде и раздвигает её.","vocal":false},{"t":149.252,"dur":1.628,"who":"К101","name":"Барсик","text":"А вода толкает корабль вверх.","vocal":false},{"t":151.18,"dur":1.781,"who":"К105","name":"Филя","text":"И удерживает весь его вес?","vocal":false},{"t":153.261,"dur":3.416,"who":"К101","name":"Барсик","text":"Верно. Если корабль не слишком тяжёлый для своего размера.","vocal":false},{"t":156.977,"dur":2.993,"who":"К103","name":"Рон","text":"Теперь понятно, зачем ему столько места внутри!","vocal":false},{"t":162.17,"dur":3.185,"who":"К104","name":"Топа","text":"Тогда в корабль можно складывать сколько угодно вещей?","vocal":false},{"t":166.655,"dur":1.872,"who":"К105","name":"Филя","text":"Каждая вещь добавляет вес.","vocal":false},{"t":168.827,"dur":2.622,"who":"К102","name":"Пик","text":"Верно. Если перегрузить корабль, он может утонуть.","vocal":false},{"t":171.75,"dur":1.931,"who":"К103","name":"Рон","text":"Даже если вещи очень нужные?","vocal":false},{"t":173.981,"dur":0.799,"who":"К101","name":"Барсик","text":"Даже тогда.","vocal":false},{"t":175.08,"dur":2.352,"who":"К103","name":"Рон","text":"Придётся оставить коллекцию камней дома.","vocal":false},{"t":177.732,"dur":2.179,"who":"К104","name":"Топа","text":"А если внутрь попадёт много воды?","vocal":false},{"t":180.211,"dur":2.144,"who":"К105","name":"Филя","text":"Корабль тоже станет тяжелее!","vocal":false},{"t":182.655,"dur":2.12,"who":"К102","name":"Пик","text":"Поэтому важно, чтобы корпус был целым.","vocal":false},{"t":186.675,"dur":2.833,"who":"К103","name":"Рон","text":"Снаружи вода помогает. А внутри может мешать.","vocal":false},{"t":190.708,"dur":3.134,"who":"К105","name":"Филя","text":"Кажется, я придумал, как проверить, что мы поняли.","vocal":false},{"t":194.142,"dur":1.117,"who":"К104","name":"Топа","text":"Проведёшь игру?","vocal":false},{"t":195.559,"dur":0.906,"who":"К105","name":"Филя","text":"Попробую.","vocal":false},{"t":198.766,"dur":1.346,"who":"К103","name":"Рон","text":"У нас будет капитан!","vocal":false},{"t":201.706,"dur":1.932,"who":"К104","name":"Топа","text":"Капитан Мишка готов слушать.","vocal":false},{"t":203.938,"dur":5.613,"who":"К105","name":"Филя","text":"Я буду говорить. Если согласны — кивните. Если нет — покачайте головой.","vocal":false},{"t":209.851,"dur":0.743,"who":"К101","name":"Барсик","text":"Начинай!","vocal":false},{"t":210.894,"dur":2.471,"who":"К105","name":"Филя","text":"Маленький предмет обязательно плавает.","vocal":false},{"t":217.665,"dur":2.229,"who":"К103","name":"Рон","text":"Нет. Маленький камень может утонуть.","vocal":false},{"t":221.095,"dur":1.423,"who":"К104","name":"Топа","text":"Капитан согласен!","vocal":false},{"t":222.817,"dur":3.096,"who":"К105","name":"Филя","text":"Вода толкает вверх только деревянные предметы.","vocal":false},{"t":230.213,"dur":1.526,"who":"К102","name":"Пик","text":"Нет. Металлические тоже.","vocal":false},{"t":232.039,"dur":2.045,"who":"К103","name":"Рон","text":"Просто ложку удержать не получается.","vocal":false},{"t":234.534,"dur":0.675,"who":"К105","name":"Филя","text":"Ура-а!","vocal":true},{"t":236.184,"dur":2.476,"who":"К105","name":"Филя","text":"Правильно! А теперь самый хитрый вопрос.","vocal":false},{"t":240.36,"dur":3.345,"who":"К105","name":"Филя","text":"Если в лодке есть воздух, она никогда не утонет.","vocal":false},{"t":247.906,"dur":1.857,"who":"К103","name":"Рон","text":"Есть воздух — можно плыть!","vocal":false},{"t":251.313,"dur":1.953,"who":"К103","name":"Рон","text":"Стойте. Я что-то забыл.","vocal":false},{"t":253.565,"dur":3.061,"who":"К105","name":"Филя","text":"А если положить туда всю твою коллекцию камней?","vocal":false},{"t":258.526,"dur":1.934,"who":"К103","name":"Рон","text":"Она станет слишком тяжёлой!","vocal":false},{"t":260.761,"dur":5.583,"who":"К105","name":"Филя","text":"Да. Лодку поддерживает вода. Но слишком тяжёлую лодку она не удержит.","vocal":false},{"t":267.644,"dur":2.804,"who":"К103","name":"Рон","text":"Тогда меняю ответ. Лодку нельзя перегружать.","vocal":false},{"t":270.747,"dur":1.847,"who":"К104","name":"Топа","text":"Капитан Мишка доволен!","vocal":false},{"t":272.894,"dur":1.756,"who":"К101","name":"Барсик","text":"Филя, ты придумал хороший вопрос.","vocal":false},{"t":274.95,"dur":1.575,"who":"К105","name":"Филя","text":"Я боялся запутаться.","vocal":false},{"t":276.825,"dur":1.53,"who":"К103","name":"Рон","text":"А помог разобраться мне!","vocal":false},{"t":281.946,"dur":3.156,"who":"К104","name":"Топа","text":"Держи. Капитан хочет тебя поблагодарить.","vocal":false},{"t":286.402,"dur":2.206,"who":"К105","name":"Филя","text":"Спасибо за службу, капитан!","vocal":false},{"t":288.908,"dur":2.868,"who":"К103","name":"Рон","text":"Теперь ему положен отпуск. На сухой подушке!","vocal":false},{"t":292.076,"dur":2.692,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":292.076,"dur":1.587,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":292.076,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":292.076,"dur":2.748,"who":"К104","name":"Топа","text":"Ха-ха-ха-ха!","vocal":true},{"t":292.076,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":297.444,"dur":2.851,"who":"К103","name":"Рон","text":"Секрет раскрыли. И даже кепку не намочили!","vocal":false},{"t":300.595,"dur":2.056,"who":"К101","name":"Барсик","text":"А дома вас ждёт ещё одна загадка.","vocal":false},{"t":302.95,"dur":1.752,"who":"К103","name":"Рон","text":"Надеюсь, тоже сухая!","vocal":false},{"t":306.402,"dur":3.096,"who":"Р","name":"Рассказчик","text":"Дома Барсик приготовил новую загадку.","vocal":false},{"t":310.898,"dur":2.728,"who":"К101","name":"Барсик","text":"Кто повторяет твои движения, но живёт в стекле?","vocal":false},{"t":316.925,"dur":2.004,"who":"К103","name":"Рон","text":"Тень? Мы с ней уже знакомы!","vocal":false},{"t":319.229,"dur":1.445,"who":"К105","name":"Филя","text":"Тень в стекле не живёт.","vocal":false},{"t":322.29,"dur":1.176,"who":"К103","name":"Рон","text":"О, это я!","vocal":false},{"t":323.765,"dur":0.535,"who":"К102","name":"Пик","text":"Узнал?","vocal":false},{"t":324.6,"dur":2.937,"who":"К103","name":"Рон","text":"Да. Но почему отражение всё за мной повторяет?","vocal":false},{"t":327.838,"dur":1.964,"who":"К104","name":"Топа","text":"Даже когда ты ничего не просишь?","vocal":false},{"t":330.102,"dur":1.149,"who":"К103","name":"Рон","text":"Особенно тогда!","vocal":false},{"t":331.551,"dur":1.974,"who":"К101","name":"Барсик","text":"Завтра раскроем секрет зеркальца.","vocal":false},{"t":333.824,"dur":3.13,"who":"К103","name":"Рон","text":"Тогда завтра причешусь. Нас там всё-таки двое!","vocal":false},{"t":338.855,"dur":4.876,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"берег речки, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"beach\",\"weather\":\"none\"}"},{"t0":41.257,"kind":"title","loc":""},{"t0":44.257,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"двор, утро\",\"seed\":102,\"time\":\"day\",\"type\":\"yard\",\"weather\":\"none\"}"},{"t0":82.08,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"кухня, день\",\"seed\":103,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":119.739,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"комната, день\",\"seed\":104,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":161.57,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"комната, день\",\"seed\":104,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":197.566,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"комната, день\",\"seed\":104,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":239.76,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"комната, день\",\"seed\":104,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":296.244,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"двор, вечер\",\"seed\":105,\"time\":\"evening\",\"type\":\"yard\",\"weather\":\"none\"}"},{"t0":305.802,"kind":"scene","loc":"{\"id\":\"Л106\",\"name\":\"комната, вечер\",\"seed\":106,\"time\":\"evening\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":338.055,"kind":"end","loc":""}]}