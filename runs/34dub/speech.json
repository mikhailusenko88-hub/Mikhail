{"dur":348.1855531720264,"names":{"К103":"Рон","К105":"Филя","К104":"Топа","К102":"Пик","К101":"Барсик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":2.178,"who":"К103","name":"Рон","text":"Смотрите! Вот он! Росток!","vocal":false},{"t":3.228,"dur":3.149,"who":"К103","name":"Рон","text":"Доброе утро, малыш. Это я, твой сторож.","vocal":false},{"t":6.827,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":9.31,"dur":2.07,"who":"К104","name":"Топа","text":"Он вылез прямо из жёлудя!","vocal":false},{"t":14.48,"dur":2.888,"who":"К102","name":"Пик","text":"Вот корешок. Белый, тоненький. Он ушёл в землю.","vocal":false},{"t":17.668,"dur":2.379,"who":"К101","name":"Барсик","text":"А стебелёк смотрит вверх. К солнцу.","vocal":false},{"t":20.347,"dur":3.675,"who":"К105","name":"Филя","text":"А как он узнал, где верх? Он же только проснулся!","vocal":false},{"t":24.321,"dur":2.858,"who":"К103","name":"Рон","text":"Может, ему кто-то подсказал? Шёпотом.","vocal":false},{"t":27.98,"dur":3.619,"who":"К101","name":"Барсик","text":"Жёлудь на боку. А корешок всё равно повернул вниз.","vocal":false},{"t":31.899,"dur":4.595,"who":"К102","name":"Пик","text":"Корешок чувствует, где низ. Земля тянет всё вниз — и яблоко, и камешек, и нас.","vocal":false},{"t":36.794,"dur":0.63,"who":"К103","name":"Рон","text":"И меня?","vocal":false},{"t":38.625,"dur":1.783,"who":"К103","name":"Рон","text":"Правда! Я снова внизу.","vocal":false},{"t":40.858,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":42.852,"dur":4.188,"who":"К102","name":"Пик","text":"Вот и корешок это чувствует. Поэтому он всегда растёт вниз, в землю. Там вода.","vocal":false},{"t":47.339,"dur":3.259,"who":"К101","name":"Барсик","text":"А стебелёк ищет свет. Поэтому он растёт вверх.","vocal":false},{"t":50.898,"dur":3.232,"who":"К103","name":"Рон","text":"Корешок — вниз, стебелёк — вверх. А я?","vocal":false},{"t":54.48,"dur":0.456,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":55.43,"dur":1.652,"who":"К103","name":"Рон","text":"А я — во все стороны!","vocal":false},{"t":57.381,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":57.381,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":57.381,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":57.381,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":57.381,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":62.384,"dur":3.962,"who":"К105","name":"Филя","text":"Корешок — вниз, к воде. Стебелёк — вверх, к солнцу","vocal":false},{"t":71.646,"dur":4.048,"who":"К103","name":"Рон","text":"Росток, наверное, проголодался. Отнесу ему печенье!","vocal":false},{"t":75.994,"dur":0.622,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":76.736,"dur":1.754,"who":"К102","name":"Пик","text":"Рон, ростки не едят печенье.","vocal":false},{"t":78.79,"dur":1.833,"who":"К103","name":"Рон","text":"Совсем? Даже с изюмом?","vocal":false},{"t":80.923,"dur":2.542,"who":"К101","name":"Барсик","text":"У ростка свой обед. Он внутри жёлудя.","vocal":false},{"t":83.765,"dur":2.237,"who":"К104","name":"Топа","text":"В жёлуде? Там же пусто!","vocal":false},{"t":86.303,"dur":4.421,"who":"К102","name":"Пик","text":"Не пусто. В жёлуде спрятан запас еды. Росток ест его, пока у него мало листиков.","vocal":false},{"t":91.024,"dur":1.362,"who":"К105","name":"Филя","text":"Как обед в дорогу!","vocal":false},{"t":92.687,"dur":2.82,"who":"К101","name":"Барсик","text":"Точно. Жёлудь для ростка — как обед в дорогу.","vocal":false},{"t":95.807,"dur":2.141,"who":"К103","name":"Рон","text":"Значит, печенье опять моё.","vocal":false},{"t":100.448,"dur":1.367,"who":"К103","name":"Рон","text":"Очень вкусный запас.","vocal":false},{"t":102.265,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха-ха!","vocal":true},{"t":103.915,"dur":2.236,"who":"К104","name":"Топа","text":"Рон, у тебя крошки на носу.","vocal":false},{"t":106.451,"dur":1.968,"who":"К103","name":"Рон","text":"Это тоже запас. На потом.","vocal":false},{"t":110.119,"dur":4.791,"who":"К103","name":"Рон","text":"Смотрите, вот наш росток. Наверное, хочет пить. Я его полью!","vocal":false},{"t":118.41,"dur":2.428,"who":"К103","name":"Рон","text":"Пей, малыш! Ещё! И ещё!","vocal":false},{"t":121.138,"dur":1.445,"who":"К102","name":"Пик","text":"Стой, Рон! Хватит!","vocal":false},{"t":122.883,"dur":2.038,"who":"К101","name":"Барсик","text":"Ой! Смотрите, вот лужа!","vocal":false},{"t":125.221,"dur":1.731,"who":"К103","name":"Рон","text":"Я немножко перестарался.","vocal":false},{"t":127.252,"dur":4.054,"who":"К102","name":"Пик","text":"Корешку нужна вода. Но и воздух тоже. Если залить землю, ему нечем дышать.","vocal":false},{"t":131.605,"dur":3.145,"who":"К104","name":"Топа","text":"Помните нашу лужу? Солнце её выпьет.","vocal":false},{"t":135.05,"dur":1.166,"who":"К105","name":"Филя","text":"А ветер поможет!","vocal":false},{"t":137.016,"dur":3.401,"who":"К103","name":"Рон","text":"Тогда я буду поливать понемножку. Одну чашечку в день.","vocal":false},{"t":140.717,"dur":1.052,"who":"К101","name":"Барсик","text":"Вот это правильно.","vocal":false},{"t":143.469,"dur":1.924,"who":"К101","name":"Барсик","text":"Смотрите, вот цветок на окне.","vocal":false},{"t":145.693,"dur":2.029,"who":"К105","name":"Филя","text":"Он повернул листики к окну!","vocal":false},{"t":148.022,"dur":3.137,"who":"К102","name":"Пик","text":"Растения любят свет. Листики ловят солнце, как ладошки.","vocal":false},{"t":151.459,"dur":1.27,"who":"К104","name":"Топа","text":"А зачем им солнце?","vocal":false},{"t":153.029,"dur":4.026,"who":"К102","name":"Пик","text":"Чтобы готовить себе сладкий сок. Для этого нужны вода, воздух и солнечный свет.","vocal":false},{"t":157.355,"dur":3.498,"who":"К103","name":"Рон","text":"Из солнца можно сделать что-то вкусное? А печенье можно?","vocal":false},{"t":161.153,"dur":0.74,"who":"К101","name":"Барсик","text":"Ха-ха!","vocal":true},{"t":162.014,"dur":3.81,"who":"К101","name":"Барсик","text":"Печенье — нет. А сладкий сок для листика — да.","vocal":false},{"t":166.124,"dur":4.612,"who":"К105","name":"Филя","text":"Значит, когда обед в жёлуде кончится, росток будет кушать солнце!","vocal":false},{"t":171.036,"dur":2.083,"who":"К102","name":"Пик","text":"Правильно. Поэтому ему так нужны листики.","vocal":false},{"t":173.419,"dur":3.329,"who":"К103","name":"Рон","text":"Тогда я тоже постою на солнышке. Вдруг наемся.","vocal":false},{"t":178.848,"dur":2.262,"who":"К103","name":"Рон","text":"Нет. Всё равно хочу печенье.","vocal":false},{"t":181.409,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":181.409,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":181.409,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":181.409,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":181.409,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":184.792,"dur":6.19,"who":"К104","name":"Топа","text":"Смотрите, вот наш росток. Вдруг кто-нибудь на него наступит? Он же маленький.","vocal":false},{"t":191.882,"dur":1.341,"who":"К104","name":"Топа","text":"Поставим заборчик.","vocal":false},{"t":196.519,"dur":1.439,"who":"К103","name":"Рон","text":"А я нарисую табличку!","vocal":false},{"t":201.858,"dur":1.594,"who":"К103","name":"Рон","text":"Тихо! Тут растёт дуб!","vocal":false},{"t":203.752,"dur":1.463,"who":"К105","name":"Филя","text":"Но это же ещё не дуб.","vocal":false},{"t":205.515,"dur":2.097,"who":"К103","name":"Рон","text":"Пусть привыкает. Будет большим.","vocal":false},{"t":207.912,"dur":2.691,"who":"К101","name":"Барсик","text":"Хороший заборчик. Теперь никто не наступит.","vocal":false},{"t":212.303,"dur":1.658,"who":"К101","name":"Барсик","text":"Смотрите, вот большой дуб!","vocal":false},{"t":214.26,"dur":2.422,"who":"К104","name":"Топа","text":"Неужели наш малыш станет таким же?","vocal":false},{"t":216.982,"dur":2.791,"who":"К102","name":"Пик","text":"Станет. Только не скоро. Дубы растут очень медленно.","vocal":false},{"t":220.073,"dur":2.479,"who":"К101","name":"Барсик","text":"Этому дубу, наверное, больше ста лет.","vocal":false},{"t":222.853,"dur":3.38,"who":"К103","name":"Рон","text":"Ста лет? Я столько не высижу. Даже с печеньем.","vocal":false},{"t":226.683,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":228.916,"dur":2.57,"who":"К103","name":"Рон","text":"Какой высокий! У меня голова закружилась.","vocal":false},{"t":232.586,"dur":2.32,"who":"К102","name":"Пик","text":"Когда-то этот великан тоже был совсем крошечным.","vocal":false},{"t":235.206,"dur":1.6,"who":"К105","name":"Филя","text":"И тоже вылез из жёлудя?","vocal":false},{"t":237.106,"dur":1.814,"who":"К102","name":"Пик","text":"Да. Из одного маленького жёлудя.","vocal":false},{"t":239.22,"dur":2.706,"who":"К104","name":"Топа","text":"Значит, и наш малыш будет великаном!","vocal":false},{"t":242.226,"dur":2.375,"who":"К103","name":"Рон","text":"А я — сторож великана. Звучит!","vocal":false},{"t":246.301,"dur":3.386,"who":"К105","name":"Филя","text":"Давайте поиграем! Я спрашиваю, а вы отвечаете.","vocal":false},{"t":249.987,"dur":0.743,"who":"К101","name":"Барсик","text":"Начинай!","vocal":false},{"t":251.03,"dur":1.456,"who":"К105","name":"Филя","text":"Куда растёт корешок?","vocal":false},{"t":255.786,"dur":1.077,"who":"К104","name":"Топа","text":"Вниз! В землю!","vocal":false},{"t":257.163,"dur":2.926,"who":"К105","name":"Филя","text":"Правильно! А что ест росток, пока он маленький?","vocal":false},{"t":263.389,"dur":1.161,"who":"К102","name":"Пик","text":"Запас еды в жёлуде.","vocal":false},{"t":264.85,"dur":2.627,"who":"К105","name":"Филя","text":"А что нужно ростку, чтобы расти дальше?","vocal":false},{"t":270.778,"dur":1.881,"who":"К101","name":"Барсик","text":"Вода, свет и тёплая земля.","vocal":false},{"t":272.959,"dur":0.715,"who":"К103","name":"Рон","text":"И сторож!","vocal":false},{"t":273.974,"dur":0.81,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":274.905,"dur":1.967,"who":"К105","name":"Филя","text":"И сторож. Все ответили!","vocal":false},{"t":279.171,"dur":2.982,"who":"К103","name":"Рон","text":"Вот наш росток. Я буду сторожить его всю ночь.","vocal":false},{"t":282.453,"dur":1.876,"who":"К101","name":"Барсик","text":"Всю ночь? Ты же уснёшь.","vocal":false},{"t":284.629,"dur":2.845,"who":"К103","name":"Рон","text":"Я? Никогда. Я самый бодрый сторож.","vocal":false},{"t":288.524,"dur":1.574,"who":"К103","name":"Рон","text":"А-а-а-ах.","vocal":true},{"t":290.374,"dur":1.898,"who":"К103","name":"Рон","text":"Росток, а ты ночью растёшь?","vocal":false},{"t":292.572,"dur":2.368,"who":"К102","name":"Пик","text":"Растёт. Только медленно. Он тоже отдыхает.","vocal":false},{"t":295.24,"dur":2.918,"who":"К103","name":"Рон","text":"Тогда я тоже немножко отдохну. Одним глазом.","vocal":false},{"t":299.258,"dur":2.051,"who":"К105","name":"Филя","text":"Самый бодрый сторож уснул.","vocal":false},{"t":301.609,"dur":3.376,"who":"К104","name":"Топа","text":"Пусть спят оба. Утром посмотрим.","vocal":false},{"t":307.285,"dur":2.867,"who":"К103","name":"Рон","text":"Я не спал! Я сторожил с закрытыми глазами!","vocal":false},{"t":310.602,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":313.085,"dur":2.824,"who":"К104","name":"Топа","text":"Вот росток! На месте! Целый и невредимый!","vocal":false},{"t":319.209,"dur":2.644,"who":"К105","name":"Филя","text":"Ночью росток спал. И Рон тоже","vocal":false},{"t":322.753,"dur":1.519,"who":"К104","name":"Топа","text":"Ой! Шишка закрылась!","vocal":false},{"t":324.572,"dur":3.391,"who":"К102","name":"Пик","text":"Значит, воздух сырой. Стало холодно. Может пойти снег.","vocal":false},{"t":328.263,"dur":3.128,"who":"К103","name":"Рон","text":"Снег? А как же наш росток? Он же замёрзнет!","vocal":false},{"t":331.691,"dur":2.642,"who":"К101","name":"Барсик","text":"Не знаю, Рон. Это новая загадка.","vocal":false},{"t":334.633,"dur":1.932,"who":"К103","name":"Рон","text":"Надо срочно связать ему шарф!","vocal":false},{"t":336.865,"dur":0.622,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":337.607,"dur":2.203,"who":"К102","name":"Пик","text":"Завтра узнаем, как дубы прячутся от зимы.","vocal":false},{"t":341.71,"dur":4.876,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"луг, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"meadow\",\"weather\":\"none\"}"},{"t0":67.446,"kind":"title","loc":""},{"t0":70.446,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"кухня, день\",\"seed\":102,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":109.519,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"луг, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"meadow\",\"weather\":\"none\"}"},{"t0":142.869,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"комната, день\",\"seed\":103,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":184.192,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"луг, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"meadow\",\"weather\":\"none\"}"},{"t0":211.703,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"лес, день\",\"seed\":104,\"time\":\"day\",\"type\":\"forest\",\"weather\":\"none\"}"},{"t0":245.701,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"комната, вечер\",\"seed\":105,\"time\":\"evening\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":277.971,"kind":"scene","loc":"{\"id\":\"Л106\",\"name\":\"луг, вечер\",\"seed\":106,\"time\":\"evening\",\"type\":\"meadow\",\"weather\":\"none\"}"},{"t0":306.085,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"луг, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"meadow\",\"weather\":\"none\"}"},{"t0":340.91,"kind":"end","loc":""}]}