{"dur":191.00417417800452,"names":{"К103":"Рон","К106":"Ронни","К107":"Рончик","К101":"Барсик","К105":"Филя","К102":"Пик","К104":"Топа","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":4.328,"who":"Р","name":"Рассказчик","text":"Новый голос Рона. Реплики тридцать восьмой серии.","vocal":false},{"t":4.878,"dur":1.702,"who":"К103","name":"Рон","text":"Ого! Какие красивые!","vocal":false},{"t":6.88,"dur":2.159,"who":"К103","name":"Рон","text":"Ночью кто-то приходил! Художник!","vocal":false},{"t":9.339,"dur":5.579,"who":"К103","name":"Рон","text":"Вижу… завитушку. И ещё одну. Художник очень старался.","vocal":false},{"t":15.217,"dur":2.586,"who":"К103","name":"Рон","text":"Я поймаю художника! Я буду в засаде.","vocal":false},{"t":18.104,"dur":2.343,"who":"К103","name":"Рон","text":"Я в засаде. Тихо!","vocal":false},{"t":20.747,"dur":1.689,"who":"К103","name":"Рон","text":"Мороз! Это он художник!","vocal":false},{"t":22.736,"dur":1.636,"who":"К103","name":"Рон","text":"Зато у него есть холод.","vocal":false},{"t":24.671,"dur":3.11,"who":"К103","name":"Рон","text":"Сахаром не пахнет. Жаль.","vocal":false},{"t":28.081,"dur":2.68,"who":"К103","name":"Рон","text":"А иней вкусный? Я попробую!","vocal":false},{"t":31.062,"dur":3.004,"who":"К103","name":"Рон","text":"Ой. Тогда я только понюхаю.","vocal":false},{"t":34.366,"dur":3.025,"who":"К103","name":"Рон","text":"Тсс! Я ищу следы художника.","vocal":false},{"t":37.691,"dur":0.86,"who":"К103","name":"Рон","text":"Хитрый.","vocal":false},{"t":38.851,"dur":2.298,"who":"К103","name":"Рон","text":"Смотрите, вот санки! Кто кататься?","vocal":false},{"t":41.448,"dur":3.322,"who":"К103","name":"Рон","text":"Ой. Не едут. Санки прилипли!","vocal":false},{"t":45.07,"dur":2.8,"who":"К103","name":"Рон","text":"Санки поехали. А я — нет.","vocal":false},{"t":48.17,"dur":2.208,"who":"К103","name":"Рон","text":"А мне он шепчет, чтобы я не падал.","vocal":false},{"t":50.678,"dur":2.463,"who":"К103","name":"Рон","text":"А я тоже могу сделать пар! Ха-а-а!","vocal":false},{"t":53.441,"dur":1.307,"who":"К103","name":"Рон","text":"Во мне есть вода?","vocal":false},{"t":55.048,"dur":2.708,"who":"К103","name":"Рон","text":"Тогда я тоже умею рисовать, как мороз!","vocal":false},{"t":58.056,"dur":1.246,"who":"К103","name":"Рон","text":"Сейчас проверим!","vocal":false},{"t":59.602,"dur":1.365,"who":"К103","name":"Рон","text":"Ха-а-а! Ха-а-а!","vocal":false},{"t":61.267,"dur":2.558,"who":"К103","name":"Рон","text":"Теперь я вижу двор. Там зима.","vocal":false},{"t":64.124,"dur":5.229,"who":"К103","name":"Рон","text":"А я нарисую художника. Вот. Это Мороз. Он сердитый.","vocal":false},{"t":69.653,"dur":2.086,"who":"К103","name":"Рон","text":"Очень холодно! Я долго сидел.","vocal":false},{"t":72.039,"dur":3.612,"who":"К103","name":"Рон","text":"Я посмотрю, как мороз рисует. Хоть немножко.","vocal":false},{"t":77.351,"dur":2.399,"who":"Р","name":"Рассказчик","text":"Реплики тридцать девятой серии.","vocal":false},{"t":80.05,"dur":2.767,"who":"К103","name":"Рон","text":"Она как звёздочка! Белая звёздочка!","vocal":false},{"t":83.117,"dur":3.007,"who":"К103","name":"Рон","text":"А мне снежинка села на нос! Сколько там лучиков?","vocal":false},{"t":86.424,"dur":2.528,"who":"К103","name":"Рон","text":"Я найду самую большую снежинку!","vocal":false},{"t":89.252,"dur":3.738,"who":"К103","name":"Рон","text":"Большая улетела. А я приземлился.","vocal":false},{"t":93.29,"dur":3.732,"who":"К103","name":"Рон","text":"Там, наверное, кто-то их вырезает. Ножницами.","vocal":false},{"t":97.322,"dur":3.376,"who":"К103","name":"Рон","text":"Вода знает цифру шесть? Вот умница!","vocal":false},{"t":100.998,"dur":3.528,"who":"К103","name":"Рон","text":"Тогда я тоже стану холодным. Как тарелка!","vocal":false},{"t":104.826,"dur":2.452,"who":"К103","name":"Рон","text":"Правда? Тогда лужу не надо!","vocal":false},{"t":107.578,"dur":1.589,"who":"К103","name":"Рон","text":"Пока похоже на линию.","vocal":false},{"t":109.467,"dur":3.459,"who":"К103","name":"Рон","text":"А я нарисую снежинку с ушами. Как у меня.","vocal":false},{"t":113.226,"dur":2.848,"who":"К103","name":"Рон","text":"Она особенная. Она слушает зиму.","vocal":false},{"t":116.373,"dur":0.947,"who":"К103","name":"Рон","text":"Прямо как мы!","vocal":false},{"t":117.62,"dur":4.191,"who":"К103","name":"Рон","text":"Вот моя снежинка. Пусть будет у меня. На память.","vocal":false},{"t":122.112,"dur":1.246,"who":"К103","name":"Рон","text":"Тихо! Это тайна.","vocal":false},{"t":123.658,"dur":2.05,"who":"К103","name":"Рон","text":"Смотрите, что у меня в кармане!","vocal":false},{"t":126.008,"dur":2.148,"who":"К103","name":"Рон","text":"Ой! Пропала! Тут только мокро!","vocal":false},{"t":128.456,"dur":2.663,"who":"К103","name":"Рон","text":"Растаяла. Жалко.","vocal":false},{"t":131.419,"dur":3.246,"who":"К103","name":"Рон","text":"Тогда пусть живут на улице. Там им холодно.","vocal":false},{"t":134.964,"dur":0.756,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":135.841,"dur":2.375,"who":"К103","name":"Рон","text":"Я снежинка, которая упала первой.","vocal":false},{"t":138.515,"dur":0.958,"who":"К103","name":"Рон","text":"Горка! Ура!","vocal":false},{"t":141.173,"dur":1.666,"who":"Р","name":"Рассказчик","text":"Смех Рона, первый.","vocal":false},{"t":143.539,"dur":0.756,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":144.416,"dur":0.822,"who":"К103","name":"Рон","text":"Вот это да!","vocal":false},{"t":145.538,"dur":1.843,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":147.501,"dur":1.291,"who":"Р","name":"Рассказчик","text":"Смех второй.","vocal":false},{"t":149.092,"dur":0.756,"who":"К106","name":"Ронни","text":"Ха-ха-ха!","vocal":true},{"t":149.969,"dur":0.822,"who":"К106","name":"Ронни","text":"Вот это да!","vocal":false},{"t":151.091,"dur":1.865,"who":"К106","name":"Ронни","text":"Ха-ха-ха!","vocal":true},{"t":153.076,"dur":1.236,"who":"Р","name":"Рассказчик","text":"Смех третий.","vocal":false},{"t"