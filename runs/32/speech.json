{"dur":331.69805739795913,"names":{"К103":"Рон","К105":"Филя","К104":"Топа","К101":"Барсик","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.85,"dur":2.662,"who":"К103","name":"Рон","text":"Смотрите! Стрелка опять смотрит туда!","vocal":false},{"t":4.062,"dur":2.522,"who":"К103","name":"Рон","text":"А я повернулся. А она всё равно туда!","vocal":false},{"t":7.034,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":9.017,"dur":1.684,"who":"К103","name":"Рон","text":"Сейчас я её запутаю.","vocal":false},{"t":11.801,"dur":3.079,"who":"К103","name":"Рон","text":"Ой! Голова кружится. А стрелке хоть бы что!","vocal":false},{"t":15.18,"dur":2.263,"who":"К104","name":"Топа","text":"Она будто знает, куда смотреть.","vocal":false},{"t":17.743,"dur":3.504,"who":"К101","name":"Барсик","text":"Знает. Красный кончик стрелки всегда показывает на север.","vocal":false},{"t":21.547,"dur":3.286,"who":"К103","name":"Рон","text":"А что там, на севере? Наверное, печенье?","vocal":false},{"t":25.133,"dur":0.622,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":25.875,"dur":2.168,"who":"К102","name":"Пик","text":"Там холодные края. Снег и белые медведи.","vocal":false},{"t":28.343,"dur":2.816,"who":"К103","name":"Рон","text":"Медведи? Топа, это твои родственники!","vocal":false},{"t":31.459,"dur":1.103,"who":"К104","name":"Топа","text":"Очень дальние.","vocal":false},{"t":32.862,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":32.862,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":32.862,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":32.862,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":32.862,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":39.765,"dur":1.439,"who":"К103","name":"Рон","text":"Проверим одну догадку.","vocal":false},{"t":42.104,"dur":2.7,"who":"К103","name":"Рон","text":"Стрелка показывает на печенье. Видите?","vocal":false},{"t":45.104,"dur":1.664,"who":"К105","name":"Филя","text":"А если печенье унести?","vocal":false},{"t":50.044,"dur":1.534,"who":"К105","name":"Филя","text":"Стрелка не сдвинулась!","vocal":false},{"t":51.878,"dur":3.488,"who":"К103","name":"Рон","text":"Значит, она не любит печенье. Странная стрелка.","vocal":false},{"t":55.666,"dur":1.664,"who":"Р","name":"Рассказчик","text":"Рон съел печенье.","vocal":false},{"t":57.866,"dur":1.046,"who":"К103","name":"Рон","text":"Зато я люблю.","vocal":false},{"t":59.362,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха-ха!","vocal":true},{"t":61.012,"dur":3.023,"who":"К102","name":"Пик","text":"Стрелку тянет не печенье. Её поворачивает сама Земля.","vocal":false},{"t":64.335,"dur":0.651,"who":"К105","name":"Филя","text":"Земля?","vocal":false},{"t":65.285,"dur":2.683,"who":"К101","name":"Барсик","text":"Пойдёмте в комнату. В книге есть объяснение.","vocal":false},{"t":72.669,"dur":2.543,"who":"К105","name":"Филя","text":"Стрелка компаса — маленький магнит","vocal":false},{"t":75.512,"dur":1.304,"who":"К104","name":"Топа","text":"А что такое магнит?","vocal":false},{"t":77.116,"dur":3.448,"who":"К102","name":"Пик","text":"Магнит притягивает железные вещи. Гвоздик, скрепку, ключик.","vocal":false},{"t":83.263,"dur":2.283,"who":"К105","name":"Филя","text":"Наша Земля — сама как магнит","vocal":false},{"t":85.846,"dur":3.115,"who":"К103","name":"Рон","text":"Вся Земля? Тогда почему ложки к ней не прилипают?","vocal":false},{"t":89.261,"dur":2.502,"who":"К102","name":"Пик","text":"Земной магнит очень слабый. Ложку он не удержит.","vocal":false},{"t":92.063,"dur":3.859,"who":"К101","name":"Барсик","text":"Но лёгкую стрелку он поворачивает. Всегда в одну сторону — на север.","vocal":false},{"t":96.223,"dur":2.017,"who":"К104","name":"Топа","text":"Поэтому стрелку не запутать!","vocal":false},{"t":98.54,"dur":1.826,"who":"К103","name":"Рон","text":"Даже если очень постараться?","vocal":false},{"t":100.666,"dur":0.74,"who":"К101","name":"Барсик","text":"Ха-ха!","vocal":true},{"t":101.526,"dur":1.877,"who":"К101","name":"Барсик","text":"Даже если кружиться до вечера.","vocal":false},{"t":105.603,"dur":2.359,"who":"К102","name":"Пик","text":"Но стрелку можно обмануть. Если рядом железо.","vocal":false},{"t":108.862,"dur":1.325,"who":"К104","name":"Топа","text":"Вот железный ключ.","vocal":false},{"t":111.387,"dur":2.109,"who":"К103","name":"Рон","text":"Ой! Стрелка дёрнулась к ключу!","vocal":false},{"t":115.196,"dur":1.627,"who":"К103","name":"Рон","text":"А теперь вернулась на север!","vocal":false},{"t":117.123,"dur":2.33,"who":"К102","name":"Пик","text":"Поэтому компас держат подальше от железных вещей.","vocal":false},{"t":119.753,"dur":2.611,"who":"К105","name":"Филя","text":"Иначе он покажет неправильную дорогу.","vocal":false},{"t":122.664,"dur":3.623,"who":"К103","name":"Рон","text":"Понял. В походе ключи в карман, а компас — в лапу!","vocal":false},{"t":128.487,"dur":3.789,"who":"К103","name":"Рон","text":"Давайте сыграем в поиски по компасу! Я спрячу печенье.","vocal":false},{"t":132.576,"dur":1.163,"who":"К101","name":"Барсик","text":"А я запишу дорогу.","vocal":false},{"t":134.039,"dur":3.999,"who":"Р","name":"Рассказчик","text":"Рон спрятал печенье, а Барсик записал, куда идти.","vocal":false},{"t":141.838,"dur":2.838,"who":"К101","name":"Барсик","text":"Пять шагов на север. Потом три шага к забору","vocal":false},{"t":145.576,"dur":1.133,"who":"К104","name":"Топа","text":"Север — туда!","vocal":false},{"t":147.009,"dur":2.537,"who":"К105","name":"Филя","text":"Раз, два, три, четыре, пять!","vocal":false},{"t":149.845,"dur":3.13,"who":"К104","name":"Топа","text":"Теперь к забору. Раз, два, три!","vocal":false},{"t":153.276,"dur":0.657,"who":"К105","name":"Филя","text":"Нашли!","vocal":false},{"t":154.832,"dur":3.911,"who":"К103","name":"Рон","text":"Тут только половинка. Печенье вас долго ждало. А я — нет.","vocal":false},{"t":159.0