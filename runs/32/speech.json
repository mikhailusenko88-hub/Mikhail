нь\",\"seed\":104,\"time\":\"day\",\"type\":\"forest\",\"weather\":\"none\"}"},{"t0":203.264,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"луг, день\",\"seed\":105,\"time\":\"day\",\"type\":\"meadow\",\"weather\":\"none\"}"},{"t0":244.104,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"луг, день\",\"seed\":105,\"time\":\"day\",\"type\":\"meadow\",\"weather\":\"none\"}"},{"t0":289.844,"kind":"scene","loc":"{\"id\":\"Л106\",\"name\":\"лес, вечер\",\"seed\":106,\"time\":\"evening\",\"type\":\"forest\",\"weather\":\"none\"}"},{"t0":324.422,"kind":"end","loc":""}]}