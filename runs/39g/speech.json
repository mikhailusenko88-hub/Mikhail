{"dur":313.74533333333324,"names":{"К105":"Филя","К102":"Пик","К103":"Рон","К101":"Барсик","К104":"Топа","Р":"Рассказчик"},"speech":[{"t":0.85,"dur":2.696,"who":"К105","name":"Филя","text":"Смотрите! Вот снежинка! У меня в лапке!","vocal":false},{"t":6.646,"dur":3.239,"who":"К102","name":"Пик","text":"Ого! Лучики! Раз, два, три, четыре, пять, шесть!","vocal":false},{"t":10.185,"dur":4.089,"who":"К103","name":"Рон","text":"Она как звёздочка! Белая звёздочка!","vocal":false},{"t":14.574,"dur":3.048,"who":"К101","name":"Барсик","text":"Давайте посмотрим ещё одну. Вон их сколько летит!","vocal":false},{"t":18.522,"dur":2.152,"who":"К104","name":"Топа","text":"Поймал! И у этой шесть лучиков.","vocal":false},{"t":20.974,"dur":4.473,"who":"К103","name":"Рон","text":"А мне снежинка села на нос! Сколько там лучиков?","vocal":false},{"t":25.746,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":26.709,"dur":3.655,"who":"К104","name":"Топа","text":"Рон, она уже растаяла. Нос у тебя тёплый!","vocal":false},{"t":30.664,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":30.664,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":30.664,"dur":1.834,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":30.664,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":30.664,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":32.677,"dur":3.631,"who":"К101","name":"Барсик","text":"Почему у всех снежинок шесть лучиков? Вот это загадка!","vocal":false},{"t":42.508,"dur":2.703,"who":"К103","name":"Рон","text":"Я найду самую большую снежинку!","vocal":false},{"t":47.261,"dur":0.414,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":48.211,"dur":1.834,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":50.165,"dur":3.958,"who":"К103","name":"Рон","text":"Большая улетела. А я приземлился.","vocal":false},{"t":54.423,"dur":2.7,"who":"К105","name":"Филя","text":"Они падают медленно. Как пушинки.","vocal":false},{"t":57.423,"dur":3.215,"who":"К102","name":"Пик","text":"Снежинка очень лёгкая, как пух. Её уносит ветер.","vocal":false},{"t":60.938,"dur":1.459,"who":"К104","name":"Топа","text":"А откуда они берутся?","vocal":false},{"t":62.697,"dur":2.401,"who":"К101","name":"Барсик","text":"Из облака. Высоко-высоко над нами.","vocal":false},{"t":65.398,"dur":4.643,"who":"К103","name":"Рон","text":"Там, наве́рное, кто-то их вырезает. Ножницами.","vocal":false},{"t":70.341,"dur":0.81,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":71.272,"dur":2.029,"who":"К105","name":"Филя","text":"Тогда ему работы на всю зиму!","vocal":false},{"t":73.601,"dur":1.823,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":73.601,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":73.601,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":73.601,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":73.601,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":75.604,"dur":3.479,"who":"К101","name":"Барсик","text":"Пойдёмте пить чай. Пик расскажет, как рождается снежинка.","vocal":false},{"t":82.783,"dur":3.056,"who":"К101","name":"Барсик","text":"Смотрите, над чашкой пар. Это вода в воздухе.","vocal":false},{"t":86.139,"dur":2.917,"who":"К102","name":"Пик","text":"В облаке тоже вода. Много-много маленьких капелек.","vocal":false},{"t":89.357,"dur":1.214,"who":"К104","name":"Топа","text":"А наверху холодно?","vocal":false},{"t":90.871,"dur":3.342,"who":"К102","name":"Пик","text":"Очень холодно. Там капелька замерзает. Получается льдинка.","vocal":false},{"t":94.513,"dur":2.265,"who":"К105","name":"Филя","text":"Такая маленькая, что её не видно?","vocal":false},{"t":97.078,"dur":3.911,"who":"К102","name":"Пик","text":"Да. А потом к льдинке прилипают новые. И она становится больше.","vocal":false},{"t":101.289,"dur":3.192,"who":"К101","name":"Барсик","text":"Растёт ровно в шесть сторон. Так получаются лучики!","vocal":false},{"t":104.781,"dur":4.134,"who":"К103","name":"Рон","text":"Вода знает цифру шесть? Вот умница!","vocal":false},{"t":109.215,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":109.215,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":109.215,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":109.215,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":109.215,"dur":1.823,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":111.229,"dur":2.541,"who":"К102","name":"Пик","text":"Так устроен лёд. Шесть лучиков — всегда!","vocal":false},{"t":114.069,"dur":3.31,"who":"К104","name":"Топа","text":"А потом снежинка тяжелеет. И падает вниз.","vocal":false},{"t":120.179,"dur":4.034,"who":"К101","name":"Барсик","text":"Проверим, где снежинка живёт дольше. Тарелка холодная, с мороза.","vocal":false},{"t":124.514,"dur":2.528,"who":"К104","name":"Топа","text":"А моя лапа тёплая. Ловлю!","vocal":false},{"t":128.241,"dur":2.977,"who":"К104","name":"Топа","text":"Ой! Уже растаяла. Только капелька.","vocal":false},{"t":132.018,"dur":3.701,"who":"К105","name":"Филя","text":"Смотрите! На тарелку падают снежинки. И не тают!","vocal":false},{"t":136.019,"dur":3.215,"who":"К102","name":"Пик","text":"Тарелка холодная, как мороз. Снежинкам на ней не жарко.","vocal":false},{"t":139.534,"dur":4.248,"who":"К103","name":"Рон","text":"Тогда я тоже стану холодным. Как тарелка!","vocal":false},{"t":144.681,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":144.681,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":144.681,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":144.681,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":144.681,"dur":1.868,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":146.67,"dur":0.79,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":147.579,"dur":3.044,"who":"К105","name":"Филя","text":"Рон, ты тёплый. Под тобой снег растает!","vocal":false},{"t":150.924,"dur":3.327,"who":"К103","name":"Рон","text":"Правда? Тогда лужу не надо!","vocal":false},{"t":155.151,"dur":4.118,"who":"К101","name":"Барсик","text":"Значит, снежинки любят холод. А в тепле становятся водой.","vocal":false},{"t":163.969,"dur":3.11,"who":"К105","name":"Филя","text":"Я рисую снежинку. Сначала одна линия.","vocal":false},{"t":167.379,"dur":1.691,"who":"К103","name":"Рон","text":"Пока похоже на линию.","vocal":false},{"t":169.37,"dur":3.802,"who":"К105","name":"Филя","text":"Теперь ещё две, крест-накрест. Вот! Шесть лучиков!","vocal":false},{"t":173.471,"dur":3.274,"who":"К101","name":"Барсик","text":"Как просто! Три линии — и шесть лучиков.","vocal":false},{"t":177.046,"dur":3.047,"who":"К104","name":"Топа","text":"А на концах можно веточки. Как ёлочки.","vocal":false},{"t":180.393,"dur":4.236,"who":"К103","name":"Рон","text":"А я нарисую снежинку с ушами. Как у меня.","vocal":false},{"t":184.929,"dur":0.8,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":185.849,"dur":2.071,"who":"К105","name":"Филя","text":"Рон, у снежинок нет ушей!","vocal":false},{"t":188.22,"dur":3.722,"who":"К103","name":"Рон","text":"Она особенная. Она слушает зиму.","vocal":false},{"t":192.242,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":192.242,"dur":1.823,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":192.242,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":192.242,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":196.155,"dur":3.55,"who":"К101","name":"Барсик","text":"Давайте ловить снежинки на шарф. На тёмном их лучше видно.","vocal":false},{"t":200.006,"dur":2.606,"who":"К104","name":"То