{"dur":299.0101775793651,"names":{"К105":"Филя","К102":"Пик","К103":"Рон","К101":"Барсик","К104":"Топа","Р":"Рассказчик"},"speech":[{"t":0.85,"dur":2.696,"who":"К105","name":"Филя","text":"Смотрите! Вот снежинка! У меня в лапке!","vocal":false},{"t":6.646,"dur":3.724,"who":"К102","name":"Пик","text":"Ого! Лучики! Раз, два, три, четыре, пять, шесть!","vocal":false},{"t":10.67,"dur":3.575,"who":"К103","name":"Рон","text":"Она как звёздочка! Белая звёздочка!","vocal":false},{"t":14.545,"dur":3.048,"who":"К101","name":"Барсик","text":"Давайте посмотрим ещё одну. Вон их сколько летит!","vocal":false},{"t":18.493,"dur":2.152,"who":"К104","name":"Топа","text":"Поймал! И у этой шесть лучиков.","vocal":false},{"t":20.945,"dur":3.807,"who":"К103","name":"Рон","text":"А мне снежинка села на нос! Сколько там лучиков?","vocal":false},{"t":25.052,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":26.014,"dur":3.655,"who":"К104","name":"Топа","text":"Рон, она уже растаяла. Нос у тебя тёплый!","vocal":false},{"t":29.969,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":29.969,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":29.969,"dur":1.766,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":29.969,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":29.969,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":31.982,"dur":3.631,"who":"К101","name":"Барсик","text":"Почему у всех снежинок шесть лучиков? Вот это загадка!","vocal":false},{"t":41.813,"dur":2.595,"who":"К103","name":"Рон","text":"Я найду самую большую снежинку!","vocal":false},{"t":46.458,"dur":0.56,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":47.408,"dur":1.766,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":49.294,"dur":4.415,"who":"К103","name":"Рон","text":"Большая улетела. А я приземлился.","vocal":false},{"t":54.009,"dur":2.7,"who":"К105","name":"Филя","text":"Они падают медленно. Как пушинки.","vocal":false},{"t":57.009,"dur":2.917,"who":"К102","name":"Пик","text":"Снежинка очень лёгкая, как пух. Её уносит ветер.","vocal":false},{"t":60.226,"dur":1.459,"who":"К104","name":"Топа","text":"А откуда они берутся?","vocal":false},{"t":61.985,"dur":2.401,"who":"К101","name":"Барсик","text":"Из облака. Высоко-высоко над нами.","vocal":false},{"t":64.686,"dur":3.674,"who":"К103","name":"Рон","text":"Там, наве́рное, кто-то их вырезает. Ножницами.","vocal":false},{"t":68.661,"dur":0.81,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":69.591,"dur":2.029,"who":"К105","name":"Филя","text":"Тогда ему работы на всю зиму!","vocal":false},{"t":71.92,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":71.92,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":71.92,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":71.92,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":71.92,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":73.923,"dur":3.479,"who":"К101","name":"Барсик","text":"Пойдёмте пить чай. Пик расскажет, как рождается снежинка.","vocal":false},{"t":81.102,"dur":3.056,"who":"К101","name":"Барсик","text":"Смотрите, над чашкой пар. Это вода в воздухе.","vocal":false},{"t":84.459,"dur":2.477,"who":"К102","name":"Пик","text":"В облаке тоже вода. Много-много маленьких капелек.","vocal":false},{"t":87.236,"dur":1.214,"who":"К104","name":"Топа","text":"А наверху холодно?","vocal":false},{"t":88.75,"dur":3.185,"who":"К102","name":"Пик","text":"Очень холодно. Там капелька замерзает. Получается льдинка.","vocal":false},{"t":92.234,"dur":2.265,"who":"К105","name":"Филя","text":"Такая маленькая, что её не видно?","vocal":false},{"t":94.8,"dur":3.316,"who":"К102","name":"Пик","text":"Да. А потом к льдинке прилипают новые. И она становится больше.","vocal":false},{"t":98.416,"dur":3.192,"who":"К101","name":"Барсик","text":"Растёт ровно в шесть сторон. Так получаются лучики!","vocal":false},{"t":101.908,"dur":3.723,"who":"К103","name":"Рон","text":"Вода знает цифру шесть? Вот умница!","vocal":false},{"t":105.931,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":105.931,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":105.931,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":105.931,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":105.931,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":107.945,"dur":2.356,"who":"К102","name":"Пик","text":"Так устроен лёд. Шесть лучиков — всегда!","vocal":false},{"t":110.601,"dur":3.31,"who":"К104","name":"Топа","text":"А потом снежинка тяжелеет. И падает вниз.","vocal":false},{"t":116.711,"dur":4.034,"who":"К101","name":"Барсик","text":"Проверим, где снежинка живёт дольше. Тарелка холодная, с мороза.","vocal":false},{"t":121.045,"dur":2.528,"who":"К104","name":"Топа","text":"А моя лапа тёплая. Ловлю!","vocal":false},{"t":124.773,"dur":2.977,"who":"К104","name":"Топа","text":"Ой! Уже растаяла. Только капелька.","vocal":false},{"t":128.549,"dur":3.701,"who":"К105","name":"Филя","text":"Смотрите! На тарелку падают снежинки. И не тают!","vocal":false},{"t":132.55,"dur":3.13,"who":"К102","name":"Пик","text":"Тарелка холодная, как мороз. Снежинкам на ней не жарко.","vocal":false},{"t":135.98,"dur":3.344,"who":"К103","name":"Рон","text":"Тогда я тоже стану холодным. Как тарелка!","vocal":false},{"t":140.224,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":140.224,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":140.224,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":140.224,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":140.224,"dur":1.783,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":142.206,"dur":0.79,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":143.116,"dur":3.044,"who":"К105","name":"Филя","text":"Рон, ты тёплый. Под тобой снег растает!","vocal":false},{"t":146.46,"dur":2.597,"who":"К103","name":"Рон","text":"Правда? Тогда лужу не надо!","vocal":false},{"t":149.957,"dur":4.118,"who":"К101","name":"Барсик","text":"Значит, снежинки любят холод. А в тепле становятся водой.","vocal":false},{"t":158.776,"dur":3.11,"who":"К105","name":"Филя","text":"Я рисую снежинку. Сначала одна линия.","vocal":false},{"t":162.186,"dur":1.542,"who":"К103","name":"Рон","text":"Пока похоже на линию.","vocal":false},{"t":164.028,"dur":3.802,"who":"К105","name":"Филя","text":"Теперь ещё две, крест-накрест. Вот! Шесть лучиков!","vocal":false},{"t":168.129,"dur":3.274,"who":"К101","name":"Барсик","text":"Как просто! Три линии — и шесть лучиков.","vocal":false},{"t":171.704,"dur":3.047,"who":"К104","name":"Топа","text":"А на концах можно веточки. Как ёлочки.","vocal":false},{"t":175.051,"dur":3.434,"who":"К103","name":"Рон","text":"А я нарисую снежинку с ушами. Как у меня.","vocal":false},{"t":178.784,"dur":0.8,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":179.704,"dur":2.071,"who":"К105","name":"Филя","text":"Рон, у снежинок нет ушей!","vocal":false},{"t":182.075,"dur":3.157,"who":"К103","name":"Рон","text":"Она особенная. Она слушает зиму.","vocal":false},{"t":185.532,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":185.532,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":185.532,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":185.532,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":189.446,"dur":3.55,"who":"К101","name":"Барсик","text":"Давайте ловить снежинки на шарф. На тёмном их лучше видно.","vocal":false},{"t":193.296,"dur":2.606,"who":"К104","name":"Топа","text":"У меня шарф зелёный. Ловите!","vocal":false},{"t":199.002,"dur":2.064,"who":"К102","name":"Пик","text":"Эта с веточками. А эта как цветочек.","vocal":false},{"t":201.367,"dur":1.904,"who":"К105","name":"Филя","text":"А эта похожа на звёздочку.","vocal":false},{"t":203.571,"dur":3.071,"who":"К101","name":"Барсик","text":"Двух одинаковых снежинок не бывает. Все разные.","vocal":false},{"t":206.942,"dur":0.988,"who":"К103","name":"Рон","text":"Прямо как мы!","vocal":false},{"t":208.23,"dur":0.79,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":209.14,"dur":2.019,"who":"К105","name":"Филя","text":"Рон, ты точно один такой!","vocal":false},{"t":211.459,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":211.459,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":211.459,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":211.459,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":211.459,"dur":1.783,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":214.062,"dur":4.375,"who":"К103","name":"Рон","text":"Вот моя снежинка. Пусть будет у меня. На память.","vocal":false},{"t":219.237,"dur":1.313,"who":"К102","name":"Пик","text":"Рон, она же растает…","vocal":false},{"t":220.85,"dur":1.782,"who":"К103","name":"Рон","text":"Тихо! Это тайна.","vocal":false},{"t":224.833,"dur":1.97,"who":"К103","name":"Рон","text":"Смотрите, что у меня в кармане!","vocal":false},{"t":229.503,"dur":3.279,"who":"К103","name":"Рон","text":"Ой! Пропала! Тут только мокро!","vocal":false},{"t":233.082,"dur":3.754,"who":"К101","name":"Барсик","text":"В тепле снежинка тает. И становится капелькой воды.","vocal":false},{"t":237.136,"dur":2.954,"who":"К102","name":"Пик","text":"Снежинка — это лёд. Красивый, но очень маленький.","vocal":false},{"t":240.39,"dur":2.907,"who":"К103","name":"Рон","text":"Растаяла. Жалко.","vocal":false},{"t":243.598,"dur":4.235,"who":"К104","name":