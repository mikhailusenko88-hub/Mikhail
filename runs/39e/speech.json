{"dur":297.26276091269835,"names":{"К105":"Филя","К102":"Пик","К103":"Рон","К101":"Барсик","К104":"Топа","Р":"Рассказчик"},"speech":[{"t":0.85,"dur":2.696,"who":"К105","name":"Филя","text":"Смотрите! Вот снежинка! У меня в лапке!","vocal":false},{"t":6.646,"dur":3.724,"who":"К102","name":"Пик","text":"Ого! Лучики! Раз, два, три, четыре, пять, шесть!","vocal":false},{"t":10.67,"dur":3.383,"who":"К103","name":"Рон","text":"Она как звёздочка! Белая звёздочка!","vocal":false},{"t":14.352,"dur":3.048,"who":"К101","name":"Барсик","text":"Давайте посмотрим ещё одну. Вон их сколько летит!","vocal":false},{"t":18.301,"dur":2.152,"who":"К104","name":"Топа","text":"Поймал! И у этой шесть лучиков.","vocal":false},{"t":20.752,"dur":3.608,"who":"К103","name":"Рон","text":"А мне снежинка села на нос! Сколько там лучиков?","vocal":false},{"t":24.66,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":25.623,"dur":3.655,"who":"К104","name":"Топа","text":"Рон, она уже растаяла. Нос у тебя тёплый!","vocal":false},{"t":29.577,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":29.577,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":29.577,"dur":1.854,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":29.577,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":29.577,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":31.591,"dur":3.631,"who":"К101","name":"Барсик","text":"Почему у всех снежинок шесть лучиков? Вот это загадка!","vocal":false},{"t":41.422,"dur":2.528,"who":"К103","name":"Рон","text":"Я найду самую большую снежинку!","vocal":false},{"t":46,"dur":0.398,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":46.95,"dur":1.854,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":48.924,"dur":3.418,"who":"К103","name":"Рон","text":"Большая улетела. А я приземлился.","vocal":false},{"t":52.643,"dur":2.7,"who":"К105","name":"Филя","text":"Они падают медленно. Как пушинки.","vocal":false},{"t":55.643,"dur":2.917,"who":"К102","name":"Пик","text":"Снежинка очень лёгкая, как пух. Её уносит ветер.","vocal":false},{"t":58.86,"dur":1.459,"who":"К104","name":"Топа","text":"А откуда они берутся?","vocal":false},{"t":60.619,"dur":2.401,"who":"К101","name":"Барсик","text":"Из облака. Высоко-высоко над нами.","vocal":false},{"t":63.32,"dur":3.829,"who":"К103","name":"Рон","text":"Там, наверное, кто-то их вырезает. Ножницами.","vocal":false},{"t":67.448,"dur":0.81,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":68.379,"dur":2.029,"who":"К105","name":"Филя","text":"Тогда ему работы на всю зиму!","vocal":false},{"t":70.708,"dur":1.843,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":70.708,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":70.708,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":70.708,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":70.708,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":72.711,"dur":3.479,"who":"К101","name":"Барсик","text":"Пойдёмте пить чай. Пик расскажет, как рождается снежинка.","vocal":false},{"t":79.89,"dur":3.056,"who":"К101","name":"Барсик","text":"Смотрите, над чашкой пар. Это вода в воздухе.","vocal":false},{"t":83.246,"dur":2.477,"who":"К102","name":"Пик","text":"В облаке тоже вода. Много-много маленьких капелек.","vocal":false},{"t":86.024,"dur":1.214,"who":"К104","name":"Топа","text":"А наверху холодно?","vocal":false},{"t":87.537,"dur":3.185,"who":"К102","name":"Пик","text":"Очень холодно. Там капелька замерзает. Получается льдинка.","vocal":false},{"t":91.022,"dur":2.265,"who":"К105","name":"Филя","text":"Такая маленькая, что её не видно?","vocal":false},{"t":93.587,"dur":3.316,"who":"К102","name":"Пик","text":"Да. А потом к льдинке прилипают новые. И она становится больше.","vocal":false},{"t":97.204,"dur":3.192,"who":"К101","name":"Барсик","text":"Растёт ровно в шесть сторон. Так получаются лучики!","vocal":false},{"t":100.696,"dur":3.448,"who":"К103","name":"Рон","text":"Вода знает цифру шесть? Вот умница!","vocal":false},{"t":104.444,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":104.444,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":104.444,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":104.444,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":104.444,"dur":1.843,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":106.457,"dur":2.356,"who":"К102","name":"Пик","text":"Так устроен лёд. Шесть лучиков — всегда!","vocal":false},{"t":109.113,"dur":3.31,"who":"К104","name":"Топа","text":"А потом снежинка тяжелеет. И падает вниз.","vocal":false},{"t":115.223,"dur":4.034,"who":"К101","name":"Барсик","text":"Проверим, где снежинка живёт дольше. Тарелка холодная, с мороза.","vocal":false},{"t":119.558,"dur":2.528,"who":"К104","name":"Топа","text":"А моя лапа тёплая. Ловлю!","vocal":false},{"t":123.285,"dur":2.977,"who":"К104","name":"Топа","text":"Ой! Уже растаяла. Только капелька.","vocal":false},{"t":127.062,"dur":3.701,"who":"К105","name":"Филя","text":"Смотрите! На тарелку падают снежинки. И не тают!","vocal":false},{"t":131.063,"dur":3.13,"who":"К102","name":"Пик","text":"Тарелка холодная, как мороз. Снежинкам на ней не жарко.","vocal":false},{"t":134.492,"dur":3.546,"who":"К103","name":"Рон","text":"Тогда я тоже стану холодным. Как тарелка!","vocal":false},{"t":138.938,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":138.938,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":138.938,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":138.938,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":138.938,"dur":1.833,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":140.92,"dur":0.79,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":141.83,"dur":3.044,"who":"К105","name":"Филя","text":"Рон, ты тёплый. Под тобой снег растает!","vocal":false},{"t":145.174,"dur":2.709,"who":"К103","name":"Рон","text":"Правда? Тогда лужу не надо!","vocal":false},{"t":148.783,"dur":4.118,"who":"К101","name":"Барсик","text":"Значит, снежинки любят холод. А в тепле становятся водой.","vocal":false},{"t":157.601,"dur":3.11,"who":"К105","name":"Филя","text":"Я рисую снежинку. Сначала одна линия.","vocal":false},{"t":161.011,"dur":1.589,"who":"К103","name":"Рон","text":"Пока похоже на линию.","vocal":false},{"t":162.9,"dur":3.802,"who":"К105","name":"Филя","text":"Теперь ещё две, крест-накрест. Вот! Шесть лучиков!","vocal":false},{"t":167.002,"dur":3.274,"who":"К101","name":"Барсик","text":"Как просто! Три линии — и шесть лучиков.","vocal":false},{"t":170.576,"dur":3.047,"who":"К104","name":"Топа","text":"А на концах можно веточки. Как ёлочки.","vocal":false},{"t":173.924,"dur":3.521,"who":"К103","name":"Рон","text":"А я нарисую снежинку с ушами. Как у меня.","vocal":false},{"t":177.745,"dur":0.8,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":178.664,"dur":2.071,"who":"К105","name":"Филя","text":"Рон, у снежинок нет ушей!","vocal":false},{"t":181.035,"dur":3.017,"who":"К103","name":"Рон","text":"Она особенная. Она слушает зиму.","vocal":false},{"t":184.352,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":184.352,"dur":1.843,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":184.352,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":184.352,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":188.266,"dur":3.55,"who":"К101","name":"Барсик","text":"Давайте ловить снежинки на шарф. На тёмном их лучше видно.","vocal":false},{"t":192.116,"dur":2.606,"who":"К104","name":"Топа","text":"У 