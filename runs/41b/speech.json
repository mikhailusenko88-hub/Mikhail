{"t":463.978,"dur":2.202,"who":"К104","name":"Топа","text":"А-а-а-ах.","vocal":true},{"t":466.281,"dur":3.758,"who":"К104","name":"Топа","text":"Уже́ ночь. А мы только поужинали.","vocal":false},{"t":470.339,"dur":4.365,"who":"К105","name":"Филя","text":"Зимой так рано темнеет! Ещё вечер, а уже́ темно. Почему?","vocal":false},{"t":475.004,"dur":2.37,"who":"К101","name":"Барсик","text":"Вот это загадка! Завтра узнаем!","vocal":false},{"t":478.473,"dur":1.956,"who":"К102","name":"Пик","text":"Ти́ше. Топа уже́ спит.","vocal":false},{"t":482.33,"dur":8.449,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу поставить лайк и подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, ночь\",\"seed\":101,\"time\":\"night\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":14.977,"kind":"title","loc":""},{"t0":17.977,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"зима, утро\",\"seed\":102,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":58.657,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"зимняя горка, день\",\"seed\":103,\"time\":\"day\",\"type\":\"winter\",\"variant\":\"hill\",\"weather\":\"none\"}"},{"t0":139.4,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"кухня, день\",\"seed\":104,\"snowOut\":true,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":191.415,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"зима, утро\",\"seed\":102,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":230.272,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"комната, день\",\"seed\":105,\"snowOut\":true,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":304.696,"kind":"scene","loc":"{\"id\":\"Л106\",\"name\":\"зимняя горка, вечер\",\"seed\":106,\"time\":\"evening\",\"type\":\"winter\",\"variant\":\"hill\",\"weather\":\"none\"}"},{"t0":345.622,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, ночь\",\"seed\":10