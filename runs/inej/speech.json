{"dur":38.595575680272106,"names":{"К101":"Барсик","К103":"Рон","К104":"Филя","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":2.197,"who":"К101","name":"Барсик","text":"Смотрите! Вот узоры на окне!","vocal":false},{"t":2.747,"dur":1.711,"who":"К103","name":"Рон","text":"Ого! Какие красивые!","vocal":false},{"t":4.759,"dur":3.19,"who":"К104","name":"Филя","text":"Вчера окно было чистое. Кто это нарисовал?","vocal":false},{"t":9.649,"dur":2.308,"who":"К101","name":"Барсик","text":"Смотрите! Деревья все белые!","vocal":false},{"t":12.256,"dur":2.89,"who":"К102","name":"Пик","text":"Он называется иней. Бывает, когда ночью сильный мороз.","vocal":false},{"t":19.996,"dur":0.395,"who":"К103","name":"Рон","text":"Хм-м…","vocal":true},{"t":21.446,"dur":1.51,"who":"К103","name":"Рон","text":"Ха-а-а! Ха-а-а!","vocal":false},{"t":23.257,"dur":2.446,"who":"К104","name":"Филя","text":"Смотрите! Узор тает! Там дырочка!","vocal":false},{"t":26.002,"dur":3.5,"who":"К101","name":"Барсик","text":"Дыхание тёплое. А тепло растапливает лёд.","vocal":false},{"t":31.402,"dur":5.593,"who":"К101","name":"Барсик","text":"Понравился мультик? Попроси маму или папу поставить лайк и подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"комната, утро\",\"seed\":101,\"snowOut\":true,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":9.049,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"зима, утро\",\"seed\":102,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":16.246,"kind":"title","loc":""},{"t0":19.246,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"комната, утро\",\"seed\":101,\"snowOut\":true,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":30.602,"kind":"end","loc":""}]}