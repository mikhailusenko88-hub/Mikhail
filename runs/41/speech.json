":true},{"t":339.877,"dur":2.075,"who":"К105","name":"Филя","text":"Рон, а ты опять будешь считать?","vocal":false},{"t":342.252,"dur":2.993,"who":"К103","name":"Рон","text":"Обязательно! В этот раз до тысячи!","vocal":false},{"t":348.945,"dur":2.289,"who":"К103","name":"Рон","text":"Теперь фонарик яркий-яркий!","vocal":false},{"t":351.534,"dur":2.644,"who":"К105","name":"Филя","text":"Это тот же фонарик! А ночью он ярче!","vocal":false},{"t":354.478,"dur":2.308,"who":"К102","name":"Пик","text":"Он светит так же. Просто вокруг темно.","vocal":false},{"t":357.086,"dur":2.302,"who":"К101","name":"Барсик","text":"И звёзды на месте! Никуда не делись!","vocal":false},{"t":362.488,"dur":4.413,"who":"К103","name":"Рон","text":"Раз, два, три… Ой, сбился! Их опять тысяча!","vocal":false},{"t":367.702,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":367.702,"dur":1.868,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":367.702,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":367.702,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":372.49,"dur":2.841,"who":"К104","name":"Топа","text":"Красота! Одна мигает, другая сверкает!","vocal":false},{"t":376.131,"dur":4.688,"who":"К104","name":"Топа","text":"Днём на небе со́лнце, а звёзды ждут. А ночью их очередь!","vocal":false},{"t":381.118,"dur":2.861,"who":"К105","name":"Филя","text":"Как будто звёзды играют с солнцем в прятки!","vocal":false},{"t":384.28,"dur":3.549,"who":"К102","name":"Пик","text":"Почти так. Только они не прячутся. Днём их просто не ви́дно.","vocal":false},{"t":389.729,"dur":3.521,"who":"К103","name":"Рон","text":"Звёзды, привет! Я знаю, днём вы тоже там!","vocal":false},{"t":403.832,"dur":1.849,"who":"К104","name":"Топа","text":"Ночью кататься ещё веселее!","vocal":false},{"t":405.98,"dur":0.96,"who":"К101","name":"Барсик","text":"Ах-ха-ха!","vocal":true},{"t":407.06,"dur":1.827,"who":"К101","name":"Барсик","text":"Как будто едешь прямо к звёздам!","vocal":false},{"t":420.527,"dur":1.044,"who":"К102","name":"Пик","text":"Ура! Я тоже еду!","vocal":false},{"t":422.171,"dur":1.705,"who":"К105","name":"Филя","text":"Ночью всё небо в огоньках.","vocal":false},{"t":424.176,"dur":2.289,"who":"К102","name":"Пик","text":"А днём они тоже там. Мы теперь знаем.","vocal":false},{"t":426.765,"dur":4.709,"who":"К103","name":"Рон","text":"Завтра днём помашу звёздам. Пусть знают, что я их помню!","vocal":false},{"t":431.774,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":431.774,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":431.774,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":431.774,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":431.774,"dur":1.834,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":433.756,"dur":2.36,"who":"К104","name":"Топа","text":"Пойдёмте домой. Холодно!","vocal":false},{"t":440.817,"dur":6.381,"who":"К102","name":"Пик","text":"Звёзды никуда не прячутся. Днём их не ви́дно, потому что со́лнце светит ярко. А ночью темно, и звёзды ви́дно.","vocal":false},{"t":447.497,"dur":4.845,"who":"К103","name":"Рон","text":"А я запишу: со́лнце тоже звезда! Самая главная!","vocal":false},{"t":452.642,"dur":3.277,"who":"К105","name":"Филя","text":"И фонарик ночью ярче. Хотя светит так же.","vocal":false},{"t":456.22,"dur":0.96,"who":"К101","name":"Барсик","text":"Ах-ха-ха!","vocal":true},{"t":457.3,"dur":2.447,"who":"К101","name":"Барсик","text":"А Рон сегодня считал звёзды целых два раза!","vocal":false},{"t":460.046,"dur":1.692,"who":"К103","name":"Рон","text":"И оба раза сбился.","vocal":false},{"t":462.038,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":462.038,"dur":1.834,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":462.038,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":462.038,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":464.702,"dur":2.202,"who":"К104","name":"Топа","text":"А-а-а-ах.","vocal":true},{"t":467.005,"dur":3.758,"who":"К104","name":"Топа","text":"Уже́ ночь. А мы только поужинали.","vocal":false},{"t":471.063,"dur":4.365,"who":"К105","name":"Филя","text":"Зимой так рано темнеет! Ещё вечер, а уже́ темно. Почему?","vocal":false},{"t":475.728,"dur":2.37,"who":"К101","name":"Барсик","text":"Вот это загадка! Завтра узнаем!","vocal":false},{"t":479.197,"dur":1.956,"who":"К102","name":"Пик","text":"Ти́ше. Топа уже́ спит.","vocal":false},{"t":483.054,"dur":8.449,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу поставить лайк и подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, ночь\",\"seed\":101,\"time\":\"night\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":14.977,"kind":"title","loc":""},{"t0":17.977,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"зима, утро\",\"seed\":102,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":58.657,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"зимняя горка, день\",\"seed\":103,\"time\":\"day\",\"type\":\"winter\",\"variant\":\"hill\",\"weather\":\"none\"}"},{"t0":137.645,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"кухня, день\",\"seed\":104,\"snowOut\":true,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":189.697,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"зима, утро\",\"seed\":102,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":228.512,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"комната, день\",\"seed\":105,\"snowOut\":true,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":305.42,"kind":"scene","loc":"{\"id\":\"Л106\",\"name\":\"зимняя горка, вечер\",\"seed\":106,\"time\":\"evening\",\"type\":\"winter\",\"variant\":\"hill\",\"weather\":\"non