{"dur":315.67063705936914,"names":{"К103":"Рон","К105":"Филя","К101":"Барсик","К104":"Топа","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":2.882,"who":"К103","name":"Рон","text":"Смотрите, вот наша лужа. Сейчас — плюх!","vocal":false},{"t":4.382,"dur":0.456,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":5.332,"dur":2.613,"who":"К103","name":"Рон","text":"Ой! Она не плюхает! Она твёрдая!","vocal":false},{"t":8.395,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":10.378,"dur":2.28,"who":"К101","name":"Барсик","text":"Лужа замёрзла! Теперь это лёд!","vocal":false},{"t":12.958,"dur":3.569,"who":"К104","name":"Топа","text":"Блестит, как стекло. И скользкий-скользкий.","vocal":false},{"t":17.427,"dur":1.802,"who":"К103","name":"Рон","text":"А где вода? Она пропала?","vocal":false},{"t":19.529,"dur":3.279,"who":"К101","name":"Барсик","text":"Никуда. Вода здесь. Только она стала твёрдой.","vocal":false},{"t":23.109,"dur":3.211,"who":"К104","name":"Топа","text":"Ночью пришёл мороз. И заморозил лужу.","vocal":false},{"t":26.77,"dur":0.395,"who":"К103","name":"Рон","text":"Хм-м…","vocal":true},{"t":28.22,"dur":1.419,"who":"К103","name":"Рон","text":"Пахнет… холодом.","vocal":false},{"t":29.939,"dur":1.587,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":29.939,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":29.939,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":29.939,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":31.921,"dur":2.831,"who":"К105","name":"Филя","text":"Смотрите, вот наш снеговик! Он стоит!","vocal":false},{"t":35.052,"dur":1.962,"who":"К103","name":"Рон","text":"Снежок Второй! Ты не растаял!","vocal":false},{"t":37.314,"dur":2.622,"who":"К102","name":"Пик","text":"Ночью было очень холодно. А в холоде снег не тает.","vocal":false},{"t":40.236,"dur":3.259,"who":"К101","name":"Барсик","text":"Мороз растопить не может. Мороз — замораживает.","vocal":false},{"t":48.195,"dur":2.576,"who":"К105","name":"Филя","text":"Это наша лужа. А теперь это каток!","vocal":false},{"t":51.872,"dur":2.329,"who":"К103","name":"Рон","text":"Я катаюсь! Я лучше всех катаюсь!","vocal":false},{"t":54.551,"dur":0.456,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":55.501,"dur":1.637,"who":"К103","name":"Рон","text":"Ой. Тут тоже твёрдо.","vocal":false},{"t":57.438,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":57.438,"dur":1.642,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":59.421,"dur":1.582,"who":"К104","name":"Топа","text":"Можно я тоже попробую?","vocal":false},{"t":61.653,"dur":0.463,"who":"К104","name":"Топа","text":"Ай!","vocal":true},{"t":62.603,"dur":2.204,"who":"К104","name":"Топа","text":"Ой! Лапы сами разъезжаются!","vocal":false},{"t":65.107,"dur":2.351,"who":"К101","name":"Барсик","text":"Держись, Топа! Вставай потихоньку.","vocal":false},{"t":67.758,"dur":3.352,"who":"К105","name":"Филя","text":"Надо ходить маленькими шажками. Как пингвин!","vocal":false},{"t":72.31,"dur":2.631,"who":"К101","name":"Барсик","text":"А ещё на льду нельзя бегать. Можно упасть.","vocal":false},{"t":75.241,"dur":2.22,"who":"К102","name":"Пик","text":"И на речку не ходим. Там лёд бывает тонким.","vocal":false},{"t":78.411,"dur":0.588,"who":"К103","name":"Рон","text":"Тук-тук!","vocal":true},{"t":79.761,"dur":1.916,"who":"К103","name":"Рон","text":"Тук-тук! Лужа, ты дома?","vocal":false},{"t":81.978,"dur":0.81,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":82.908,"dur":2.373,"who":"К105","name":"Филя","text":"Она не откроет. Она замёрзла!","vocal":false},{"t":86.181,"dur":2.787,"who":"К104","name":"Топа","text":"А можно сделать лёд самим? Дома?","vocal":false},{"t":89.268,"dur":2.461,"who":"К101","name":"Барсик","text":"Давайте попробуем! Нужна вода и мороз.","vocal":false},{"t":94.029,"dur":1.473,"who":"К102","name":"Пик","text":"Вот миска. В ней вода.","vocal":false},{"t":96.302,"dur":3.099,"who":"К105","name":"Филя","text":"Вода мокрая. Её можно налить и вылить.","vocal":false},{"t":99.701,"dur":3.332,"who":"К103","name":"Рон","text":"Вода, стань твёрдой! Раз, два, три!","vocal":false},{"t":105.333,"dur":2.378,"who":"К103","name":"Рон","text":"Не получилось. Она меня не слушает.","vocal":false},{"t":108.011,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":108.011,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":108.011,"dur":1.587,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":110.014,"dur":3.119,"who":"К103","name":"Рон","text":"А если подуть? Ффф! Стала твёрдая?","vocal":false},{"t":113.433,"dur":0.79,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":114.343,"dur":2.144,"who":"К105","name":"Филя","text":"Нет, Рон. Ты же тёплый!","vocal":false},{"t":116.786,"dur":2.759,"who":"К101","name":"Барсик","text":"На кухне тепло. Здесь вода не замёрзнет.","vocal":false},{"t":119.845,"dur":2.18,"who":"К102","name":"Пик","text":"Надо поставить её на мороз. На всю ночь.","vocal":false},{"t":122.325,"dur":1.827,"who":"К104","name":"Топа","text":"Ночью мороз сильнее всего.","vocal":false},{"t":124.452,"dur":1.989,"who":"К103","name":"Рон","text":"Давайте я! Я осторожно!","vocal":false},{"t":132.173,"dur":1.188,"who":"К105","name":"Филя","text":"Только не разлей.","vocal":false},{"t":138.261,"dur":2.809,"who":"К103","name":"Рон","text":"Вот. Стой тут, миска. Жди мороз.","vocal":false},{"t":141.37,"dur":3.393,"who":"К101","name":"Барсик","text":"Смотрите, вот наш снеговик. Он будет за ней смотреть.","vocal":false},{"t":145.063,"dur":2.211,"who":"К103","name":"Рон","text":"Я тоже буду сторожить. Всю ночь!","vocal":false},{"t":148.174,"dur":2.709,"who":"К102","name":"Пик","text":"Рон, ночью очень холодно. У тебя нос замёрзнет.","vocal":false},{"t":151.183,"dur":1.208,"who":"К103","name":"Рон","text":"Мой нос храбрый.","vocal":false},{"t":152.74,"dur":1.162,"who":"К103","name":"Рон","text":"Апчхи!","vocal":true},{"t":154.002,"dur":0.915,"who":"К105","name":"Филя","text":"Будь здоров!","vocal":false},{"t":155.217,"dur":2.876,"who":"К103","name":"Рон","text":"Ладно. Носу холодно. Идёмте греться.","vocal":false},{"t":158.393,"dur":1.587,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":158.393,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":158.393,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":158.393,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":161.806,"dur":5.379,"who":"К101","name":"Барсик","text":"Давайте поиграем. Я скажу слово, а вы — твёрдое оно или мягкое.","vocal":false},{"t":167.486,"dur":0.676,"who":"К105","name":"Филя","text":"Давай!","vocal":false},{"t":168.462,"dur":0.915,"who":"К101","name":"Барсик","text":"Подушка!","vocal":false},{"t":171.677,"dur":0.831,"who":"К104","name":"Топа","text":"Мягкая!","vocal":false},{"t":172.808,"dur":0.602,"who":"К101","name":"Барсик","text":"Камень!","vocal":false},{"t":175.71,"dur":0.779,"who":"К105","name":"Филя","text":"Твёрдый!","vocal":false},{"t":176.789,"dur":0.951,"who":"К101","name":"Барсик","text":"Вода в миске!","vocal":false},{"t":180.041,"dur":0.93,"who":"К103","name":"Рон","text":"Она плюхает!","vocal":false},{"t":181.271,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":181.271,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":181.271,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":181.271,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":183.274,"dur":0.76,"who":"К101","name":"Барсик","text":"Снежок!","vocal":false},{"t":186.334,"dur":0.642,"who":"К102","name":"Пик","text":"Холодный!","vocal":false},{"t":187.276,"dur":0.8,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":188.196,"dur":0.992,"who":"К105","name":"Филя","text":"Это не ответ!","vocal":false},{"t":189.488,"dur":0.477,"who":"К101","name":"Барсик","text":"Лёд!","vocal":false},{"t":192.266,"dur":1.735,"who":"К104","name":"Топа","text":"Твёрдый! И скользкий!","vocal":false},{"t":194.301,"dur":2.711,"who":"К102","name":"Пик","text":"А вода в миске утром, может быть, будет твёрдая.","vocal":false},{"t":197.462,"dur":2.211,"who":"К104","name":"Топа","text":"А-а-а-ах.","vocal":true},{"t":199.773,"dur":3.792,"who":"К104","name":"Топа","text":"А я пойду спать. Утром узнаем.","vocal":false},{"t":205.265,"dur":1.587,"who":"К101","name":"Барсик","text":"Смотрите, вот миска!","vocal":false},{"t":207.152,"dur":1.944,"who":"К103","name":"Рон","text":"Вода замёрзла! Теперь там лёд!","vocal":false},{"t":209.396,"dur":2.831,"who":"К105","name":"Филя","text":"Можно потрогать? Ой, какой холодный!","vocal":false},{"t":213.127,"dur":1.815,"who":"К103","name":"Рон","text":"Тяжёлая. И холодная!","vocal":false},{"t":215.242,"dur":1.727,"who":"К105","name":"Филя","text":"Переверни её, Рон!","vocal":false},{"t":217.269,"dur":2.023,"who":"К103","name":"Рон","text":"Не выливается! Ни капельки!","vocal":false},{"t":219.593,"dur":2.104,"who":"К102","name":"Пик","text":"Конечно. Он твёрдый. Он не льётся.","vocal":false},{"t":221.997,"dur":1.961,"who":"К103","name":"Рон","text":"Её не попьёшь! Только грызть!","vocal":false},{"t":224.258,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":224.258,"dur":1.642,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":224.258,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":224.258,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":226.271,"dur":1.928,"who":"К104","name":"Топа","text":"Мы сделали лёд сами! С морозом.","vocal":false},{"t":228.5,"dur":2.208,"who":"К101","name":"Барсик","text":"А что будет, если лёд принести домой?","vocal":false},{"t":231.008,"du