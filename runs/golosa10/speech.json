{"dur":77.07464583333334,"names":{"К102":"Рон","К101":"Барсик","К103":"Филя","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":2.466,"who":"Р","name":"Рассказчик","text":"Рон, с паузами между фразами.","vocal":false},{"t":3.016,"dur":2.263,"who":"К102","name":"Рон","text":"Ого! Какие красивые!","vocal":false},{"t":5.579,"dur":2.263,"who":"К102","name":"Рон","text":"Ого́! Какие красивые!","vocal":false},{"t":8.142,"dur":2.209,"who":"К102","name":"Рон","text":"Мороз! Это он художник!","vocal":false},{"t":10.651,"dur":2.857,"who":"К102","name":"Рон","text":"Са́харом не пахнет. Жаль.","vocal":false},{"t":13.808,"dur":2.676,"who":"К102","name":"Рон","text":"А иней вкусный? Я попробую!","vocal":false},{"t":16.784,"dur":3.025,"who":"К102","name":"Рон","text":"Тсс! Я ищу следы художника.","vocal":false},{"t":20.108,"dur":2.904,"who":"К102","name":"Рон","text":"Смотрите, вот санки! Кто кататься?","vocal":false},{"t":23.312,"dur":2.664,"who":"К102","name":"Рон","text":"Очень холодно! Я долго сидел.","vocal":false},{"t":26.276,"dur":3.498,"who":"К102","name":"Рон","text":"Ой! Пропала! Тут только мокро!","vocal":false},{"t":30.074,"dur":1.426,"who":"К102","name":"Рон","text":"Горка! Ура!","vocal":false},{"t":31.8,"dur":5.45,"who":"К102","name":"Рон","text":"Смотрите, вот наша лужа. Сейчас — плюх! Ой! Тут только мокро!","vocal":false},{"t":37.55,"dur":1.753,"who":"К102","name":"Рон","text":"Тихо! Это тайна.","vocal":false},{"t":39.603,"dur":3.285,"who":"К102","name":"Рон","text":"Вода знает цифру шесть? Вот умница!","vocal":false},{"t":43.187,"dur":3.219,"who":"К102","name":"Рон","text":"Она как звёздочка! Белая звёздочка!","vocal":false},{"t":46.707,"dur":3.414,"who":"К101","name":"Барсик","text":"Смотрите, вот лужа! А снеговика нет.","vocal":false},{"t":50.42,"dur":1.426,"who":"К102","name":"Рон","text":"Горка! Ура!","vocal":false},{"t":52.147,"dur":2.623,"who":"К103","name":"Филя","text":"Смотрите! Вот снежинка! У меня в лапке!","vocal":false},{"t":55.07,"dur":3.226,"who":"К102","name":"Рон","text":"Ой! Пропала! Тут только мокро!","vocal":false},{"t":58.596,"dur":2.578,"who":"К101","name":"Барсик","text":"Снежинка растаяла. Стала капелькой.","vocal":false},{"t":61.474,"dur":2.451,"who":"К102","name":"Рон","text":"Растаяла. Жалко.","vocal":false},{"t":64.225,"dur":1.854,"who":"К102","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":64.225,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":64.225,"dur":1.883,"who":"К103","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":67.828,"dur":7.646,"who":"К102","name":"Рон","text":"Понравился мультик? Попроси маму или папу поставить лайк и подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"двор, день\",\"seed\":101,\"time\":\"day\",\"type\":\"yard\",\"weather\":\"none\"}"},{"t0":67.028,"kind":"end","loc":""}]}