":false},{"t":49.771,"dur":1.507,"who":"К103","name":"Рон","text":"Зато у него есть холод.","vocal":false},{"t":51.579,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":51.579,"dur":1.642,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":51.579,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":51.579,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":51.579,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":53.592,"dur":3.347,"who":"К101","name":"Барсик","text":"Пойдёмте на улицу. Посмотрим, где ещё мороз рисовал.","vocal":false},{"t":61.639,"dur":2.308,"who":"К101","name":"Барсик","text":"Смотрите! Деревья все белые!","vocal":false},{"t":64.247,"dur":2.11,"who":"К104","name":"Топа","text":"Как будто их сахаром посыпали.","vocal":false},{"t":66.657,"dur":4.786,"who":"К105","name":"Филя","text":"Это не снег. Снег — это хлопья. А тут колючие иголочки.","vocal":false},{"t":71.743,"dur":2.89,"who":"К102","name":"Пик","text":"Он называется иней. Бывает, когда ночью сильный мороз.","vocal":false},{"t":75.083,"dur":0.395,"who":"К103","name":"Рон","text":"Хм-м…","vocal":true},{"t":76.533,"dur":1.9,"who":"К103","name":"Рон","text":"Сахаром не пахнет. Жаль.","vocal":false},{"t":78.733,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":78.733,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":78.733,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":78.733,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":78.733,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":80.737,"dur":2.097,"who":"К103","name":"Рон","text":"А иней вкусный? Я попробую!","vocal":false},{"t":83.134,"dur":2.088,"who":"К102","name":"Пик","text":"Нет, Рон! На морозе ничего не лижем!","vocal":false},{"t":85.522,"dur":2.555,"who":"К101","name":"Б