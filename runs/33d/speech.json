{"dur":347.5773042800454,"names":{"К104":"Топа","К103":"Рон","К101":"Барсик","К105":"Филя","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.85,"dur":4.601,"who":"К104","name":"Топа","text":"Смотрите! Шишка закрылась! А вчера была раскрытая, как ёжик!","vocal":false},{"t":6.901,"dur":1.162,"who":"К103","name":"Рон","text":"Апчхи!","vocal":true},{"t":8.163,"dur":0.782,"who":"К101","name":"Барсик","text":"Будь здоров!","vocal":false},{"t":9.246,"dur":5.625,"who":"К103","name":"Рон","text":"Холодная шишка! Может, ей ночью было зябко? И она закуталась. Как я без шарфа.","vocal":false},{"t":15.32,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":17.314,"dur":1.806,"who":"К102","name":"Пик","text":"Посмотрите на траву. Она мокрая.","vocal":false},{"t":19.42,"dur":1.368,"who":"К105","name":"Филя","text":"Ночью шёл дождик!","vocal":false},{"t":21.088,"dur":5.281,"who":"К101","name":"Барсик","text":"Вчера было сухо, и шишка раскрылась. Сегодня сыро, и она закрылась.","vocal":false},{"t":26.669,"dur":4.811,"who":"К103","name":"Рон","text":"Значит, шишка знает погоду? Шишка, будет завтра дождь? Кивни!","vocal":false},{"t":33.781,"dur":1.659,"who":"К103","name":"Рон","text":"Молчит. Скромная.","vocal":false},{"t":35.739,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":35.739,"dur":1.642,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":35.739,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":35.739,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":35.739,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":37.722,"dur":2.618,"who":"К102","name":"Пик","text":"Давайте проверим. Возьмём ещё шишки и сделаем опыт.","vocal":false},{"t":45.04,"dur":3.038,"who":"К101","name":"Барсик","text":"Смотрите, вот сосна. Шишки растут на ней.","vocal":false},{"t":48.377,"dur":1.599,"who":"К105","name":"Филя","text":"А зачем сосне шишки?","vocal":false},{"t":50.277,"dur":2.723,"who":"К102","name":"Пик","text":"В шишке спрятаны семена. Из них вырастают новые сосны.","vocal":false},{"t":53.3,"dur":1.434,"who":"К104","name":"Топа","text":"Как дуб из жёлудя!","vocal":false},{"t":55.634,"dur":3.592,"who":"К103","name":"Рон","text":"А вот раскрытая шишка. Под деревом лежала, где сухо.","vocal":false},{"t":59.526,"dur":2.748,"who":"К105","name":"Филя","text":"Одна раскрытая, другая закрытая!","vocal":false},{"t":62.574,"dur":2.907,"who":"К101","name":"Барсик","text":"Возьмём обе домой. Посмотрим, что с ними будет.","vocal":false},{"t":65.781,"dur":2.644,"who":"К103","name":"Рон","text":"Я понесу. Я теперь главный по шишкам.","vocal":false},{"t":68.724,"dur":1.315,"who":"К103","name":"Рон","text":"И эту. И вот эту!","vocal":false},{"t":70.84,"dur":0.81,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":71.77,"dur":2.411,"who":"К105","name":"Филя","text":"Главный по шишкам, ты их теряешь!","vocal":false},{"t":74.481,"dur":3.44,"who":"К103","name":"Рон","text":"Я не теряю. Я их сею. Пусть растут новые сосны.","vocal":false},{"t":78.221,"dur":3.995,"who":"К101","name":"Барсик","text":"Почти правда. Сосны так и сеют семена — только без помощи Рона.","vocal":false},{"t":84.516,"dur":1.473,"who":"К102","name":"Пик","text":"Вот миска. В ней вода.","vocal":false},{"t":87.388,"dur":2.793,"who":"К103","name":"Рон","text":"Вот раскрытая шишка. Она будет купаться?","vocal":false},{"t":90.481,"dur":2.317,"who":"К102","name":"Пик","text":"Да. Посмотрим, что она сделает в воде.","vocal":false},{"t":93.598,"dur":1.657,"who":"К102","name":"Пик","text":"Шишка в воде. А теперь ждём.","vocal":false},{"t":95.555,"dur":0.691,"who":"К105","name":"Филя","text":"Сколько?","vocal":false},{"t":96.547,"dur":0.969,"who":"К101","name":"Барсик","text":"Примерно час.","vocal":false},{"t":97.816,"dur":2.024,"who":"К103","name":"Рон","text":"Час? Это же целая вечность!","vocal":false},{"t":102.14,"dur":1.305,"who":"К103","name":"Рон","text":"Уже час прошёл?","vocal":false},{"t":103.745,"dur":1.009,"who":"К102","name":"Пик","text":"Прошла одна минута.","vocal":false},{"t":105.054,"dur":1.409,"who":"К103","name":"Рон","text":"Какая длинная минута.","vocal":false},{"t":106.764,"dur":2.287,"who":"К104","name":"Топа","text":"Можно пока нарисовать, что будет.","vocal":false},{"t":112.95,"dur":1.796,"who":"К104","name":"Топа","text":"Я думаю, она утонет.","vocal":false},{"t":118.046,"dur":3.068,"who":"К105","name":"Филя","text":"А я думаю, она станет мокрой и закроется.","vocal":false},{"t":121.414,"dur":3.147,"who":"К103","name":"Рон","text":"А я думаю, она научится плавать. Как лодка!","vocal":false},{"t":124.861,"dur":0.74,"who":"К101","name":"Барсик","text":"Ха-ха!","vocal":true},{"t":125.721,"dur":1.611,"who":"К101","name":"Барсик","text":"Через час узнаем, кто прав.","vocal":false},{"t":129.031,"dur":1.304,"who":"Р","name":"Рассказчик","text":"Прошёл час.","vocal":false},{"t":130.635,"dur":1.976,"who":"К103","name":"Рон","text":"Смотрите! Шишка закрылась!","vocal":false},{"t":132.912,"dur":0.97,"who":"К105","name":"Филя","text":"Я угадал!","vocal":false},{"t":134.182,"dur":2.087,"who":"К104","name":"Топа","text":"И не утонула. Плавает.","vocal":false},{"t":136.569,"dur":2.913,"who":"К103","name":"Рон","text":"Почти как лодка. Я тоже немного угадал.","vocal":false},{"t":139.781,"dur":1.975,"who":"К102","name":"Пик","text":"Чешуйки шишки впитали воду и сомкнулись.","vocal":false},{"t":142.057,"dur":3.755,"who":"К101","name":"Барсик","text":"Шишка закрывается, когда сыро. Так она прячет семена от дождя.","vocal":false},{"t":146.112,"dur":1.057,"who":"К104","name":"Топа","text":"А когда сухо?","vocal":false},{"t":147.469,"dur":3.34,"who":"К101","name":"Барсик","text":"Тогда раскрывается. Сухие семена разлетаются дальше.","vocal":false},{"t":151.109,"dur":4.21,"who":"К105","name":"Филя","text":"Значит, шишка не угадывает погоду. Она чувствует сырость!","vocal":false},{"t":155.619,"dur":3.561,"who":"К102","name":"Пик","text":"Точно. Влажный воздух — шишка закрыта. Сухой — раскрыта.","vocal":false},{"t":161.481,"dur":4.506,"who":"К104","name":"Топа","text":"А теперь положим мокрую шишку на окно. Там тепло и сухо.","vocal":false},{"t":166.787,"dur":1.548,"who":"К103","name":"Рон","text":"Сколько ждать на этот раз?","vocal":false},{"t":168.635,"dur":1.244,"who":"К102","name":"Пик","text":"Подольше. До завтра.","vocal":false},{"t":170.179,"dur":2.381,"who":"К103","name":"Рон","text":"До завтра? Шишки очень медленные.","vocal":false},{"t":172.86,"dur":2.755,"who":"К105","name":"Филя","text":"Зато честные. Обманывать не умеют.","vocal":false},{"t":175.915,"dur":2.044,"who":"К101","name":"Барсик","text":"Пока ждём, посмотрим на семечко.","vocal":false},{"t":178.858,"dur":3.167,"who":"К102","name":"Пик","text":"Семечко из шишки похоже на это пёрышко. У него есть крылышко.","vocal":false},{"t":182.325,"dur":2.376,"who":"К102","name":"Пик","text":"Оно падает и кружится, как маленький вертолётик.","vocal":false},{"t":185.801,"dur":0.7,"who":"К103","name":"Рон","text":"Вот так?","vocal":false},{"t":186.802,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":187.764,"dur":1.501,"who":"К104","name":"Топа","text":"Да! Только семечко меньше.","vocal":false},{"t":189.565,"dur":1.186,"who":"К103","name":"Рон","text":"Зато я громче!","vocal":false},{"t":193.551,"dur":3.993,"who":"К104","name":"Топа","text":"Повесим вторую шишку во дворе. Пусть живёт на улице.","vocal":false},{"t":198.344,"dur":4.762,"who":"К105","name":"Филя","text":"А я нарисую табличку. Сухо — раскрыта. Сыро — закрыта.","vocal":false},{"t":206.407,"dur":1.24,"who":"Р","name":"Рассказчик","text":"Пошёл дождь.","vocal":false},{"t":207.947,"dur":0.992,"who":"К103","name":"Рон","text":"Ой! Дождь!","vocal":false},{"t":209.839,"dur":1.687,"who":"К104","name":"Топа","text":"Шишка во дворе намокнет!","vocal":false},{"t":211.826,"dur":2.439,"who":"К102","name":"Пик","text":"Пусть намокнет. Посмотрим, что она сделает.","vocal":false},{"t":217.566,"dur":2.769,"who":"К105","name":"Филя","text":"Смотрите! Её чешуйки уже сжимаются!","vocal":false},{"t":220.634,"dur":3.253,"who":"К103","name":"Рон","text":"Шишка тоже прячется. Только у неё зонтик внутри!","vocal":false},{"t":224.187,"dur":1.469,"who":"Р","name":"Рассказчик","text":"Дождь кончился.","vocal":false},{"t":227.855,"dur":2.531,"who":"К103","name":"Рон","text":"Внимание! Начинаем прогноз погоды!","vocal":false},{"t":231.286,"dur":2.849,"who":"К103","name":"Рон","text":"С вами Рон и его помощница — шишка-синоптик.","vocal":false},{"t":234.585,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":236.579,"dur":3.79,"who":"К103","name":"Рон","text":"Шишка открыта. Значит, воздух сухой. Можно гулять!","vocal":false},{"t":240.669,"dur":1.34,"who":"К102","name":"Пик","text":"А если шишка закроется?","vocal":false},{"t":242.309,"dur":2.963,"who":"К103","name":"Рон","text":"Тогда берём зонтик. И сидим под ним все вместе.","vocal":false},{"t":245.571,"dur":2.584,"who":"К101","name":"Барсик","text":"Хороший прогноз. Главное — понятный.","vocal":false},{"t":248.455,"dur":4.731,"who":"К104","name":"Топа","text":"Давай повесим шишку у двери. Будем смотреть на неё каждый день.","vocal":false},{"t":253.986,"dur":3.437,"who":"К103","name":"Рон","text":"Прогноз окончен. Всем спасибо. Шишка устала.","vocal":false},{"t":257.724,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":257.724,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":257.724,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":257.724,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":257.724,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":261.127,"dur":2.786,"who":"Р","name":"Рассказчик","text":"Утром друзья проверили шишку на окне.","vocal":false},{"t":264.813,"dur":1.661,"who":"К104","name":"Топа","text":"Она снова раскрылась!","vocal":false},{"t":266.774,"dur":3.206,"who":"К105","name":"Филя","text":"Высохла — и раскрылась. Как мы и думали!","vocal":false},{"t":270.28,"dur":2.717,"who":"К102","name":"Пик","text":"Опыт получился. Шишка всегда следит за сыростью.","vocal":false},{"t":273.297,"dur":4.118,"who":"К103","name":"Рон","text":"Хочу такую же. Чтобы утром сразу знать, надевать ли сапоги.","vocal":false},{"t":277.716,"dur":3.148,"who":"К101","name":"Барсик","text":"Можно взять две шишки. Одну тебе, одну на окно.","vocal":false},{"t":281.163,"dur":2.197,"who":"К103","name":"Рон","text":"Две шишки! Целая метеостанция!","vocal":false},{"t":284.76,"dur":4.092,"who":"К105","name":"Филя","text":"Я перечитал наш дневник. Смотрите, сколько мы узнали!","vocal":false},{"t":291.552,"dur":2.821,"who":"К105","name":"Филя","text":"Лужу на асфальте сушат солнце и ветер","vocal":false},{"t":294.672,"dur":1.21,"who":"К103","name":"Рон","text":"А я её сторожил!","vocal":false},{"t":296.182,"dur":2.368,"who":"К105","name":"Филя","text":"Компас всегда показывает на север","vocal":false},{"t":298.85,"dur":1.269,"who":"К103","name":"Рон","text":"А я его запутывал!","vocal":false},{"t":300.419,"dur":2.425,"who":"К105","name":"Филя","text":"Шишка закрывается, когда сыро","vocal":false},{"t":303.144,"dur":1.591,"who":"К103","name":"Рон","text":"А я веду прогноз погоды!","vocal":false},{"t":305.035,"dur":0.622,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":305.777,"dur":1.265,"who":"К102","name":"Пик","text":"Рон, ты везде успел.","vocal":false},{"t":307.341,"dur":3.174,"who":"К103","name":"Рон","text":"Я же главный помощник. И сторож. И синоптик.","vocal":false},{"t":312.716,"dur":4.795,"who":"Р","name":"Рассказчик","text":"После дождей друзья снова пришли к камню, где посадили жёлудь.","vocal":false},{"t":317.811,"dur":3.106,"who":"К105","name":"Филя","text":"Земля влажная. Шишка бы сейчас закрылась.","vocal":false},{"t":321.216,"dur":2.395,"who":"К103","name":"Рон","text":"Жёлудю, наверное, нравится.","vocal":false},{"t":324.411,"dur":2.773,"who":"К104","name":"Топа","text":"Смотрите! Возле камня что-то зелёное!","vocal":false},{"t":327.485,"dur":0.707,"who":"К102","name":"Пик","text":"Вот росток!","vocal":false},{"t":328.492,"dur":1.691,"who":"К102","name":"Пик","text":"Кажется, жёлудь проснулся!","vocal":false},{"t":330.483,"dur":2.702,"who":"К105","name":"Филя","text":"Запишу в дневник! Это самый важный день!","vocal":false},{"t":333.485,"dur":2.668,"who":"К101","name":"Барсик","text":"Завтра рассмотрим поближе. Только осторожно.","vocal":false},{"t":336.452,"dur":2.749,"who":"К103","name":"Рон","text":"Тихо, все. Не разбудите его обратно.","vocal":false},{"t":341.101,"dur":4.876,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"двор, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"yard\",\"weather\":\"none\"}"},{"t0":41.44,"kind":"title","loc":""},{"t0":44.44,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"лес, утро\",\"seed\":102,\"time\":\"day\",\"type\":\"forest\",\"weather\":\"none\"}"},{"t0":83.316,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"кухня, день\",\"seed\":103,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":128.431,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"кухня, день\",\"seed\":103,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":160.281,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"комната, день\",\"seed\":104,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":192.351,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"двор, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"yard\",\"weather\":\"none\",\"wxAt\":[{\"t\":14.36,\"v\":\"rain\"},{\"t\":32.14,\"v\":\"none\"}]}"},{"t0":227.255,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"двор, вечер\",\"seed\":105,\"time\":\"evening\",\"type\":\"yard\",\"weather\":\"none\"}"},{"t0":260.527,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"комната, день\",\"seed\":104,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":312.116,"kind":"scene","loc":"{\"id\":\"Л106\",\"name\":\"луг, утро\",\"seed\":106,\"time\":\"day\",\"type\":\"meadow\",\"weather\":\"none\"}"},{"t0":340.301,"kind":"end","loc":""}]}