{"dur":110.78453925736959,"names":{"К103":"Рон","К105":"Филя","К101":"Барсик","К104":"Топа","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":3.428,"who":"К103","name":"Рон","text":"Смотри́те, вот наша лужа. Сейчас — плюх!","vocal":false},{"t":4.928,"dur":0.56,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":5.878,"dur":3.636,"who":"К103","name":"Рон","text":"Ой! Она не плюхает! Она твёрдая!","vocal":false},{"t":9.963,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":11.947,"dur":2.28,"who":"К101","name":"Барсик","text":"Лужа замёрзла! Теперь это лёд!","vocal":false},{"t":14.526,"dur":3.569,"who":"К104","name":"Топа","text":"Блестит, как стекло. И скользкий-скользкий.","vocal":false},{"t":18.995,"dur":3.442,"who":"К103","name":"Рон","text":"А где вода? Она пропала?","vocal":false},{"t":22.737,"dur":3.279,"who":"К101","name":"Барсик","text":"Никуда. Вода здесь. Только она стала твёрдой.","vocal":false},{"t":26.316,"dur":3.211,"who":"К104","name":"Топа","text":"Ночью пришёл мороз. И заморозил лужу.","vocal":false},{"t":29.978,"dur":0.51,"who":"К103","name":"Рон","text":"Хм-м…","vocal":true},{"t":31.428,"dur":1.961,"who":"К103","name":"Рон","text":"Пахнет… холодом.","vocal":false},{"t":33.689,"dur":1.783,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":33.689,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":33.689,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":33.689,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":35.671,"dur":2.831,"who":"К105","name":"Филя","text":"Смотри́те, вот наш снеговик! Он стои́т!","vocal":false},{"t":38.802,"dur":2.591,"who":"К103","name":"Рон","text":"Снежок Второй! Ты не растаял!","vocal":false},{"t":41.693,"dur":3.879,"who":"К104","name":"Топа","text":"Ночью было очень холодно. А в холоде снег не та́ет.","vocal":false},{"t":45.872,"dur":3.259,"who":"К101","name":"Барсик","text":"Мороз растопить не может. Мороз — замораживает.","vocal":false},{"t":53.831,"dur":2.576,"who":"К105","name":"Филя","text":"Это наша лужа. А теперь это каток!","vocal":false},{"t":57.507,"dur":3.724,"who":"К103","name":"Рон","text":"Я катаюсь! Я лучше всех катаюсь!","vocal":false},{"t":61.582,"dur":0.56,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":62.532,"dur":2.145,"who":"К103","name":"Рон","text":"Ой. Тут тоже твёрдо.","vocal":false},{"t":64.976,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":64.976,"dur":1.766,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":66.959,"dur":1.582,"who":"К104","name":"Топа","text":"Можно я тоже попробую?","vocal":false},{"t":69.191,"dur":0.463,"who":"К104","name":"Топа","text":"Ай!","vocal":true},{"t":70.141,"dur":2.204,"who":"К104","name":"Топа","text":"Ой! Лапы сами разъезжаются!","vocal":false},{"t":72.645,"dur":2.351,"who":"К101","name":"Барсик","text":"Держись, Топа! Вставай потихоньку.","vocal":false},{"t":75.296,"dur":3.352,"who":"К105","name":"Филя","text":"Надо ходить маленькими шажками. Как пингвин!","vocal":false},{"t":79.848,"dur":2.631,"who":"К101","name":"Барсик","text":"А ещё на льду нельзя бегать. Можно упасть.","vocal":false},{"t":82.779,"dur":2.22,"who":"К102","name":"Пик","text":"И на речку не ходим. Там лёд бывает тонким.","vocal":false},{"t":85.95,"dur":0.852,"who":"К103","name":"Рон","text":"Тук-тук!","vocal":true},{"t":87.3,"dur":2.34,"who":"К103","name":"Рон","text":"Тук-тук! Лужа, ты до́ма?","vocal":false},{"t":89.94,"dur":0.81,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":90.87,"dur":2.373,"who":"К105","name":"Филя","text":"Она не откроет. Она замёрзла!","vocal":false},{"t":94.143,"dur":2.787,"who":"К104","name":"Топа","text":"А можно сделать лёд самим? До́ма?","vocal":false},{"t":97.23,"dur":2.461,"who":"К101","name":"Барсик","text":"Давайте попробуем! Нужна вода и мороз.","vocal":false},{"t":101.591,"dur":7.594,"who":"К103","name":"Рон","text":"