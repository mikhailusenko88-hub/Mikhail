{"dur":341.02294700834875,"names":{"К103":"Рон","К105":"Филя","К101":"Барсик","К104":"Топа","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":3.428,"who":"К103","name":"Рон","text":"Смотри́те, вот наша лужа. Сейчас — плюх!","vocal":false},{"t":4.928,"dur":0.56,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":5.878,"dur":3.636,"who":"К103","name":"Рон","text":"Ой! Она не плюхает! Она твёрдая!","vocal":false},{"t":9.963,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":11.947,"dur":2.28,"who":"К101","name":"Барсик","text":"Лужа замёрзла! Теперь это лёд!","vocal":false},{"t":14.526,"dur":3.569,"who":"К104","name":"Топа","text":"Блестит, как стекло. И скользкий-скользкий.","vocal":false},{"t":18.995,"dur":3.442,"who":"К103","name":"Рон","text":"А где вода? Она пропала?","vocal":false},{"t":22.737,"dur":3.279,"who":"К101","name":"Барсик","text":"Никуда. Вода здесь. Только она стала твёрдой.","vocal":false},{"t":26.316,"dur":3.211,"who":"К104","name":"Топа","text":"Ночью пришёл мороз. И заморозил лужу.","vocal":false},{"t":29.978,"dur":0.51,"who":"К103","name":"Рон","text":"Хм-м…","vocal":true},{"t":31.428,"dur":1.961,"who":"К103","name":"Рон","text":"Пахнет… холодом.","vocal":false},{"t":33.689,"dur":1.783,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":33.689,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":33.689,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":33.689,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":35.671,"dur":2.831,"who":"К105","name":"Филя","text":"Смотри́те, вот наш снеговик! Он стои́т!","vocal":false},{"t":38.802,"dur":2.591,"who":"К103","name":"Рон","text":"Снежок Второй! Ты не растаял!","vocal":false},{"t":41.693,"dur":3.879,"who":"К104","name":"Топа","text":"Ночью было очень холодно. А в холоде снег не та́ет.","vocal":false},{"t":45.872,"dur":3.259,"who":"К101","name":"Барсик","text":"Мороз растопить не может. Мороз — замораживает.","vocal":false},{"t":53.831,"dur":2.576,"who":"К105","name":"Филя","text":"Это наша лужа. А теперь это каток!","vocal":false},{"t":57.507,"dur":3.724,"who":"К103","name":"Рон","text":"Я катаюсь! Я лучше всех катаюсь!","vocal":false},{"t":61.582,"dur":0.56,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":62.532,"dur":2.145,"who":"К103","name":"Рон","text":"Ой. Тут тоже твёрдо.","vocal":false},{"t":64.976,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":64.976,"dur":1.766,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":66.959,"dur":1.582,"who":"К104","name":"Топа","text":"Можно я тоже попробую?","vocal":false},{"t":69.191,"dur":0.463,"who":"К104","name":"Топа","text":"Ай!","vocal":true},{"t":70.141,"dur":2.204,"who":"К104","name":"Топа","text":"Ой! Лапы сами разъезжаются!","vocal":false},{"t":72.645,"dur":2.351,"who":"К101","name":"Барсик","text":"Держись, Топа! Вставай потихоньку.","vocal":false},{"t":75.296,"dur":3.352,"who":"К105","name":"Филя","text":"Надо ходить маленькими шажками. Как пингвин!","vocal":false},{"t":79.848,"dur":2.631,"who":"К101","name":"Барсик","text":"А ещё на льду нельзя бегать. Можно упасть.","vocal":false},{"t":82.779,"dur":2.22,"who":"К102","name":"Пик","text":"И на речку не ходим. Там лёд бывает тонким.","vocal":false},{"t":85.95,"dur":0.852,"who":"К103","name":"Рон","text":"Тук-тук!","vocal":true},{"t":87.3,"dur":2.34,"who":"К103","name":"Рон","text":"Тук-тук! Лужа, ты до́ма?","vocal":false},{"t":89.94,"dur":0.81,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":90.87,"dur":2.373,"who":"К105","name":"Филя","text":"Она не откроет. Она замёрзла!","vocal":false},{"t":94.143,"dur":2.787,"who":"К104","name":"Топа","text":"А можно сделать лёд самим? До́ма?","vocal":false},{"t":97.23,"dur":2.461,"who":"К101","name":"Барсик","text":"Давайте попробуем! Нужна вода и мороз.","vocal":false},{"t":101.991,"dur":1.473,"who":"К102","name":"Пик","text":"Вот миска. В ней вода.","vocal":false},{"t":104.264,"dur":3.099,"who":"К105","name":"Филя","text":"Вода мокрая. Её можно налить и вылить.","vocal":false},{"t":107.663,"dur":3.33,"who":"К103","name":"Рон","text":"Вода, стань твёрдой! Раз, два, три!","vocal":false},{"t":113.293,"dur":4.217,"who":"К103","name":"Рон","text":"Не получилось. Она меня не слушает.","vocal":false},{"t":117.811,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":117.811,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":117.811,"dur":1.783,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":119.814,"dur":3.256,"who":"К103","name":"Рон","text":"А если подуть? Ффф! Стала твёрдая?","vocal":false},{"t":123.37,"dur":0.79,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":124.279,"dur":2.144,"who":"К105","name":"Филя","text":"Нет, Рон. Ты же тёплый!","vocal":false},{"t":126.723,"dur":2.759,"who":"К101","name":"Барсик","text":"На кухне тепло. Здесь вода не замёрзнет.","vocal":false},{"t":129.782,"dur":2.18,"who":"К102","name":"Пик","text":"Надо поставить её на мороз. На всю ночь.","vocal":false},{"t":132.261,"dur":1.827,"who":"К104","name":"Топа","text":"Ночью мороз сильнее всего.","vocal":false},{"t":134.388,"dur":2.986,"who":"К103","name":"Рон","text":"Давайте я! Я осторожно!","vocal":false},{"t":143.106,"dur":1.188,"who":"К105","name":"Филя","text":"Только не разле́й.","vocal":false},{"t":149.194,"dur":3.649,"who":"К103","name":"Рон","text":"Вот. Стой тут, миска. Жди мороз.","vocal":false},{"t":153.144,"dur":3.393,"who":"К101","name":"Барсик","text":"Смотри́те, вот наш снеговик. Он будет за ней смотреть.","vocal":false},{"t":156.837,"dur":2.649,"who":"К103","name":"Рон","text":"Я тоже буду сторожить. Всю ночь!","vocal":false},{"t":160.386,"dur":3.663,"who":"К101","name":"Барсик","text":"Рон, на у́лице мороз. У тебя нос замёрзнет.","vocal":false},{"t":164.349,"dur":1.346,"who":"К103","name":"Рон","text":"Мой нос храбрый.","vocal":false},{"t":166.044,"dur":1.162,"who":"К103","name":"Рон","text":"Апчхи!","vocal":true},{"t":167.306,"dur":0.915,"who":"К105","name":"Филя","text":"Будь здоров!","vocal":false},{"t":168.521,"dur":4.506,"who":"К103","name":"Рон","text":"Ладно. Носу холодно. Идёмте греться.","vocal":false},{"t":173.327,"dur":1.783,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":173.327,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":173.327,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":176.73,"dur":5.379,"who":"К101","name":"Барсик","text":"Давайте поиграем. Я скажу слово, а вы — твёрдое оно или мягкое.","vocal":false},{"t":182.41,"dur":0.676,"who":"К105","name":"Филя","text":"Давай!","vocal":false},{"t":183.386,"dur":0.915,"who":"К101","name":"Барсик","text":"Подушка!","vocal":false},{"t":186.601,"dur":0.831,"who":"К104","name":"Топа","text":"Мя́гкая!","vocal":false},{"t":187.732,"dur":0.602,"who":"К101","name":"Барсик","text":"Камень!","vocal":false},{"t":190.634,"dur":0.779,"who":"К105","name":"Филя","text":"Твёрдый!","vocal":false},{"t":191.713,"dur":0.951,"who":"К101","name":"Барсик","text":"Вода в миске!","vocal":false},{"t":194.964,"dur":1.288,"who":"К103","name":"Рон","text":"Она плюхает!","vocal":false},{"t":196.552,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":196.552,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":196.552,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":196.552,"dur":1.783,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":198.534,"dur":0.76,"who":"К101","name":"Барсик","text":"Снежок!","vocal":false},{"t":201.594,"dur":0.642,"who":"К102","name":"Пик","text":"Холодный!","vocal":false},{"t":202.537,"dur":0.79,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":203.446,"dur":0.992,"who":"К105","name":"Филя","text":"Это не ответ!","vocal":false},{"t":204.739,"dur":0.477,"who":"К101","name":"Барсик","text":"Лёд!","vocal":false},{"t":207.516,"dur":1.735,"who":"К104","name":"Топа","text":"Твёрдый! И скользкий!","vocal":false},{"t":209.551,"dur":2.711,"who":"К102","name":"Пик","text":"А вода в миске утром, может быть, будет твёрдая.","vocal":false},{"t":212.712,"dur":2.202,"who":"К104","name":"Топа","text":"А-а-а-ах.","vocal":true},{"t":215.014,"dur":3.792,"who":"К104","name":"Топа","text":"А я пойду спать. Утром узнаем.","vocal":false},{"t":220.506,"dur":1.587,"who":"К101","name":"Барсик","text":"Смотри́те, вот миска!","vocal":false},{"t":222.393,"dur":2.675,"who":"К103","name":"Рон","text":"Вода замёрзла! Теперь там лёд!","vocal":false},{"t":225.369,"dur":2.831,"who":"К105","name":"Филя","text":"Можно потрогать? Ой, какой холодный!","vocal":false},{"t":229.1,"dur":2.96,"who":"К103","name":"Рон","text":"Тяжёлая. И холодная!","vocal":false},{"t":232.36,"dur":1.727,"who":"К105","name":"Филя","text":"Переверни её, Рон!","vocal":false},{"t":234.387,"dur":2.788,"who":"К103","name":"Рон","text":"Не выливается! Ни капельки!","vocal":false},{"t":237.475,"dur":2.036,"who":"К102","name":"Пик","text":"Конечно. Он твёрдый. Как камень.","vocal":false},{"t":239.811,"dur":2.758,"who":"К103","name":"Рон","text":"Её не попьёшь! Только грызть!","vocal":false},{"t":242.869,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":242.869,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":242.869,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":242.869,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":244.873,"dur":1.928,"who":"К104","name":"Топа","text":"Мы сделали лёд сами! С морозом.","vocal":false},{"t":247.101,"dur":2.208,"who":"К101","name":"Барсик","text":"А что будет, если лёд принести домой?","vocal":false},{"t":249.609,"dur":2.266,"who":"К105","name":"Филя","text":"В тепло? Пойдёмте проверим!","vocal":false},{"t":254.075,"