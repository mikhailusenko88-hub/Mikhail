{"dur":328.2110472325294,"names":{"К103":"Рон","К102":"Пик","К104":"Топа","К105":"Филя","К101":"Барсик","Р":"Рассказчик"},"speech":[{"t":1.95,"dur":1.608,"who":"К103","name":"Рон","text":"Бульк! Камень утонул!","vocal":false},{"t":3.858,"dur":2.713,"who":"К102","name":"Пик","text":"Смотрите, а вот лодка! Большая — и не тонет!","vocal":false},{"t":6.871,"dur":3.885,"who":"К103","name":"Рон","text":"Нечестно! Маленький камень тонет, а большая лодка плавает!","vocal":false},{"t":11.055,"dur":0.74,"who":"К104","name":"Топа","text":"Почему так?","vocal":false},{"t":12.246,"dur":2.692,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":16.138,"dur":1.534,"who":"К105","name":"Филя","text":"Рон, а зонтик зачем?","vocal":false},{"t":17.971,"dur":3.677,"who":"К103","name":"Рон","text":"Мы раскрываем секрет лодки. Вдруг секрет окажется мокрым!","vocal":false},{"t":21.948,"dur":2.075,"who":"К105","name":"Филя","text":"Даже кепку приготовился защищать?","vocal":false},{"t":24.323,"dur":2.047,"who":"К103","name":"Рон","text":"Конечно. Она плавать не умеет.","vocal":false},{"t":27.17,"dur":3.308,"who":"К103","name":"Рон","text":"Может, лодка училась плавать? А камень прогуливал!","vocal":false},{"t":30.778,"dur":0.96,"who":"К101","name":"Барсик","text":"Ах-ха-ха!","vocal":true},{"t":31.858,"dur":1.441,"who":"К101","name":"Барсик","text":"Тогда кто учил лодку?","vocal":false},{"t":35.199,"dur":1.37,"who":"К103","name":"Рон","text":"Очень терпеливая рыба?","vocal":false},{"t":36.868,"dur":2.574,"who":"К102","name":"Пик","text":"Давайте найдём объяснение, которое можно проверить.","vocal":false},{"t":44.743,"dur":2.143,"who":"К101","name":"Барсик","text":"Вот точно такой же камень, как утонул.","vocal":false},{"t":48.186,"dur":2.944,"who":"К103","name":"Рон","text":"Здравствуйте. Сегодня вопросов будет больше.","vocal":false},{"t":51.43,"dur":2.566,"who":"К105","name":"Филя","text":"Он маленький. Но тяжёлый для своего размера.","vocal":false},{"t":54.296,"dur":1.996,"who":"К104","name":"Топа","text":"А лодка большая. И ещё людей возит.","vocal":false},{"t":56.593,"dur":2.11,"who":"К102","name":"Пик","text":"Значит, одного размера для ответа мало.","vocal":false},{"t":59.502,"dur":1.475,"who":"К101","name":"Барсик","text":"Из чего делают лодки?","vocal":false},{"t":64.277,"dur":0.667,"who":"К104","name":"Топа","text":"Из дерева!","vocal":false},{"t":65.244,"dur":1.896,"who":"К103","name":"Рон","text":"Разгадали! Дерево плавает.","vocal":false},{"t":67.44,"dur":1.655,"who":"К102","name":"Пик","text":"Но бывают и металлические корабли.","vocal":false},{"t":69.445,"dur":0.538,"who":"К103","name":"Рон","text":"Ого!","vocal":true},{"t":70.195,"dur":1.956,"who":"К103","name":"Рон","text":"Металлические? Как ложка?","vocal":false},{"t":72.451,"dur":3.326,"who":"К102","name":"Пик","text":"Да. Обычная металлическая ложка тонет. А корабль может плавать.","vocal":false},{"t":76.076,"dur":1.971,"who":"К105","name":"Филя","text":"Тогда надо искать другую подсказку.","vocal":false},{"t":79.748,"dur":3.942,"who":"Р","name":"Рассказчик","text":"Друзья отправились на кухню сравнить знакомые предметы.","vocal":false},{"t":84.59,"dur":2.485,"who":"К103","name":"Рон","text":"Чем не корабль? Даже длинный хвост есть!","vocal":false},{"t":87.975,"dur":1.526,"who":"К104","name":"Топа","text":"А это похоже на круглую лодку.","vocal":false},{"t":89.801,"dur":2.974,"who":"К105","name":"Филя","text":"У неё есть дно и стенки. А внутри свободное место!","vocal":false},{"t":93.325,"dur":1.71,"who":"К103","name":"Рон","text":"И обед далеко искать не надо.","vocal":false},{"t":95.335,"dur":1.288,"who":"К104","name":"Топа","text":"Ха-ха-ха-ха!","vocal":true},{"t":96.742,"dur":2.642,"who":"К104","name":"Топа","text":"Если туда налить суп, свободного места станет меньше.","vocal":false},{"t":99.684,"dur":3.049,"who":"К102","name":"Пик","text":"Филя заметил важное отличие. Корабль внутри тоже не сплошной.","vocal":false},{"t":103.033,"dur":2.066,"who":"К101","name":"Барсик","text":"Но почему это помогает ему плавать?","vocal":false},{"t":106.399,"dur":0.946,"who":"К105","name":"Филя","text":"Пока не знаю.","vocal":false},{"t":107.645,"dur":2.273,"who":"К102","name":"Пик","text":"У меня есть книга о кораблях. Поищем ответ.","vocal":false},{"t":110.218,"dur":3.166,"who":"К103","name":"Рон","text":"Хорошо. Кастрюля всё равно ничего не рассказывает.","vocal":false},{"t":121.511,"dur":2.678,"who":"К105","name":"Филя","text":"Вода выталкивает погружённые в неё предметы вверх","vocal":false},{"t":124.489,"dur":0.98,"who":"К103","name":"Рон","text":"Даже камень?","vocal":false},{"t":125.768,"dur":1.948,"who":"К102","name":"Пик","text":"Даже камень. Но удержать его не может.","vocal":false},{"t":132.425,"dur":3.668,"who":"К101","name":"Барсик","text":"Корпус корабля делают полым. Внутри остаётся место для воздуха","vocal":false},{"t":136.393,"dur":2.581,"who":"К104","name":"Топа","text":"Значит, большой корабль не набит металлом целиком!","vocal":false},{"t":139.273,"dur":2.663,"who":"К102","name":"Пик","text":"Да. Он занимает много места в воде и раздвигает её.","vocal":false},{"t":142.236,"dur":1.628,"who":"К101","name":"Барсик","text":"А вода толкает корабль вверх.","vocal":false},{"t":144.164,"dur":1.405,"who":"К105","name":"Филя","text":"И удерживает весь его вес?","vocal":false},{"t":145.869,"dur":3.416,"who":"К101","name":"Барсик","text":"Верно. Если корабль не слишком тяжёлый для своего размера.","vocal":false},{"t":149.584,"dur":2.993,"who":"К103","name":"Рон","text":"Теперь понятно, зачем ему столько места внутри!","vocal":false},{"t":154.778,"dur":2.465,"who":"К104","name":"Топа","text":"Тогда в корабль можно складывать сколько угодно вещей?","vocal":false},{"t":158.543,"dur":1.454,"who":"К105","name":"Филя","text":"Каждая вещь добавляет вес.","vocal":false},{"t":160.297,"dur":2.622,"who":"К102","name":"Пик","text":"Верно. Если перегрузить корабль, он может утонуть.","vocal":false},{"t":163.219,"dur":1.931,"who":"К103","name":"Рон","text":"Даже если вещи очень нужные?","vocal":false},{"t":165.45,"dur":0.799,"who":"К101","name":"Барсик","text":"Даже тогда.","vocal":false},{"t":166.549,"dur":2.352,"who":"К103","name":"Рон","text":"Придётся оставить коллекцию камней дома.","vocal":false},{"t":169.201,"dur":1.728,"who":"К104","name":"Топа","text":"А если внутрь попадёт много воды?","vocal":false},{"t":171.23,"dur":1.688,"who":"К105","name":"Филя","text":"Корабль тоже станет тяжелее!","vocal":false},{"t":173.217,"dur":2.12,"who":"К102","name":"Пик","text":"Поэтому важно, чтобы корпус был целым.","vocal":false},{"t":177.237,"dur":2.833,"who":"К103","name":"Рон","text":"Снаружи вода помогает. А внутри может мешать.","vocal":false},{"t":181.27,"dur":3.367,"who":"К105","name":"Филя","text":"Кажется, я придумал, как проверить, что мы поняли.","vocal":false},{"t":184.938,"dur":0.791,"who":"К104","name":"Топа","text":"Проведёшь игру?","vocal":false},{"t":186.028,"dur":0.765,"who":"К105","name":"Филя","text":"Попробую.","vocal":false},{"t":189.094,"dur":1.346,"who":"К103","name":"Рон","text":"У нас будет капитан!","vocal":false},{"t":192.034,"dur":1.467,"who":"К104","name":"Топа","text":"Капитан Мишка готов слушать.","vocal":false},{"t":193.802,"dur":4.743,"who":"К105","name":"Филя","text":"Я буду говорить. Если согласны — кивните. Если нет — покачайте головой.","vocal":false},{"t":198.845,"dur":0.743,"who":"К101","name":"Барсик","text":"Начинай!","vocal":false},{"t":199.888,"dur":1.992,"who":"К105","name":"Филя","text":"Маленький предмет обязательно плавает.","vocal":false},{"t":206.18,"dur":2.229,"who":"К103","name":"Рон","text":"Нет. Маленький камень может утонуть.","vocal":false},{"t":209.609,"dur":1.039,"who":"К104","name":"Топа","text":"Капитан согласен!","vocal":false},{"t":210.948,"dur":2.517,"who":"К105","name":"Филя","text":"Вода толкает вверх только деревянные предметы.","vocal":false},{"t":217.764,"dur":1.526,"who":"К102","name":"Пик","text":"Нет. Металлические тоже.","vocal":false},{"t":219.59,"dur":2.045,"who":"К103","name":"Рон","text":"Просто ложку удержать не получается.","vocal":false},{"t":222.085,"dur":0.59,"who":"К105","name":"Филя","text":"Ура-а!","vocal":true},{"t":223.735,"dur":2.295,"who":"К105","name":"Филя","text":"Правильно! А теперь самый хитрый вопрос.","vocal":false},{"t":227.731,"dur":2.911,"who":"К105","name":"Филя","text":"Если в лодке есть воздух, она никогда не утонет.","vocal":false},{"t":234.842,"dur":1.857,"who":"К103","name":"Рон","text":"Есть воздух — можно плыть!","vocal":false},{"t":238.249,"dur":1.953,"who":"К103","name":"Рон","text":"Стойте. Я что-то забыл.","vocal":false},{"t":240.502,"dur":2.678,"who":"К105","name":"Филя","text":"А если положить туда всю твою коллекцию камней?","vocal":false},{"t":245.08,"dur":1.934,"who":"К103","name":"Рон","text":"Она станет слишком тяжёлой!","vocal":false},{"t":247.315,"dur":4.189,"who":"К105","name":"Филя","text":"Да. Лодку поддерживает вода. Но слишком тяжёлую лодку она не удержит.","vocal":false},{"t":252.804,"dur":2.804,"who":"К103","name":"Рон","text":"Тогда меняю ответ. Лодку нельзя перегружать.","vocal":false},{"t":255.907,"dur":1.268,"who":"К104","name":"Топа","text":"Капитан Мишка доволен!","vocal":false},{"t":257.476,"dur":1.756,"who":"К101","name":"Барсик","text":"Филя, ты придумал хороший вопрос.","vocal":false},{"t":259.531,"dur":1.552,"who":"К105","name":"Филя","text":"Я боялся запутаться.","vocal":false},{"t":261.384,"dur":1.53,"who":"К103","name":"Рон","text":"А помог разобраться мне!","vocal":false},{"t":266.505,"dur":2.201,"who":"К104","name":"Топа","text":"Держи. Капитан хочет тебя поблагодарить.","vocal":false},{"t":270.006,"dur":1.936,"who":"К105","name":"Филя","text":"Спасибо за службу, капитан!","vocal":false},{"t":272.243,"dur":2.868,"who":"К103","name":"Рон","text":"Теперь ему положен отпуск. На сухой подушке!","vocal":false},{"t":275.41,"dur":2.692,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":275.41,"dur":1.587,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":275.41,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":275.41,"dur":2.748,"who":"К104","name":"Топа","text":"Ха-ха-ха-ха!","vocal":true},{"t":275.41,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":280.778,"dur":2.851,"who":"К103","name":"Рон","text":"Секрет раскрыли. И даже кепку не намочили!","vocal":false},{"t":283.929,"dur":2.056,"who":"К101","name":"Барсик","text":"А дома вас ждёт ещё одна загадка.","vocal":false},{"t":286.285,"dur":1.752,"who":"К103","name":"Рон","text":"Надеюсь, тоже сухая!","vocal":false},{"t":289.736,"dur":3.096,"who":"Р","name":"Рассказчик","text":"Дома Барсик приготовил новую загадку.","vocal":false},{"t":294.232,"dur":2.728,"who":"К101","name":"Барсик","text":"Кто повторяет твои движения, но живёт в стекле?","vocal":false},{"t":300.26,"dur":2.004,"who":"К103","name":"Рон","text":"Тень? Мы с ней уже знакомы!","vocal":false},{"t":302.564,"dur":1.273,"who":"К105","name":"Филя","text":"Тень в стекле не живёт.","vocal":false},{"t":305.453,"dur":1.176,"who":"К103","name":"Рон","text":"О, это я!","vocal":false},{"t":306.929,"dur":0.535,"who":"К102","name":"Пик","text":"Узнал?","vocal":false},{"t":307.764,"dur":2.937,"who":"К103","name":"Рон","text":"Да. Но почему отражение всё за мной повторяет?","vocal":false},{"t":311.001,"dur":1.682,"who":"К104","name":"Топа","text":"Даже когда ты ничего не просишь?","vocal":false},{"t":312.982,"dur":1.149,"who":"К103","name":"Рон","text":"Особенно тогда!","vocal":false},{"t":314.431,"dur":1.974,"who":"К101","name":"Барсик","text":"Завтра раскроем секрет зеркальца.","vocal":false},{"t":316.705,"dur":3.13,"who":"К103","name":"Рон","text":"Тогда завтра причешусь. Нас там всё-таки двое!","vocal":false},{"t":321.735,"dur":4.876,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","lo