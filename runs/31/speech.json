{"dur":352.3969264455782,"names":{"К103":"Рон","К105":"Филя","К104":"Топа","К101":"Барсик","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":1.972,"who":"К103","name":"Рон","text":"Смотрите! Вот моя лужа!","vocal":false},{"t":3.422,"dur":1.986,"who":"К103","name":"Рон","text":"Ой. Проверил. Мокрая.","vocal":false},{"t":5.857,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":7.841,"dur":4.404,"who":"К103","name":"Рон","text":"Я её сторожу. Вчера у крыльца тоже была лужа. А утром — сухо!","vocal":false},{"t":12.544,"dur":1.743,"who":"К104","name":"Топа","text":"Совсем ничего не осталось?","vocal":false},{"t":16.987,"dur":2.601,"who":"К103","name":"Рон","text":"Ни капельки. Даже записки не оставила.","vocal":false},{"t":19.888,"dur":2.177,"who":"К103","name":"Рон","text":"Я составил список подозреваемых.","vocal":false},{"t":22.365,"dur":0.789,"who":"К101","name":"Барсик","text":"И кто в нём?","vocal":false},{"t":23.455,"dur":3.277,"who":"К103","name":"Рон","text":"Голодный голубь. Слон из зоопарка. И кот Барсик.","vocal":false},{"t":27.032,"dur":0.96,"who":"К101","name":"Барсик","text":"Ах-ха-ха!","vocal":true},{"t":28.112,"dur":1.347,"who":"К101","name":"Барсик","text":"Я пью только из чашки!","vocal":false},{"t":29.759,"dur":1.015,"who":"К103","name":"Рон","text":"Так все говорят.","vocal":false},{"t":31.074,"dur":2.351,"who":"К102","name":"Пик","text":"Давайте лучше проверим. Измерим лужу шагами.","vocal":false},{"t":33.725,"dur":0.962,"who":"К103","name":"Рон","text":"Я измерю!","vocal":false},{"t":35.287,"dur":3.294,"who":"К103","name":"Рон","text":"Раз, два, три, четыре! Четыре шага!","vocal":false},{"t":38.881,"dur":1.814,"who":"К101","name":"Барсик","text":"Вернёмся через час и посмотрим.","vocal":false},{"t":45.395,"dur":3.111,"who":"К104","name":"Топа","text":"Здесь вчера тоже шёл дождь. А луж нет.","vocal":false},{"t":48.806,"dur":1.978,"who":"К105","name":"Филя","text":"Может, их тоже кто-то выпил?","vocal":false},{"t":53.484,"dur":1.96,"who":"К103","name":"Рон","text":"Подозреваемых становится больше.","vocal":false},{"t":56.244,"dur":1.188,"who":"К104","name":"Топа","text":"Земля мокрая!","vocal":false},{"t":57.733,"dur":2.84,"who":"К102","name":"Пик","text":"Вода ушла в землю. Земля впитывает её, как губка.","vocal":false},{"t":60.872,"dur":2.316,"who":"К103","name":"Рон","text":"Значит, на лугу лужи выпила земля!","vocal":false},{"t":63.488,"dur":4.775,"who":"К101","name":"Барсик","text":"На лугу — да. А на улице асфальт. Он воду не пропускает.","vocal":false},{"t":68.563,"dur":2.857,"who":"К105","name":"Филя","text":"Тогда куда девается вода из лужи на асфальте?","vocal":false},{"t":72.32,"dur":1.921,"who":"К104","name":"Топа","text":"И жёлудю тоже досталась вода?","vocal":false},{"t":74.542,"dur":2.07,"who":"К102","name":"Пик","text":"Досталась. Почва возле него влажная.","vocal":false},{"t":76.912,"dur":1.269,"who":"К105","name":"Филя","text":"Запишу в дневник.","vocal":false},{"t":81.481,"dur":3.675,"who":"К105","name":"Филя","text":"Дождь. Земля мокрая. Жёлудь получил воду","vocal":false},{"t":86.856,"dur":3.232,"who":"К103","name":"Рон","text":"Смотрите! Вот маленькая лужа! Она похудела!","vocal":false},{"t":92.438,"dur":2.323,"who":"К103","name":"Рон","text":"Раз, два! Всего два шага!","vocal":false},{"t":95.062,"dur":1.624,"who":"К104","name":"Топа","text":"А утром было четыре!","vocal":false},{"t":96.985,"dur":2.232,"who":"К103","name":"Рон","text":"Наверное, лужа бегает по утрам.","vocal":false},{"t":99.667,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":101.63,"dur":2.277,"who":"К102","name":"Пик","text":"Вода отступила от края. Лужа стала меньше.","vocal":false},{"t":104.207,"dur":1.721,"who":"К101","name":"Барсик","text":"А по краям асфальт уже сухой.","vocal":false},{"t":106.228,"dur":2.385,"who":"К103","name":"Рон","text":"Я с неё глаз не сводил. Почти.","vocal":false},{"t":108.913,"dur":0.662,"who":"К105","name":"Филя","text":"Почти?","vocal":false},{"t":109.875,"dur":1.941,"who":"К103","name":"Рон","text":"Один раз отвлёкся на бабочку.","vocal":false},{"t":112.116,"dur":2.502,"who":"К102","name":"Пик","text":"Посмотрите на небо. Солнце светит прямо на лужу.","vocal":false},{"t":114.918,"dur":2.024,"who":"К103","name":"Рон","text":"Солнце пьёт лужу через соломинку?","vocal":false},{"t":117.242,"dur":0.74,"who":"К101","name":"Барсик","text":"Ха-ха!","vocal":true},{"t":118.102,"dur":1.407,"who":"К101","name":"Барсик","text":"Почти угадал, Рон.","vocal":false},{"t":119.809,"dur":1.77,"who":"К102","name":"Пик","text":"Солнце не пьёт. Оно греет воду.","vocal":false},{"t":121.879,"dur":2.977,"who":"К102","name":"Пик","text":"Тёплая вода понемногу превращается в пар. Пар улетает в воздух.","vocal":false},{"t":125.155,"dur":1.537,"who":"К104","name":"Топа","text":"А почему мы его не видим?","vocal":false},{"t":126.992,"dur":3.707,"who":"К102","name":"Пик","text":"Этот пар невидимый. Вода улетает крошечными частичками — их не разглядеть.","vocal":false},{"t":130.999,"dur":2.224,"who":"К103","name":"Рон","text":"Невидимая вода? Вот это хитрость!","vocal":false},{"t":133.523,"dur":2.735,"who":"К103","name":"Рон","text":"Тогда я помогу ей улететь. Я буду ветром!","vocal":false},{"t":138.758,"dur":0.622,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":139.5,"dur":2.042,"who":"К102","name":"Пик","text":"Рон, так ты сам высохнешь быстрее лужи!","vocal":false},{"t":141.842,"dur":1.133,"who":"К103","name":"Рон","text":"Я и не намокал.","vocal":false},{"t":143.275,"dur":2.39,"who":"К105","name":"Филя","text":"А можно увидеть пар по-настоящему?","vocal":false},{"t":145.964,"dur":2.824,"who":"К101","name":"Барсик","text":"Можно. Пойдёмте домой, я покажу.","vocal":false},{"t":150.488,"dur":2.529,"who":"Р","name":"Рассказчик","text":"Дома Барсик поставил чайник.","vocal":false},{"t":153.917,"dur":1.724,"who":"Р","name":"Рассказчик","text":"Барсик налил чаю.","vocal":false},{"t":155.941,"dur":3.064,"who":"К101","name":"Барсик","text":"Смотрите над чашкой. Белое облачко — это пар.","vocal":false},{"t":159.305,"dur":1.56,"who":"К104","name":"Топа","text":"Оно поднимается вверх!","vocal":false},{"t":161.165,"dur":3.317,"who":"К102","name":"Пик","text":"Горячая вода превращается в пар быстро. А на солнце — медленно.","vocal":false},{"t":165.381,"dur":3.647,"who":"К103","name":"Рон","text":"Сейчас я его поймаю! Подержу холодную ложку над чашкой.","vocal":false},{"t":171.329,"dur":1.633,"who":"К103","name":"Рон","text":"Ой! На ложке капельки!","vocal":false},{"t":173.261,"dur":2.29,"who":"К102","name":"Пик","text":"Пар коснулся холодной ложки и снова стал водой.","vocal":false},{"t":175.851,"dur":2.677,"who":"К105","name":"Филя","text":"Значит, вода может улететь — и вернуться?","vocal":false},{"t":178.829,"dur":3.166,"who":"К101","name":"Барсик","text":"Может. Запомните это. Нам ещё пригодится.","vocal":false},{"t":182.795,"dur":2.059,"who":"К103","name":"Рон","text":"Поймал пар. Но он сразу намок.","vocal":false},{"t":185.304,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха-ха!","vocal":true},{"t":188.354,"dur":3.111,"who":"К105","name":"Филя","text":"Давайте проверим, где вода улетает быстрее.","vocal":false},{"t":192.365,"dur":2.144,"who":"К105","name":"Филя","text":"Нальём немного воды в тарелку.","vocal":false},{"t":195.409,"dur":1.493,"who":"К104","name":"Топа","text":"И столько же — в чашку.","vocal":false},{"t":197.202,"dur":1.984,"who":"К102","name":"Пик","text":"Тарелка широкая. А чашка узкая.","vocal":false},{"t":199.485,"dur":3.163,"who":"К103","name":"Рон","text":"Спорим, тарелка проиграет? Она же плоская!","vocal":false},{"t":202.949,"dur":2.713,"who":"К101","name":"Барсик","text":"Поставим обе на солнечное окно и посмотрим завтра.","vocal":false},{"t":206.962,"dur":1.199,"who":"К103","name":"Рон","text":"Я буду сторожить.","vocal":false},{"t":208.461,"dur":0.645,"who":"К105","name":"Филя","text":"Опять?","vocal":false},{"t":209.407,"dur":1.757,"who":"К103","name":"Рон","text":"Я теперь опытный сторож луж.","vocal":false},{"t":212.864,"dur":1.061,"who":"К103","name":"Рон","text":"Лужа высохла!","vocal":false},{"t":216.275,"dur":1.918,"who":"К103","name":"Рон","text":"Ноль шагов! Мерить нечего.","vocal":false},{"t":218.493,"dur":3.872,"who":"К103","name":"Рон","text":"Подозреваемых отпускаем. Голубь, слон и Барсик свободны!","vocal":false},{"t":222.665,"dur":0.74,"who":"К101","name":"Барсик","text":"Ха-ха!","vocal":true},{"t":223.525,"dur":1.71,"who":"К101","name":"Барсик","text":"Спасибо, господин сыщик.","vocal":false},{"t":225.535,"dur":2.02,"who":"К102","name":"Пик","text":"Днём было солнце. И ещё дул ветер.","vocal":false},{"t":227.855,"dur":1.104,"who":"К105","name":"Филя","text":"А ветер зачем?","vocal":false},{"t":229.259,"dur":3.005,"who":"К102","name":"Пик","text":"Ветер уносит пар от лужи. Тогда вода улетает ещё быстрее.","vocal":false},{"t":232.564,"dur":2.064,"who":"К104","name":"Топа","text":"Как когда сушат бельё на ветру?","vocal":false},{"t":234.928,"dur":2.241,"who":"К102","name":"Пик","text":"Да. Бельё сохнет так же, как лужа.","vocal":false},{"t":237.469,"dur":2.577,"who":"К103","name":"Рон","text":"Теперь я понял, куда делась вчерашняя лужа.","vocal":false},{"t":240.346,"dur":0.527,"who":"К101","name":"Барсик","text":"Куда?","vocal":false},{"t":241.172,"dur":2.251,"who":"К103","name":"Рон","text":"Улетела в небо. Без разрешения!","vocal":false},{"t":243.723,"dur":1.587,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":243.723,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":243.723,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":243.723,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":243.723,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":247.137,"dur":3.386,"who":"К105","name":"Филя","text":"Давайте поиграем! Я спрашиваю, а вы отвечаете.","vocal":false},{"t":250.823,"dur":0.743,"who":"К101","name":"Барсик","text":"Начинай!","vocal":false},{"t":251.865,"dur":3.685,"who":"К105","name":"Филя","text":"Где лужа высохнет быстрее: на солнце или в тени?","vocal":false},{"t":258.851,"dur":2.06,"who":"К104","name":"Топа","text":"На солнце! Солнце греет воду.","vocal":false},{"t":261.211,"dur":3.399,"who":"К105","name":"Филя","text":"Правильно! А где быстрее: в тихий день или на ветру?","vocal":false},{"t":267.91,"dur":1.628,"who":"К102","name":"Пик","text":"На ветру. Ветер уносит пар.","vocal":false},{"t":269.838,"dur":1.965,"who":"К105","name":"Филя","text":"А лужа на лугу куда девается?","vocal":false},{"t":275.103,"dur":1.364,"who":"К103","name":"Рон","text":"Её выпивает земля!","vocal":false},{"t":276.767,"dur":0.638,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":277.525,"dur":1.278,"who":"К102","name":"Пик","text":"Вода впитывается в землю.","vocal":false},{"t":279.103,"dur":2.308,"who":"К103","name":"Рон","text":"Я так и сказал. Только вкуснее.","vocal":false},{"t":281.711,"dur":1.132,"who":"К105","name":"Филя","text":"Все ответили!","vocal":false},{"t":283.143,"dur":1.624,"who":"К101","name":"Барсик","text":"Филя, ты здорово ведёшь игру.","vocal":false},{"t":286.467,"dur":3.304,"who":"Р","name":"Рассказчик","text":"Утром друзья проверили тарелку и чашку.","vocal":false},{"t":290.671,"dur":1.389,"who":"К104","name":"Топа","text":"Тарелка сухая!","vocal":false},{"t":292.961,"dur":1.939,"who":"К105","name":"Филя","text":"А в чашке вода ещё осталась.","vocal":false},{"t":295.2,"dur":1.592,"who":"К103","name":"Рон","text":"Плоская тарелка победила!","vocal":false},{"t":297.092,"dur":3.143,"who":"К102","name":"Пик","text":"У тарелки вода широкая. Её большая часть касается воздуха.","vocal":false},{"t":300.535,"dur":2.381,"who":"К101","name":"Барсик","text":"Поэтому вода из тарелки улетела быстрее.","vocal":false},{"t":303.216,"dur":3.224,"who":"К104","name":"Топа","text":"Значит, широкая мелкая лужа сохнет быстро.","vocal":false},{"t":306.74,"dur":1.694,"who":"К105","name":"Филя","text":"А глубокая — медленно.","vocal":false},{"t":308.733,"dur":3.17,"who":"К103","name":"Рон","text":"Запомню. Глубокие лужи — самые терпеливые.","vocal":false},{"t":316.004,"dur":2.431,"who":"К104","name":"Топа","text":"Смотрите, что я нашёл! Компас!","vocal":false},{"t":319.335,"dur":0.975,"who":"К103","name":"Рон","text":"А что он умеет?","vocal":false},{"t":320.61,"dur":1.885,"who":"К104","name":"Топа","text":"Стрелка показывает вот туда.","vocal":false},{"t":323.044,"dur":0.693,"who":"К103","name":"Рон","text":"А теперь?","vocal":false},{"t":324.037,"dur":1.155,"who":"К104","name":"Топа","text":"Всё равно туда!","vocal":false},{"t":326.292,"dur":0.719,"who":"К103","name":"Рон","text":"А сейчас?","vocal":false},{"t":327.311,"dur":0.831,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":328.262,"dur":0.865,"who":"К104","name":"Топа","text":"Опять туда!","vocal":false},{"t":329.427,"dur":1.582,"who":"К103","name":"Рон","text":"Какая упрямая стрелка!","vocal":false},{"t":331.309,"dur":5.023,"who":"К105","name":"Филя","text":"Помните загадку? Что помогает найти дорогу, хотя само никуда не идёт?","vocal":false},{"t":336.631,"dur":0.732,"who":"К102","name":"Пик","text":"Это компас!","vocal":false},{"t":337.664,"dur":3.206,"who":"К101","name":"Барсик","text":"Завтра узнаем, почему стрелка всегда смотрит в одну сторону.","vocal":false},{"t":341.169,"dur":2.852,"who":"К103","name":"Рон","text":"Может, ей там просто что-то очень нравится?","vocal":false},{"t":345.921,"dur":4.876,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"улица, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"street\",\"weather\":\"none\"}"},{"t0":41.795,"kind":"title","loc":""},{"t0":44.795,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"луг, утро\",\"seed\":102,\"time\":\"day\",\"type\":\"meadow\",\"weather\":\"none\"}"},{"t0":86.256,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"улица, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"street\",\"weather\":\"none\"}"},{"t0":149.888,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"кухня, день\",\"seed\":103,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":187.754,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"кухня, день\",\"seed\":103,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":212.264,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"улица, вечер\",\"seed\":104,\"time\":\"evening\",\"type\":\"street\",\"weather\":\"none\"}"},{"t0":246.537,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"комната, вечер\",\"seed\":105,\"time\":\"evening\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":285.867,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"кухня, день\",\"seed\":103,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":314.004,"kind":"scene","loc":"{\"id\":\"Л106\",\"name\":\"комната, утро\",\"seed\":106,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":345.121,"kind":"end","loc":""}]}