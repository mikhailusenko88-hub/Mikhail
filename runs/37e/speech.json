а, вечер\",\"seed\":104,\"snowOut\":true,\"time\":\"evening\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":217.745,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"noSnowman\":true,\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":250.893,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"кухня, день\",\"seed\":102,\"snowOut\":true,\"time\":\"day\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":270.437,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"кухня, вечер\",\"seed\":105,\"snowOut\":true,\"time\":\"evening\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":293.987,"kind":"scene","loc":"{\"id\":\"Л106\",\"name\":\"комната, ночь\",\"seed\":106,\"snowOut\":true,\"time\":\"night\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":328.157,"kind":"end","loc":""}]}