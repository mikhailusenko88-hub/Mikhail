{"dur":360.20161394557823,"names":{"К103":"Рон","К105":"Филя","К104":"Топа","К101":"Барсик","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":2.254,"who":"К103","name":"Рон","text":"Ой! Снег! Где наш росток?","vocal":false},{"t":6.004,"dur":3.979,"who":"К103","name":"Рон","text":"Нашёл! Смотрите! Вот наш росток!","vocal":false},{"t":10.283,"dur":2.939,"who":"К105","name":"Филя","text":"Он зелёный! Сидел под снегом и не замёрз!","vocal":false},{"t":14.022,"dur":3.041,"who":"К104","name":"Топа","text":"Ночью был мороз. А ему хоть бы что!","vocal":false},{"t":17.363,"dur":2.534,"who":"К101","name":"Барсик","text":"Как же он не замёрз? Ему же холодно!","vocal":false},{"t":20.697,"dur":3.045,"who":"Р","name":"Рассказчик","text":"Рон достал из рюкзака красную подушку.","vocal":false},{"t":24.042,"dur":4.046,"who":"К103","name":"Рон","text":"Держись, малыш! Вот тебе подушка. Мягкая!","vocal":false},{"t":29.038,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":31.021,"dur":0.622,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":31.763,"dur":1.752,"who":"К102","name":"Пик","text":"Рон, у него есть своё одеяло.","vocal":false},{"t":33.815,"dur":3.128,"who":"К103","name":"Рон","text":"Где? Я ничего не вижу.","vocal":false},{"t":37.243,"dur":1.103,"who":"К102","name":"Пик","text":"Вот оно. Снег!","vocal":false},{"t":38.646,"dur":2.411,"who":"К103","name":"Рон","text":"Снег? Но снег холодный!","vocal":false},{"t":41.357,"dur":1.49,"who":"К104","name":"Топа","text":"И он совсем целый!","vocal":false},{"t":43.146,"dur":4.17,"who":"К101","name":"Барсик","text":"Вот это загадка. Холодный снег, а под ним росток не мёрзнет.","vocal":false},{"t":47.616,"dur":2.115,"who":"К105","name":"Филя","text":"Может, снег не такой уж холодный?","vocal":false},{"t":50.181,"dur":2.209,"who":"К104","name":"Топа","text":"А-а-а-ах.","vocal":true},{"t":56.891,"dur":2.548,"who":"К105","name":"Филя","text":"Топа, ты зеваешь уже десятый раз!","vocal":false},{"t":59.738,"dur":5.293,"who":"К104","name":"Топа","text":"Не знаю почему. Зимой мне всё время хочется спать.","vocal":false},{"t":65.332,"dur":2.903,"who":"К102","name":"Пик","text":"Это потому, что ты медвежонок. Медведи спят всю зиму!","vocal":false},{"t":68.535,"dur":3.393,"who":"К103","name":"Рон","text":"Всю зиму? А как же завтрак?","vocal":false},{"t":72.228,"dur":4.116,"who":"К104","name":"Топа","text":"Осенью медведи много едят. А потом спят и не голодают.","vocal":false},{"t":76.644,"dur":2.081,"who":"К105","name":"Филя","text":"Как жёлудь! Запас еды на потом!","vocal":false},{"t":79.625,"dur":3.77,"who":"К103","name":"Рон","text":"Тогда мне тоже нужен запас. Начну прямо сейчас.","vocal":false},{"t":85.895,"dur":5.085,"who":"К103","name":"Рон","text":"Всё! Запас готов. Я тоже буду спать всю зиму!","vocal":false},{"t":91.88,"dur":1.44,"who":"К103","name":"Рон","text":"Спокойной ночи!","vocal":false},{"t":95.22,"dur":4.261,"who":"К103","name":"Рон","text":"Всё! Я выспался! Можно завтракать?","vocal":false},{"t":99.781,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":100.743,"dur":2.092,"who":"К104","name":"Топа","text":"Рон, прошла одна минутка!","vocal":false},{"t":103.135,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":103.135,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":103.135,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":103.135,"dur":1.783,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":105.149,"dur":1.306,"who":"К101","name":"Барсик","text":"А где медведи спят?","vocal":false},{"t":106.755,"dur":5.276,"who":"К104","name":"Топа","text":"В берлоге. Это ямка под ёлкой. Сверху её засыпает снег.","vocal":false},{"t":112.331,"dur":3.58,"who":"К104","name":"Топа","text":"В берлоге тепло, даже когда снаружи сильный мороз.","vocal":false},{"t":116.211,"dur":1.367,"who":"К105","name":"Филя","text":"Опять снег греет?","vocal":false},{"t":117.879,"dur":4.878,"who":"К101","name":"Барсик","text":"Снег сам не греет. Он как шарф. Шарф не печка, а нам в нём тепло.","vocal":false},{"t":123.056,"dur":2.654,"who":"К105","name":"Филя","text":"Потому что шарф не выпускает наше тепло?","vocal":false},{"t":126.011,"dur":5.697,"who":"К101","name":"Барсик","text":"Да! В снегу много воздуха. И он бережёт тепло земли. Как пушистое одеяло.","vocal":false},{"t":132.008,"dur":3.707,"who":"К103","name":"Рон","text":"Значит, росток спит под одеялом. Как Топа!","vocal":false},{"t":136.815,"dur":2.37,"who":"К105","name":"Филя","text":"Тише. Топа уже спит.","vocal":false},{"t":140.885,"dur":2.688,"who":"К101","name":"Барсик","text":"Смотрите, ёлки зелёные! Зимой!","vocal":false},{"t":143.873,"dur":3.013,"who":"К102","name":"Пик","text":"У ёлки иголки. Тонкие и крепкие. Им мороз не страшен.","vocal":false},{"t":147.786,"dur":3.335,"who":"К105","name":"Филя","text":"А вот листик дуба. Он сухой и коричневый.","vocal":false},{"t":151.42,"dur":3.829,"who":"К101","name":"Барсик","text":"Осенью дуб сбрасывает листья. И засыпает до весны.","vocal":false},{"t":155.549,"dur":1.274,"who":"К103","name":"Рон","text":"Дуб тоже медведь?","vocal":false},{"t":157.123,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":157.123,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":157.123,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":157.123,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":159.137,"dur":0.638,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":159.895,"dur":1.784,"who":"К102","name":"Пик","text":"Нет. Но спит он, как медведь.","vocal":false},{"t":162.579,"dur":2.383,"who":"К104","name":"Топа","text":"Смотрите! Жёлудь! Прямо под снегом!","vocal":false},{"t":165.261,"dur":1.646,"who":"К102","name":"Пик","text":"Он тоже спит. Как наш росток.","vocal":false},{"t":167.207,"dur":3.509,"who":"К101","name":"Барсик","text":"А весной снег растает. И жёлудь проснётся.","vocal":false},{"t":171.016,"dur":1.221,"who":"К103","name":"Рон","text":"Так долго ждать?","vocal":false},{"t":172.537,"dur":2.398,"who":"К105","name":"Филя","text":"Ничего. Мы подождём вместе.","vocal":false},{"t":175.235,"dur":2.27,"who":"К105","name":"Филя","text":"А давайте пока в прятки! Рон водит!","vocal":false},{"t":178.306,"dur":2.649,"who":"К103","name":"Рон","text":"Раз, два, три! Иду искать!","vocal":false},{"t":183.655,"dur":2.5,"who":"К103","name":"Рон","text":"Где Филя? Тут только снег!","vocal":false},{"t":186.604,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":188.598,"dur":3.357,"who":"К103","name":"Рон","text":"Ой! Филя! Ты белый, как снег!","vocal":false},{"t":192.255,"dur":3.21,"who":"К101","name":"Барсик","text":"Зайцы к зиме становятся белыми. На снегу их не видно.","vocal":false},{"t":195.765,"dur":3.414,"who":"К105","name":"Филя","text":"А я белый всегда. Я готов к зиме заранее!","vocal":false},{"t":199.479,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":199.479,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":199.479,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":199.479,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":199.479,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":202.893,"dur":3.669,"who":"К103","name":"Рон","text":"Я придумал! Росток будет охранять снежный сторож!","vocal":false},{"t":207.362,"dur":5.34,"who":"К103","name":"Рон","text":"Готово! Вот он, снежный сторож! Он не мёрзнет и никогда не спит!","vocal":false},{"t":213.001,"dur":1.13,"who":"К104","name":"Топа","text":"Повезло ему.","vocal":false},{"t":214.582,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":217.176,"dur":1.222,"who":"К101","name":"Барсик","text":"А ну, кто поймает?","vocal":false},{"t":219.797,"dur":3.365,"who":"К103","name":"Рон","text":"Поймал! Я быстрый сторож!","vocal":false},{"t":224.562,"dur":0.646,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":225.329,"dur":0.445,"who":"К102","name":"Пик","text":"Мимо!","vocal":false},{"t":226.074,"dur":1.96,"who":"К103","name":"Рон","text":"Это я ему показал, как надо.","vocal":false},{"t":232.134,"dur":4.262,"who":"К104","name":"Топа","text":"Тёплое молоко. И сразу хочется спать.","vocal":false},{"t":236.696,"dur":3.427,"who":"К101","name":"Барсик","text":"Нам тепло в доме. А ростку тепло под снегом.","vocal":false},{"t":240.423,"dur":3.122,"who":"К103","name":"Рон","text":"А наш снежный сторож? Ему тоже тепло?","vocal":false},{"t":243.845,"dur":1.814,"who":"К102","name":"Пик","text":"Ему нельзя греться. Он растает.","vocal":false},{"t":245.958,"dur":3.1,"who":"К103","name":"Рон","text":"Тогда пусть ему будет холодно! Самую чуточку.","vocal":false},{"t":249.508,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":252.892,"dur":3.386,"who":"К105","name":"Филя","text":"Давайте поиграем! Я спрашиваю, а вы отвечаете.","vocal":false},{"t":256.578,"dur":0.743,"who":"К101","name":"Барсик","text":"Начинай!","vocal":false},{"t":257.62,"dur":2.245,"who":"К105","name":"Филя","text":"Почему росток под снегом не замёрз?","vocal":false},{"t":263.166,"dur":1.773,"who":"К102","name":"Пик","text":"Снег укрыл его, как одеяло.","vocal":false},{"t":265.238,"dur":1.986,"who":"К105","name":"Филя","text":"Правильно! А кто спит всю зиму?","vocal":false},{"t":270.525,"dur":2.275,"who":"К104","name":"Топа","text":"Медведи. И я.","vocal":false},{"t":273.1,"dur":2.055,"who":"К105","name":"Филя","text":"А почему ёлка зимой зелёная?","vocal":false},{"t":278.455,"dur":2.452,"who":"К101","name":"Барсик","text":"У неё иголки. Им мороз не страшен.","vocal":false},{"t":281.207,"dur":1.693,"who":"К103","name":"Рон","text":"А кто никогда не спит?","vocal":false},{"t":283.2,"dur":0.517,"who":"К105","name":"Филя","text":"Кто?","vocal":false},{"t":284.017,"dur":3.842,"who":"К103","name":"Рон","text":"Снежный сторож! И я! Почти.","vocal":false},{"t":288.159,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":288.159,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":288.159,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":288.159,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":288.159,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":292.173,"dur":3.05,"who":"К103","name":"Рон","text":"Вот наш росток. Спит под одеялом.","vocal":false},{"t":295.523,"dur":1.994,"who":"К101","name":"Барсик","text":"А вот и снеговик. Сторожит.","vocal":false},{"t":297.817,"dur":3.714,"who":"К103","name":"Рон","text":"Мы с ним вдвоём. Я и мой помощник.","vocal":false},{"t":302.581,"dur":1.579,"who":"К103","name":"Рон","text":"А-а-а-ах.","vocal":true},{"t":304.431,"dur":1.716,"who":"К103","name":"Рон","text":"Сторож, ты точно не спишь?","vocal":false},{"t":306.447,"dur":2.819,"who":"К105","name":"Филя","text":"Он молчит. Значит, сторожит.","vocal":false},{"t":309.566,"dur":3.377,"who":"К103","name":"Рон","text":"Тогда я закрою один глаз. Только один.","vocal":false},{"t":314.043,"dur":1.509,"who":"К102","name":"Пик","text":"Спокойной ночи, сторож.","vocal":false},{"t":317.252,"dur":1.503,"who":"Р","name":"Рассказчик","text":"Снег кончился.","vocal":false},{"t":319.655,"dur":4.634,"who":"К103","name":"Рон","text":"Я не спал! Я сторожил вместе с помощником!","vocal":false},{"t":324.739,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":326.733,"dur":2.563,"who":"К102","name":"Пик","text":"Смотрите, солнце вышло! Сегодня оно греет.","vocal":false},{"t":329.596,"dur":3.377,"who":"К101","name":"Барсик","text":"Смотрите, вот наш снеговик. Он блестит на солнце.","vocal":false},{"t":333.273,"dur":2.466,"who":"К101","name":"Барсик","text":"Если станет тепло, снег начнёт таять.","vocal":false},{"t":336.039,"dur":2.305,"who":"К103","name":"Рон","text":"А мой сторож? Он же снежный!","vocal":false},{"t":338.644,"dur":2.329,"who":"К104","name":"Топа","text":"Ой. Он тоже растает?","vocal":false},{"t":341.272,"dur":2.327,"who":"К103","name":"Рон","text":"Не отдам! Он мой сторож!","vocal":false},{"t":343.899,"dur":2.642,"who":"К101","name":"Барсик","text":"Не знаю, Рон. Это новая загадка.","vocal":false},{"t":346.841,"dur":2.267,"who":"К101","name":"Барсик","text":"Завтра узнаем, куда уходят снеговики.","vocal":false},{"t":351.008,"dur":7.594,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу поставить лайк и подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"noSnowman\":true,\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":53.291,"kind":"title","loc":""},{"t0":56.291,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"комната, день\",\"seed\":102,\"snowOut\":true,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":140.285,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"noSnowman\":true,\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":202.293,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"noSnowman\":true,\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":229.134,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"кухня, вечер\",\"seed\":103,\"snowOut\":true,\"time\":\"evening\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":252.292,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"комната, вечер\",\"seed\":104,\"snowOut\":true,\"time\":\"evening\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":290.973,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"зима, ночь\",\"noSnowman\":true,\"seed\":105,\"time\":\"night\",\"type\"