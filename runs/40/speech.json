{"dur":509.71774311493107,"names":{"К103":"Рон","К105":"Филя","К102":"Пик","К104":"Топа","К101":"Барсик","Р":"Рассказчик"},"speech":[{"t":7.464,"dur":3.663,"who":"К103","name":"Рон","text":"Ура! Смотри́те, санки едут сами!","vocal":false},{"t":19.022,"dur":0.8,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":19.942,"dur":1.758,"who":"К105","name":"Филя","text":"Вжух! И мои едут! Сами!","vocal":false},{"t":22,"dur":3.061,"who":"К102","name":"Пик","text":"Внизу санки остановились. А наверх их надо тащить.","vocal":false},{"t":31.831,"dur":3.532,"who":"К103","name":"Рон","text":"Ох, наверх тяжело! А вниз — легко!","vocal":false},{"t":35.662,"dur":0.831,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":36.614,"dur":4.269,"who":"К104","name":"Топа","text":"Рон, санки хитрые. Вниз едут, а наверх ленятся!","vocal":false},{"t":41.182,"dur":1.823,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":41.182,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":41.182,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":41.182,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":43.186,"dur":6.142,"who":"К101","name":"Барсик","text":"С горки санки едут сами. А в гору — нет. Почему так? Вот это загадка!","vocal":false},{"t":49.627,"dur":3.5,"who":"К103","name":"Рон","text":"Я знаю! У санок внутри моторчик!","vocal":false},{"t":56.227,"dur":2.888,"who":"К102","name":"Пик","text":"Никакого моторчика. Только дощечки и полозья.","vocal":false},{"t":59.415,"dur":1.57,"who":"К103","name":"Рон","text":"Даже батарейки нет?","vocal":false},{"t":61.285,"dur":0.638,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":62.043,"dur":1.002,"who":"К102","name":"Пик","text":"Даже батарейки.","vocal":false},{"t":63.844,"dur":1.884,"who":"К105","name":"Филя","text":"А может, их толкает ветер?","vocal":false},{"t":66.028,"dur":2.586,"who":"К104","name":"Топа","text":"Сейчас ветра нет. Тихо-тихо.","vocal":false},{"t":68.914,"dur":3.046,"who":"К101","name":"Барсик","text":"И внизу санки стоят. Сами никуда не едут.","vocal":false},{"t":72.26,"dur":4.657,"who":"К103","name":"Рон","text":"Значит, им нужна горка. Горка — это волшебство!","vocal":false},{"t":77.217,"dur":1.868,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":77.217,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":77.217,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":77.217,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":77.217,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":79.205,"dur":2.775,"who":"К101","name":"Барсик","text":"Давайте проверим на ровном месте. Без горки.","vocal":false},{"t":86.08,"dur":4.698,"who":"К103","name":"Рон","text":"По ровному тоже надо тащить. Но легче, чем в гору.","vocal":false},{"t":93.378,"dur":2.581,"who":"К105","name":"Филя","text":"Проехали чуть-чуть. И встали!","vocal":false},{"t":96.259,"dur":2.776,"who":"К104","name":"Топа","text":"Снег их держит. Как будто тормозит.","vocal":false},{"t":99.335,"dur":2.225,"who":"К103","name":"Рон","text":"А если толкнуть сильно-сильно?","vocal":false},{"t":103.71,"dur":0.414,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":104.66,"dur":1.834,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":104.66,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":104.66,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":106.673,"dur":3.624,"who":"К103","name":"Рон","text":"Санки уехали. А я остался.","vocal":false},{"t":110.597,"dur":2.58,"who":"К102","name":"Пик","text":"Санки проехали дальше. Но всё равно встали.","vocal":false},{"t":113.477,"dur":3.006,"who":"К101","name":"Барсик","text":"Значит, сами они едут только с горки. Вниз.","vocal":false},{"t":116.783,"dur":1.362,"who":"К105","name":"Филя","text":"А почему только вниз?","vocal":false},{"t":118.446,"dur":2.03,"who":"К101","name":"Барсик","text":"Пока не знаю. Проверим ещё!","vocal":false},{"t":122.175,"dur":4.034,"who":"К104","name":"Топа","text":"Смотри́те! Я прыгну высоко-высоко. До самого неба!","vocal":false},{"t":127.41,"dur":2.543,"who":"К105","name":"Филя","text":"Прыгнул вверх. И сразу вниз!","vocal":false},{"t":130.253,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":131.215,"dur":3.246,"who":"К104","name":"Топа","text":"До неба не долетел. Что-то тянет меня назад.","vocal":false},{"t":134.761,"dur":4.373,"who":"К103","name":"Рон","text":"Топа тоже не любит летать наверх. Как санки!","vocal":false},{"t":139.434,"dur":3.635,"who":"К102","name":"Пик","text":"И снежинки падают вниз. И снег на горке лежит, не улетает.","vocal":false},{"t":143.369,"dur":4.324,"who":"К103","name":"Рон","text":"Я проверю сам. Побегу на горку без санок!","vocal":false},{"t":149.115,"dur":0.414,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":152.865,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":152.865,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":152.865,"dur":1.834,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":152.865,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":154.848,"dur":0.777,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":155.745,"dur":4.878,"who":"К103","name":"Рон","text":"Я тоже скатился вниз. Сам! Без санок!","vocal":false},{"t":160.923,"dur":0.8,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":161.843,"dur":2.008,"who":"К105","name":"Филя","text":"Рон, ты как снежный колобок!","vocal":false},{"t":164.15,"dur":5.335,"who":"К101","name":"Барсик","text":"Топа, снежинки, санки и Рон. Все летят вниз. Кто же тянет всех вниз?","vocal":false},{"t":171.686,"dur":3.788,"who":"К103","name":"Рон","text":"Вот наш снеговик! Он стои́т на горке.","vocal":false},{"t":175.774,"dur":3.935,"who":"К105","name":"Филя","text":"А почему снеговик с горки не едет? Он же тоже на горке!","vocal":false},{"t":180.009,"dur":3.948,"who":"К104","name":"Топа","text":"Он стои́т в снегу, как в валенках. Снег его держит.","vocal":false},{"t":184.258,"dur":3.049,"who":"К101","name":"Барсик","text":"А у санок гладкие полозья. Они скользят по снегу.","vocal":false},{"t":187.606,"dur":3.32,"who":"К102","name":"Пик","text":"Гладкие скользят. Но кто их тянет вниз? Пока загадка.","vocal":false},{"t":191.227,"dur":5.053,"who":"К103","name":"Рон","text":"Тогда я сделаю снеговику санки! Пусть тоже катается!","vocal":false},{"t":196.58,"dur":1.868,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":196.58,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":196.58,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":196.58,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":196.58,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":198.568,"dur":0.8,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":199.488,"dur":2.306,"who":"К105","name":"Филя","text":"Рон, снеговик боится скорости!","vocal":false},{"t":202.094,"dur":4.645,"who":"К103","name":"Рон","text":"Ладно. Пусть стои́т и смотрит, как мы катаемся.","vocal":false},{"t":207.038,"dur":2.619,"who":"К104","name":"Топа","text":"Пойдёмте греться. Там подумаем.","vocal":false},{"t":213.357,"dur":3.198,"who":"К101","name":"Барсик","text":"Смотри́те, чай льётся вниз. Из чайника в чашку.","vocal":false},{"t":216.855,"dur":1.44,"who":"К105","name":"Филя","text":"А вверх он не льётся?","vocal":false},{"t":218.595,"dur":0.96,"who":"К101","name":"Барсик","text":"Ах-ха-ха!","vocal":true},{"t":219.675,"dur":1.71,"who":"К101","name":"Барсик","text":"Никогда. Только вниз.","vocal":false},{"t":224.586,"dur":1.816,"who":"К104","name":"Топа","text":"Вкусно. И тепло.","vocal":false},{"t":227.383,"dur":3.706,"who":"К105","name":"Филя","text":"А я думаю, санки просто любят кататься. Как мы!","vocal":false},{"t":231.39,"dur":0.74,"who":"К101","name":"Барсик","text":"Ха-ха!","vocal":true},{"t":232.25,"dur":2.231,"who":"К101","name":"Барсик","text":"Может быть. Но наверх они не хотят.","vocal":false},{"t":234.781,"dur":6.379,"who":"К103","name":"Рон","text":"Может, внизу живёт великан? И всех тянет к себе. Как магнит!","vocal":false},{"t":241.46,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":241.46,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":241.46,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":241.46,"dur":1.834,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":243.473,"dur":2.599,"who":"К102","name":"Пик","text":"Великана нет. Но ты почти угадал, Рон.","vocal":false},{"t":246.373,"dur":2.232,"who":"К105","name":"Филя","text":"Почти? Кто же тогда тянет?","vocal":false},{"t":248.905,"dur":3.215,"who":"К102","name":"Пик","text":"Пойдёмте в комнату. Я нарисую, и всё станет понятно.","vocal":false},{"t":256.82,"dur":6.893,"who":"К102","name":"Пик","text":"Это горка. А это земля внизу. Наша Земля очень большая. И она тянет к себе всё. Это называется притяжение.","vocal":false},{"t":264.013,"dur":3.486,"who":"К103","name":"Рон","text":"Земля тянет? А рук у неё нет!","vocal":false},{"t":267.799,"dur":4.625,"who":"К102","name":"Пик","text":"Рук нет. А тянет всегда. И снежинки, и чай, и санки. И даже нас.","vocal":false},{"t":272.724,"dur":2.631,"who":"К104","name":"Топа","text":"Поэтому я не улетаю, когда прыгаю?","vocal":false},{"t":276.555,"dur":1.566,"who":"К102","name":"Пик","text":"Да! Прыгнул — и сразу вниз.","vocal":false},{"t":278.421,"dur":4.315,"who":"К101","name":"Барсик","text":"Санки на горке тоже тянет вниз Земля. Поэтому с горки они едут сами!","vocal":false},{"t":283.036,"dur":0.823,"who":"К105","name":"Филя","text":"А в гору?","vocal":false},{"t":284.159,"dur":5.405,"who":"К102","name":"Пик","text":"В гору санки надо тянуть против притяжения. Земля тянет их назад, вниз. Поэтому тяжело.","vocal":false},{"t":289.864,"dur":3.388,"who":"К101","name":"Барсик","text":"А снег гладкий и скользкий. Санки по нему легко скользят.","vocal":false},{"t":293.552,"dur":1.125,"who":"К104","name":"Топа","text":"А на ровном месте?","vocal":false},{"t":294.976,"dur":4.003,"who":"К102","name":"Пик","text":"На ровном месте вниз некуда. Снег немножко тормозит. И санки стоят.","vocal":false},{"t":299.28,"dur":3.896,"who":"К103","name":"Рон","text":"Значит, Земля любит, когда мы катаемся с горки!","vocal":false},{"t":303.476,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":303.476,"dur":1.823,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":303.476,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":303.476,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":303.476,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":305.458,"dur":3.243,"who":"К104","name":"Топа","text":"А я тяжёлый. Меня Земля тянет сильнее?","vocal":false},{"t":309.002,"dur":4.039,"who":"К102","name":"Пик","text":"Да, Топа. Тяжёлого тянет сильнее. А пёрышко — совсем чуть-чуть.","vocal":false},{"t":313.341,"dur":5.135,"who":"К103","name":"Рон","text":"Тогда я съем ещё пирожок. И поеду быстрее всех!","vocal":false},{"t":318.776,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":318.776,"dur":1.868,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":318.776,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":318.776,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":318.776,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":322.69,"dur":3.14,"who":"К101","name":"Барсик","text":"Проверим! Чем выше горка, тем быстрее едешь.","vocal":false},{"t":333.344,"dur":1.596,"who":"К101","name":"Барсик","text":"Ура-а-а! Как быстро!","vocal":false},{"t":342.834,"dur":1.469,"who":"К104","name":"Топа","text":"Земля, спасибо!","vocal":false},{"t":344.603,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":344.603,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":354.181,"dur":1.873,"who":"К105","name":"Филя","text":"Мы вместе! И оба сами!","vocal":false},{"t":356.354,"dur":2.703,"who":"К102","name":"Пик","text":"Видите? Санки едут туда, куда тянет Земля.","vocal":false},{"t":359.357,"dur":3.6,"who":"К103","name":"Рон","text":"Теперь я тащу санки наверх. Сам!","vocal":false},{"t":369.727,"dur":4.55,"who":"К103","name":"Рон","text":"Наверх тяжело. Земля тянет санки назад!","vocal":false},{"t":374.577,"dur":1.992,"who":"К103","name":"Рон","text":"А вниз она мне помогает!","vocal":false},{"t":383.744,"dur":1.044,"who":"К102","name":"Пик","text":"Ура! Я тоже еду!","vocal":false},{"t":385.088,"dur":2.298,"who":"К105","name":"Филя","text":"Пик маленький, а едет быстро!","vocal":false},{"t":387.686,"dur":4.007,"who":"К101","name":"Барсик","text":"Земля тянет всех: и маленьких, и больших.","vocal":false},{"t":393.393,"dur":1.703,"who":"К104","name":"Топа","text":"Последний раз! Кто быстрее?","vocal":false},{"t":402.99,"dur":2.022,"who":"К105","name":"Филя","text":"Ничья! Оба приехали вместе!","vocal":false},{"t":405.312,"dur":0.831,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":406.263,"dur":4.028,"who":"К104","name":"Топа","text":"Я тяжёлый, а Барсик лёгкий. А приехали вместе!","vocal":false},{"t":410.591,"dur":3.091,"who":"К102","name":"Пик","text":"Земля тянет каждого. Поэтому едут почти одинаково.","vocal":false},{"t":413.983,"dur":3.85,"who":"К103","name":"Рон","text":"А я буду судьёй. Я снизу всё видел!","vocal":false},{"t":418.133,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":41