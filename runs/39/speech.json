{"dur":245.3266007653061,"names":{"К105":"Филя","К102":"Пик","К103":"Рон","К101":"Барсик","К104":"Топа","Р":"Рассказчик"},"speech":[{"t":0.85,"dur":2.696,"who":"К105","name":"Филя","text":"Смотрите! Вот снежинка! У меня в лапке!","vocal":false},{"t":6.646,"dur":3.724,"who":"К102","name":"Пик","text":"Ого! Лучики! Раз, два, три, четыре, пять, шесть!","vocal":false},{"t":10.67,"dur":2.557,"who":"К103","name":"Рон","text":"Она как звёздочка! Белая звёздочка!","vocal":false},{"t":13.527,"dur":3.048,"who":"К101","name":"Барсик","text":"Давайте посмотрим ещё одну. Вон их сколько летит!","vocal":false},{"t":17.475,"dur":2.152,"who":"К104","name":"Топа","text":"Поймал! И у этой шесть лучиков.","vocal":false},{"t":19.927,"dur":3.114,"who":"К103","name":"Рон","text":"А мне снежинка села на нос! Сколько там лучиков?","vocal":false},{"t":23.34,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":24.303,"dur":3.655,"who":"К104","name":"Топа","text":"Рон, она уже растаяла. Нос у тебя тёплый!","vocal":false},{"t":28.258,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":28.258,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":28.258,"dur":1.642,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":28.258,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":28.258,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":30.271,"dur":3.631,"who":"К101","name":"Барсик","text":"Почему у всех снежинок шесть лучиков? Вот это загадка!","vocal":false},{"t":40.102,"dur":2.091,"who":"К103","name":"Рон","text":"Я найду самую большую снежинку!","vocal":false},{"t":44.243,"dur":0.456,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":45.193,"dur":1.642,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":46.955,"dur":2.447,"who":"К103","name":"Рон","text":"Большая улетела. А я приземлился.","vocal":false},{"t":49.702,"dur":2.7,"who":"К105","name":"Филя","text":"Они падают медленно. Как пушинки.","vocal":false},{"t":52.702,"dur":2.917,"who":"К102","name":"Пик","text":"Снежинка очень лёгкая, как пух. Её уносит ветер.","vocal":false},{"t":55.919,"dur":1.459,"who":"К104","name":"Топа","text":"А откуда они берутся?","vocal":false},{"t":57.678,"dur":2.401,"who":"К101","name":"Барсик","text":"Из облака. Высоко-высоко над нами.","vocal":false},{"t":60.379,"dur":3.592,"who":"К103","name":"Рон","text":"Там, наверное, кто-то их вырезает. Ножницами.","vocal":false},{"t":64.272,"dur":0.81,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":65.202,"dur":2.029,"who":"К105","name":"Филя","text":"Тогда ему работы на всю зиму!","vocal":false},{"t":67.531,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":67.531,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":67.531,"dur":1.143,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":67.531,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":67.531,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":69.534,"dur":3.479,"who":"К101","name":"Барсик","text":"Пойдёмте пить чай. Пик расскажет, как рождается снежинка.","vocal":false},{"t":76.714,"dur":3.056,"who":"К101","name":"Барсик","text":"Смотрите, над чашкой пар. Это вода в воздухе.","vocal":false},{"t":80.07,"dur":2.477,"who":"К102","name":"Пик","text":"В облаке тоже вода. Много-много маленьких капелек.","vocal":false},{"t":82.847,"dur":1.214,"who":"К104","name":"Топа","text":"А наверху холодно?","vocal":false},{"t":84.361,"dur":3.185,"who":"К102","name":"Пик","text":"Очень холодно. Там капелька замерзает. Получается льдинка.","vocal":false},{"t":87.845,"dur":2.265,"who":"К105","name":"Филя","text":"Такая маленькая, что её не видно?","vocal":false},{"t":90.411,"dur":3.316,"who":"К102","name":"Пик","text":"Да. А потом к льдинке прилипают новые. И она становится больше.","vocal":false},{"t":94.027,"dur":3.192,"who":"К101","name":"Барсик","text":"Растёт ровно в шесть сторон. Так получаются лучики!","vocal":false},{"t":97.519,"dur":2.663,"who":"К103","name":"Рон","text":"Вода знает цифру шесть? Вот умница!","vocal":false},{"t":100.482,"dur":1.195,"who":"К101","name":"Барсик","text":"Ах-ха-ха-ха!","vocal":true},{"t":100.482,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":100.482,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":100.482,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":100.482,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":102.495,"dur":2.356,"who":"К102","name":"Пик","text":"Так устроен лёд. Шесть лучиков — всегда!","vocal":false},{"t":105.152,"dur":3.31,"who":"К104","name":"Топа","text":"А потом снежинка тяжелеет. И падает вниз.","vocal":false},{"t":113.662,"dur":3.11,"who":"К105","name":"Филя","text":"Я рисую снежинку. Сначала одна линия.","vocal":false},{"t":117.072,"dur":1.418,"who":"К103","name":"Рон","text":"Пока похоже на линию.","vocal":false},{"t":118.79,"dur":3.802,"who":"К105","name":"Филя","text":"Теперь ещё две, крест-накрест. Вот! Шесть лучиков!","vocal":false},{"t":122.892,"dur":3.274,"who":"К101","name":"Барсик","text":"Как просто! Три линии — и шесть лучиков.","vocal":false},{"t":126.466,"dur":3.047,"who":"К104","name":"Топа","text":"А на концах можно веточки. Как ёлочки.","vocal":false},{"t":129.813,"dur":2.725,"who":"К103","name":"Рон","text":"А я нарисую снежинку с ушами. Как у меня.","vocal":false},{"t":132.838,"dur":0.8,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":133.758,"dur":2.071,"who":"К105","name":"Филя","text":"Рон, у снежинок нет ушей!","vocal":false},{"t":136.129,"dur":2.454,"who":"К103","name":"Рон","text":"Она особенная. Она слушает зиму.","vocal":false},{"t":138.883,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":138.883,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":138.883,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":138.883,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":142.797,"dur":3.55,"who":"К101","name":"Барсик","text":"Давайте ловить снежинки на шарф. На тёмном их лучше видно.","vocal":false},{"t":146.647,"dur":2.606,"who":"К104","name":"Топа","text":"У меня шарф зелёный. Ловите!","vocal":false},{"t":152.353,"dur":2.064,"who":"К102","name":"Пик","text":"Эта с веточками. А эта как цветочек.","vocal":false},{"t":154.717,"dur":1.904,"who":"К105","name":"Филя","text":"А эта похожа на звёздочку.","vocal":false},{"t":156.921,"dur":3.071,"who":"К101","name":"Барсик","text":"Двух одинаковых снежинок не бывает. Все разные.","vocal":false},{"t":160.292,"dur":0.582,"who":"К103","name":"Рон","text":"Как мы!","vocal":false},{"t":161.174,"dur":0.79,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":162.084,"dur":2.019,"who":"К105","name":"Филя","text":"Рон, ты точно один такой!","vocal":false},{"t":164.403,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":164.403,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":164.403,"dur":1.428,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":164.403,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":164.403,"dur":1.587,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":167.006,"dur":3.274,"who":"К103","name":"Рон","text":"Вот моя снежинка. Пусть будет у меня. На память.","vocal":false},{"t":171.08,"dur":1.313,"who":"К102","name":"Пик","text":"Рон, она же растает…","vocal":false},{"t":172.693,"dur":1.48,"who":"К103","name":"Рон","text":"Тсс! Тайна.","vocal":false},{"t":176.373,"dur":2.241,"who":"К103","name":"Рон","text":"Смотрите, что у меня в кармане!","vocal":false},{"t":181.314,"dur":2.339,"who":"К103","name":"Рон","text":"Ой! Где она? Тут 