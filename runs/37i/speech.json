{"dur":354.63027793238507,"names":{"К103":"Рон","К105":"Филя","К101":"Барсик","К104":"Топа","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":4.258,"who":"К103","name":"Рон","text":"Смотри́те, вот наша лужа. Сейчас — плюх!","vocal":false},{"t":5.758,"dur":0.414,"who":"К103","name":"Рон","text":"Ай!","vocal":true},{"t":6.708,"dur":4.616,"who":"К103","name":"Рон","text":"Ой! Она не плюхает! Она твёрдая!","vocal":false},{"t":11.774,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":13.757,"dur":2.28,"who":"К101","name":"Барсик","text":"Лужа замёрзла! Теперь это лёд!","vocal":false},{"t":16.337,"dur":3.569,"who":"К104","name":"Топа","text":"Блестит, как стекло. И скользкий-скользкий.","vocal":false},{"t":20.806,"dur":3.314,"who":"К103","name":"Рон","text":"А где вода? Она пропала?","vocal":false},{"t":24.42,"dur":3.279,"who":"К101","name":"Барсик","text":"Никуда. Вода здесь. Только она стала твёрдой.","vocal":false},{"t":27.999,"dur":3.211,"who":"К104","name":"Топа","text":"Ночью пришёл мороз. И заморозил лужу.","vocal":false},{"t":31.66,"dur":0.766,"who":"К103","name":"Рон","text":"Хм-м…","vocal":true},{"t":33.11,"dur":2.475,"who":"К103","name":"Рон","text":"Пахнет… холодом.","vocal":false},{"t":35.885,"dur":1.868,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":35.885,"dur":1.862,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":35.885,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":35.885,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":37.873,"dur":2.831,"who":"К105","name":"Филя","text":"Смотри́те, вот наш снеговик! Он стои́т!","vocal":false},{"t":41.004,"dur":3.123,"who":"К103","name":"Рон","text":"Снежок Второй! Ты не растаял!","vocal":false},{"t":44.427,"dur":3.879,"who":"К104","name":"Топа","text":"Ночью было очень холодно. А в холоде снег не та́ет.","vocal":false},{"t":48.606,"dur":3.259,"who":"К101","name":"Барсик","text":"Мороз растопи