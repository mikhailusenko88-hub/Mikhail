{"dur":335.1319410430839,"names":{"К103":"Рон","К105":"Филя","К104":"Топа","К101":"Барсик","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":2.164,"who":"К103","name":"Рон","text":"Ой! Всё белое! Где наш росток?","vocal":false},{"t":5.914,"dur":2.582,"who":"К103","name":"Рон","text":"Нашёл! Смотрите! Вот наш росток!","vocal":false},{"t":8.796,"dur":2.939,"who":"К105","name":"Филя","text":"Он зелёный! Сидел под снегом и не замёрз!","vocal":false},{"t":12.535,"dur":3.041,"who":"К104","name":"Топа","text":"Ночью был мороз. А ему хоть бы что!","vocal":false},{"t":15.876,"dur":2.534,"who":"К101","name":"Барсик","text":"Как же он не замёрз? Ему же холодно!","vocal":false},{"t":19.21,"dur":2.445,"who":"Р","name":"Рассказчик","text":"Рон достал из рюкзака подушку.","vocal":false},{"t":21.955,"dur":3.392,"who":"К103","name":"Рон","text":"Держись, малыш! Вот тебе подушка. Мягкая!","vocal":false},{"t":26.297,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":28.28,"dur":0.622,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":29.022,"dur":1.752,"who":"К102","name":"Пик","text":"Рон, у него есть своё одеяло.","vocal":false},{"t":31.074,"dur":1.81,"who":"К103","name":"Рон","text":"Где? Я ничего не вижу.","vocal":false},{"t":33.184,"dur":1.103,"who":"К102","name":"Пик","text":"Вот оно. Снег!","vocal":false},{"t":34.587,"dur":1.95,"who":"К103","name":"Рон","text":"Снег? Но снег холодный!","vocal":false},{"t":36.837,"dur":1.49,"who":"К104","name":"Топа","text":"И он совсем целый!","vocal":false},{"t":38.626,"dur":4.17,"who":"К101","name":"Барсик","text":"Вот это загадка. Холодный снег, а под ним росток не мёрзнет.","vocal":false},{"t":43.096,"dur":2.115,"who":"К105","name":"Филя","text":"Может, снег не такой уж холодный?","vocal":false},{"t":45.661,"dur":2.209,"who":"К104","name":"Топа","text":"А-а-а-ах.","vocal":true},{"t":52.371,"dur":2.548,"who":"К105","name":"Филя","text":"Топа, ты зеваешь уже десятый раз!","vocal":false},{"t":55.218,"dur":5.293,"who":"К104","name":"Топа","text":"Не знаю почему. Зимой мне всё время хочется спать.","vocal":false},{"t":60.812,"dur":2.903,"who":"К102","name":"Пик","text":"Это потому, что ты медвежонок. Медведи спят всю зиму!","vocal":false},{"t":64.015,"dur":1.969,"who":"К103","name":"Рон","text":"Всю зиму? А как же завтрак?","vocal":false},{"t":66.284,"dur":4.116,"who":"К104","name":"Топа","text":"Осенью медведи много едят. А потом спят и не голодают.","vocal":false},{"t":70.699,"dur":2.081,"who":"К105","name":"Филя","text":"Как жёлудь! Запас еды на потом!","vocal":false},{"t":73.681,"dur":3.155,"who":"К103","name":"Рон","text":"Тогда мне тоже нужен запас. Начну прямо сейчас.","vocal":false},{"t":79.335,"dur":3.413,"who":"К103","name":"Рон","text":"Всё! Запас готов. Я тоже буду спать всю зиму!","vocal":false},{"t":83.649,"dur":1.176,"who":"К103","name":"Рон","text":"Спокойной ночи!","vocal":false},{"t":86.725,"dur":2.781,"who":"К103","name":"Рон","text":"Всё! Я выспался! Можно завтракать?","vocal":false},{"t":89.806,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":90.768,"dur":2.092,"who":"К104","name":"Топа","text":"Рон, прошла одна минутка!","vocal":false},{"t":93.161,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":93.161,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":93.161,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":93.161,"dur":1.587,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":95.174,"dur":1.306,"who":"К101","name":"Барсик","text":"А где медведи спят?","vocal":false},{"t":96.781,"dur":5.276,"who":"К104","name":"Топа","text":"В берлоге. Это ямка под ёлкой. Сверху её засыпает снег.","vocal":false},{"t":102.356,"dur":3.58,"who":"К104","name":"Топа","text":"В берлоге тепло, даже когда снаружи сильный мороз.","vocal":false},{"t":106.237,"dur":1.367,"who":"К105","name":"Филя","text":"Опять снег греет?","vocal":false},{"t":107.904,"dur":4.878,"who":"К101","name":"Барсик","text":"Снег сам не греет. Он как шарф. Шарф не печка, а нам в нём тепло.","vocal":false},{"t":113.082,"dur":2.654,"who":"К105","name":"Филя","text":"Потому что шарф не выпускает наше тепло?","vocal":false},{"t":116.036,"dur":5.697,"who":"К101","name":"Барсик","text":"Да! В снегу много воздуха. И он бережёт тепло земли. Как пушистое одеяло.","vocal":false},{"t":122.033,"dur":3.223,"who":"К103","name":"Рон","text":"Значит, росток спит под одеялом. Как Топа!","vocal":false},{"t":126.356,"dur":2.37,"who":"К105","name":"Филя","text":"Тише. Топа уже спит.","vocal":false},{"t":130.426,"dur":2.688,"who":"К101","name":"Барсик","text":"Смотрите, ёлки зелёные! Зимой!","vocal":false},{"t":133.414,"dur":3.897,"who":"К102","name":"Пик","text":"У ёлки не листики, а иголки. Они узкие и крепкие. Мороз им не страшен.","vocal":false},{"t":138.21,"dur":3.335,"who":"К105","name":"Филя","text":"А вот листик дуба. Он сухой и коричневый.","vocal":false},{"t":141.845,"dur":3.829,"who":"К101","name":"Барсик","text":"Осенью дуб сбрасывает листья. И засыпает до весны.","vocal":false},{"t":145.973,"dur":1.09,"who":"К103","name":"Рон","text":"Дуб тоже медведь?","vocal":false},{"t":147.364,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":147.364,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":147.364,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":147.364,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":149.377,"dur":0.638,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":150.135,"dur":1.784,"who":"К102","name":"Пик","text":"Нет. Но спит он, как медведь.","vocal":false},{"t":152.82,"dur":2.383,"who":"К104","name":"Топа","text":"Смотрите! Жёлудь! Прямо под снегом!","vocal":false},{"t":155.502,"dur":1.646,"who":"К102","name":"Пик","text":"Он тоже спит. Как наш росток.","vocal":false},{"t":157.448,"dur":3.509,"who":"К101","name":"Барсик","text":"А весной снег растает. И жёлудь проснётся.","vocal":false},{"t":161.257,"dur":1.037,"who":"К103","name":"Рон","text":"Так долго ждать?","vocal":false},{"t":162.594,"dur":2.398,"who":"К105","name":"Филя","text":"Ничего. Мы подождём вместе.","vocal":false},{"t":165.293,"dur":2.27,"who":"К105","name":"Филя","text":"А давайте пока в прятки! Рон водит!","vocal":false},{"t":168.363,"dur":2.439,"who":"К103","name":"Рон","text":"Раз, два, три! Иду искать!","vocal":false},{"t":173.502,"dur":1.924,"who":"К103","name":"Рон","text":"Где Филя? Тут только снег!","vocal":false},{"t":175.876,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":177.869,"dur":2.519,"who":"К103","name":"Рон","text":"Ой! Филя! Ты белый, как снег!","vocal":false},{"t":180.688,"dur":3.21,"who":"К101","name":"Барсик","text":"Зайцы к зиме становятся белыми. На снегу их не видно.","vocal":false},{"t":184.198,"dur":3.414,"who":"К105","name":"Филя","text":"А я белый всегда. Я готов к зиме заранее!","vocal":false},{"t":187.912,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":187.912,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":187.912,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":187.912,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":187.912,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":191.325,"dur":2.986,"who":"К103","name":"Рон","text":"Я придумал! Росток будет охранять снежный сторож!","vocal":false},{"t":195.112,"dur":3.885,"who":"К103","name":"Рон","text":"Готово! Вот он, снежный сторож! Он не мёрзнет и никогда не спит!","vocal":false},{"t":199.297,"dur":1.13,"who":"К104","name":"Топа","text":"Повезло ему.","vocal":false},{"t":200.877,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":203.471,"dur":1.222,"who":"К101","name":"Барсик","text":"А ну, кто поймает?","vocal":false},{"t":206.092,"dur":1.934,"who":"К103","name":"Рон","text":"Поймал! Я быстрый сторож!","vocal":false},{"t":209.426,"dur":0.646,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":210.193,"dur":0.445,"who":"К102","name":"Пик","text":"Мимо!","vocal":false},{"t":210.938,"dur":2.116,"who":"К103","name":"Рон","text":"Это я ему показал, как надо.","vocal":false},{"t":217.154,"dur":4.262,"who":"К104","name":"Топа","text":"Тёплое молоко. И сразу хочется спать.","vocal":false},{"t":221.716,"dur":3.427,"who":"К101","name":"Барсик","text":"Нам тепло в доме. А ростку тепло под снегом.","vocal":false},{"t":225.443,"dur":2.629,"who":"К103","name":"Рон","text":"А наш снежный сторож? Ему тоже тепло?","vocal":false},{"t":228.372,"dur":1.814,"who":"К102","name":"Пик","text":"Ему нельзя греться. Он растает.","vocal":false},{"t":230.485,"dur":2.777,"who":"К103","name":"Рон","text":"Тогда пусть ему будет холодно! Самую чуточку.","vocal":false},{"t":233.712,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":237.096,"dur":3.386,"who":"К105","name":"Филя","text":"Давайте поиграем! Я спрашиваю, а вы отвечаете.","vocal":false},{"t":240.782,"dur":0.743,"who":"К101","name":"Барсик","text":"Начинай!","vocal":false},{"t":241.824,"dur":2.245,"who":"К105","name":"Филя","text":"Почему росток под снегом не замёрз?","vocal":false},{"t":247.37,"dur":1.773,"who":"К102","name":"Пик","text":"Снег укрыл его, как одеяло.","vocal":false},{"t":249.442,"dur":1.986,"who":"К105","name":"Филя","text":"Правильно! А кто спит всю зиму?","vocal":false},{"t":254.729,"dur":2.275,"who":"К104","name":"Топа","text":"Медведи. И я.","vocal":false},{"t":257.304,"dur":2.055,"who":"К105","name":"Филя","text":"А почему ёлка зимой зелёная?","vocal":false},{"t":262.659,"dur":2.452,"who":"К101","name":"Барсик","text":"У неё иголки. Им мороз не страшен.","vocal":false},{"t":265.41,"dur":1.333,"who":"К103","name":"Рон","text":"А кто никогда не спит?","vocal":false},{"t":267.043,"dur":0.517,"who":"К105","name":"Филя","text":"Кто?","vocal":false},{"t":267.861,"dur":2.472,"who":"К103","name":"Рон","text":"Снежный сторож! И я! Почти.","vocal":false},{"t":270.633,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":270.633,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":270.633,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":270.633,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":270.633,"dur":1.687,"who":"К103","name":"Рон","text":"Ха-ха-ха-ха!","vocal":true},{"t":274.647,"dur":2.465,"who":"К103","name":"Рон","text":"Вот наш росток. Спит под одеялом.","vocal":false},{"t":277.412,"dur":1.994,"who":"К101","name":"Барсик","text":"А вот и снеговик. Сторожит.","vocal":false},{"t":279.706,"dur":2.355,"who":"К103","name":"Рон","text":"Мы с ним вдвоём. Я и мой помощник.","vocal":false},{"t":283.111,"dur":1.579,"who":"К103","name":"Рон","text":"А-а-а-ах.","vocal":true},{"t":284.961,"dur":1.86,"who":"К103","name":"Рон","text":"Сторож, ты точно не спишь?","vocal":false},{"t":287.121,"dur":2.819,"who":"К105","name":"Филя","text":"Он молчит. Значит, сторожит.","vocal":false},{"t":290.24,"dur":2.586,"who":"К103","name":"Рон","text":"Тогда я закрою один глаз. Только один.","vocal":false},{"t":293.926,"dur":1.509,"who":"К102","name":"Пик","text":"Спокойной ночи, сторож.","vocal":false},{"t":297.135,"dur":1.503,"who":"Р","name":"Рассказчик","text":"Снег кончился.","vocal":false},{"t":299.538,"dur":2.917,"who":"К103","name":"Рон","text":"Я не спал! Я сторожил вместе с помощником!","vocal":false},{"t":302.905,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":304.898,"dur":2.935,"who":"К102","name":"Пик","text":"Смотрите, какое яркое солнце! Сегодня теплее.","vocal":false},{"t":308.134,"dur":3.377,"who":"К101","name":"Барсик","text":"Смотрите, вот наш снеговик. Он блестит на солнце.","vocal":false},{"t":311.81,"dur":2.466,"who":"К101","name":"Барсик","text":"Если станет тепло, снег начнёт таять.","vocal":false},{"t":314.577,"dur":1.918,"who":"К103","name":"Рон","text":"А мой сторож? Он же снежный!","vocal":false},{"t":316.794,"dur":2.329,"who":"К104","name":"Топа","text":"Ой. Он тоже растает?","vocal":false},{"t":319.423,"dur":1.824,"who":"К103","name":"Рон","text":"Не отдам! Он мой сторож!","vocal":false},{"t":321.547,"dur":2.642,"who":"К101","name":"Барсик","text":"Не знаю, Рон. Это новая загадка.","vocal":false},{"t":324.489,"dur":2.267,"who":"К101","name":"Барсик","text":"Завтра узнаем, куда уходят снеговики.","vocal":false},{"t":328.656,"dur":4.876,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":48.771,"kind":"title","loc":""},{"t0":51.771,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"комната, день\",\"seed\":102,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":129.826,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":190.725,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":214.154,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"кухня, вечер\",\"seed\":103,\"time\":\"evening\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":236.496,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"комната, вечер\",\"seed\":104,\"time\":\"evening\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":273.447,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"зима, ночь\",\"seed\":105,\"time\":\"night\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":296.535,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\",\"wxAt\":[{\"t\":0.9,\"v\":\"none\"}]}"},{"t0":327.856,"kind":"end","loc":""}]}