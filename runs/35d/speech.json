{"dur":364.7968535997732,"names":{"К103":"Рон","К105":"Филя","К104":"Топа","К101":"Барсик","К102":"Пик","Р":"Рассказчик"},"speech":[{"t":0.25,"dur":2.254,"who":"К103","name":"Рон","text":"Ой! Снег! Где наш росток?","vocal":false},{"t":6.004,"dur":3.979,"who":"К103","name":"Рон","text":"Нашёл! Смотри́те! Вот наш росток!","vocal":false},{"t":10.283,"dur":2.939,"who":"К105","name":"Филя","text":"Он зелёный! Сидел под снегом и не замё́рз!","vocal":false},{"t":14.022,"dur":3.041,"who":"К104","name":"Топа","text":"Ночью был мороз. А ему́ хоть бы что!","vocal":false},{"t":17.363,"dur":2.534,"who":"К101","name":"Барсик","text":"Как же он не замё́рз? Ему́ же холодно!","vocal":false},{"t":20.697,"dur":3.045,"who":"Р","name":"Рассказчик","text":"Рон достал из рюкзака красную подушку.","vocal":false},{"t":24.042,"dur":4.046,"who":"К103","name":"Рон","text":"Держись, малыш! Вот тебе подушка. Мя́гкая!","vocal":false},{"t":29.038,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":31.021,"dur":0.622,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":31.763,"dur":1.683,"who":"К102","name":"Пик","text":"Рон, у ростка есть одеяло.","vocal":false},{"t":33.746,"dur":3.128,"who":"К103","name":"Рон","text":"Где? Я ничего не вижу.","vocal":false},{"t":37.174,"dur":1.103,"who":"К102","name":"Пик","text":"Вот оно. Снег!","vocal":false},{"t":38.577,"dur":2.411,"who":"К103","name":"Рон","text":"Снег? Но снег холодный!","vocal":false},{"t":41.288,"dur":1.49,"who":"К104","name":"Топа","text":"И он совсем целый!","vocal":false},{"t":43.077,"dur":4.17,"who":"К101","name":"Барсик","text":"Вот это загадка. Холодный снег, а под ним росток не мёрзнет.","vocal":false},{"t":47.548,"dur":2.115,"who":"К105","name":"Филя","text":"Может, снег не такой уж холодный?","vocal":false},{"t":50.113,"dur":2.209,"who":"К104","name":"Топа","text":"А-а-а-ах.","vocal":true},{"t":56.822,"dur":2.548,"who":"К105","name":"Филя","text":"Топа, ты зеваешь уже́ десятый раз!","vocal":false},{"t":59.67,"dur":5.293,"who":"К104","name":"Топа","text":"Не знаю почему. Зимой мне всё время хочется спать.","vocal":false},{"t":65.263,"dur":3.289,"who":"К101","name":"Барсик","text":"Это потому, что ты медвежонок. Медве́ди спят всю зи́му!","vocal":false},{"t":68.852,"dur":3.393,"who":"К103","name":"Рон","text":"Всю зи́му? А как же завтрак?","vocal":false},{"t":72.545,"dur":4.116,"who":"К104","name":"Топа","text":"Осенью медве́ди много едят. А пото́м спят и не голодают.","vocal":false},{"t":76.961,"dur":2.081,"who":"К105","name":"Филя","text":"Как жёлудь! Запас еды на пото́м!","vocal":false},{"t":79.942,"dur":3.77,"who":"К103","name":"Рон","text":"Тогда мне тоже нужен запас. Начну прямо сейчас.","vocal":false},{"t":86.212,"dur":5.085,"who":"К103","name":"Рон","text":"Всё! Запас готов. Я тоже буду спать всю зи́му!","vocal":false},{"t":92.197,"dur":1.44,"who":"К103","name":"Рон","text":"Спокойной ночи!","vocal":false},{"t":95.537,"dur":4.261,"who":"К103","name":"Рон","text":"Всё! Я выспался! Можно завтракать?","vocal":false},{"t":100.098,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":101.06,"dur":2.092,"who":"К104","name":"Топа","text":"Рон, прошла одна минутка!","vocal":false},{"t":103.453,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":103.453,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":103.453,"dur":0.931,"who":"К101","name":"Барсик","text":"Ха-ха-ха!","vocal":true},{"t":103.453,"dur":1.783,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":105.467,"dur":1.306,"who":"К101","name":"Барсик","text":"А где медве́ди спят?","vocal":false},{"t":107.073,"dur":5.276,"who":"К104","name":"Топа","text":"В берлоге. Это ямка под ёлкой. Сверху её засыпает снег.","vocal":false},{"t":112.648,"dur":3.58,"who":"К104","name":"Топа","text":"В берлоге тепло, даже когда снаружи сильный мороз.","vocal":false},{"t":116.529,"dur":1.367,"who":"К105","name":"Филя","text":"Опять снег гре́ет?","vocal":false},{"t":118.196,"dur":4.878,"who":"К101","name":"Барсик","text":"Снег сам не гре́ет. Он как шарф. Шарф не печка, а нам в нём тепло.","vocal":false},{"t":123.374,"dur":2.654,"who":"К105","name":"Филя","text":"Потому что шарф не выпускает наше тепло?","vocal":false},{"t":126.328,"dur":5.679,"who":"К101","name":"Барсик","text":"Да! В снегу много воздуха. И он бережёт тепло земли́. Как пуши́стое одеяло.","vocal":false},{"t":132.307,"dur":3.707,"who":"К103","name":"Рон","text":"Значит, росток спит под одеялом. Как Топа!","vocal":false},{"t":137.115,"dur":2.37,"who":"К105","name":"Филя","text":"Ти́ше. Топа уже́ спит.","vocal":false},{"t":141.185,"dur":2.688,"who":"К101","name":"Барсик","text":"Смотри́те, ёлки зелёные! Зимой!","vocal":false},{"t":144.173,"dur":5.019,"who":"К104","name":"Топа","text":"У ёлки иголки. Тонкие и крепкие. Им мороз не страшен.","vocal":false},{"t":150.092,"dur":3.335,"who":"К105","name":"Филя","text":"А вот листик дуба. Он сухой и коричневый.","vocal":false},{"t":153.727,"dur":3.829,"who":"К101","name":"Барсик","text":"Осенью дуб сбрасывает листья. И засыпает до весны.","vocal":false},{"t":157.855,"dur":1.274,"who":"К103","name":"Рон","text":"Дуб тоже медве́дь?","vocal":false},{"t":159.429,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":159.429,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":159.429,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":159.429,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":161.443,"dur":0.842,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":162.405,"dur":2.45,"who":"К104","name":"Топа","text":"Нет. Но спит он, как я!","vocal":false},{"t":165.755,"dur":2.383,"who":"К104","name":"Топа","text":"Смотри́те! Жёлудь! Прямо под снегом!","vocal":false},{"t":168.437,"dur":1.646,"who":"К102","name":"Пик","text":"Он тоже спит. Как наш росток.","vocal":false},{"t":170.383,"dur":3.509,"who":"К101","name":"Барсик","text":"А весной снег раста́ет. И жёлудь проснётся.","vocal":false},{"t":174.192,"dur":1.221,"who":"К103","name":"Рон","text":"Так долго ждать?","vocal":false},{"t":175.713,"dur":2.398,"who":"К105","name":"Филя","text":"Ничего. Мы подождём вместе.","vocal":false},{"t":178.411,"dur":2.27,"who":"К105","name":"Филя","text":"А давайте пока в прятки! Рон водит!","vocal":false},{"t":181.482,"dur":2.649,"who":"К103","name":"Рон","text":"Раз, два, три! Иду искать!","vocal":false},{"t":186.831,"dur":2.5,"who":"К103","name":"Рон","text":"Где Филя? Тут только снег!","vocal":false},{"t":189.78,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":191.774,"dur":3.357,"who":"К103","name":"Рон","text":"Ой! Филя! Ты белый, как снег!","vocal":false},{"t":195.431,"dur":3.21,"who":"К101","name":"Барсик","text":"Зайцы к зиме становятся белыми. На снегу их не ви́дно.","vocal":false},{"t":198.941,"dur":3.414,"who":"К105","name":"Филя","text":"А я белый всегда. Я готов к зиме заранее!","vocal":false},{"t":202.655,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":202.655,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":202.655,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":202.655,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":202.655,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":206.069,"dur":3.669,"who":"К103","name":"Рон","text":"Я придумал! Росток будет охранять снежный сторож!","vocal":false},{"t":210.538,"dur":5.34,"who":"К103","name":"Рон","text":"Готово! Вот он, снежный сторож! Он не мёрзнет и никогда не спит!","vocal":false},{"t":216.177,"dur":1.13,"who":"К104","name":"Топа","text":"Повезло́ ему́.","vocal":false},{"t":217.758,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":220.352,"dur":1.222,"who":"К101","name":"Барсик","text":"А ну, кто поймает?","vocal":false},{"t":222.973,"dur":3.365,"who":"К103","name":"Рон","text":"Поймал! Я быстрый сторож!","vocal":false},{"t":227.738,"dur":0.646,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":228.505,"dur":0.445,"who":"К102","name":"Пик","text":"Мимо!","vocal":false},{"t":229.25,"dur":1.96,"who":"К103","name":"Рон","text":"Это я ему́ показал, как надо.","vocal":false},{"t":235.31,"dur":4.262,"who":"К104","name":"Топа","text":"Тёплое молоко. И сразу хочется спать.","vocal":false},{"t":239.872,"dur":3.427,"who":"К101","name":"Барсик","text":"Нам тепло в доме. А ростку тепло под снегом.","vocal":false},{"t":243.599,"dur":3.122,"who":"К103","name":"Рон","text":"А наш снежный сторож? Ему́ тоже тепло?","vocal":false},{"t":247.021,"dur":2.718,"who":"К104","name":"Топа","text":"Ему́ нельзя гре́ться. Он раста́ет.","vocal":false},{"t":250.039,"dur":3.1,"who":"К103","name":"Рон","text":"Тогда пусть ему́ будет холодно! Самую чуточку.","vocal":false},{"t":253.589,"dur":1.883,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":256.972,"dur":3.386,"who":"К105","name":"Филя","text":"Давайте поиграем! Я спрашиваю, а вы отвечаете.","vocal":false},{"t":260.658,"dur":0.743,"who":"К101","name":"Барсик","text":"Начинай!","vocal":false},{"t":261.701,"dur":2.245,"who":"К105","name":"Филя","text":"Почему росток под снегом не замё́рз?","vocal":false},{"t":267.246,"dur":1.812,"who":"К102","name":"Пик","text":"Его укрыл снег, как одеяло.","vocal":false},{"t":269.358,"dur":1.986,"who":"К105","name":"Филя","text":"Правильно! А кто спит всю зи́му?","vocal":false},{"t":274.644,"dur":2.275,"who":"К104","name":"Топа","text":"Медве́ди. И я.","vocal":false},{"t":277.219,"dur":2.055,"who":"К105","name":"Филя","text":"А почему ёлка зимой зелёная?","vocal":false},{"t":282.575,"dur":2.452,"who":"К101","name":"Барсик","text":"У неё иголки. Им мороз не страшен.","vocal":false},{"t":285.326,"dur":1.693,"who":"К103","name":"Рон","text":"А кто никогда не спит?","vocal":false},{"t":287.32,"dur":0.517,"who":"К105","name":"Филя","text":"Кто?","vocal":false},{"t":288.137,"dur":3.842,"who":"К103","name":"Рон","text":"Снежный сторож! И я! Почти.","vocal":false},{"t":292.279,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха!","vocal":true},{"t":292.279,"dur":1.164,"who":"К101","name":"Барсик","text":"Ха-ха-ха-ха!","vocal":true},{"t":292.279,"dur":1.509,"who":"К102","name":"Пик","text":"Ха-ха-ха-ха!","vocal":true},{"t":292.279,"dur":1.233,"who":"К104","name":"Топа","text":"Ха-ха-ха!","vocal":true},{"t":292.279,"dur":1.758,"who":"К103","name":"Рон","text":"Ха-ха-ха!","vocal":true},{"t":296.293,"dur":3.05,"who":"К103","name":"Рон","text":"Вот наш росток. Спит под одеялом.","vocal":false},{"t":299.642,"dur":1.994,"who":"К101","name":"Барсик","text":"А вот и снеговик. Сторожит.","vocal":false},{"t":301.937,"dur":3.714,"who":"К103","name":"Рон","text":"Мы с ним вдвоём. Я и мой помощник.","vocal":false},{"t":306.7,"dur":1.579,"who":"К103","name":"Рон","text":"А-а-а-ах.","vocal":true},{"t":308.55,"dur":1.716,"who":"К103","name":"Рон","text":"Сторож, ты точно не спишь?","vocal":false},{"t":310.566,"dur":2.819,"who":"К105","name":"Филя","text":"Он молчит. Значит, сторожит.","vocal":false},{"t":313.686,"dur":3.377,"who":"К103","name":"Рон","text":"Тогда я закрою один глаз. Только один.","vocal":false},{"t":318.163,"dur":1.904,"who":"К101","name":"Барсик","text":"Спокойной ночи, сторож.","vocal":false},{"t":321.767,"dur":1.503,"who":"Р","name":"Рассказчик","text":"Снег кончился.","vocal":false},{"t":324.17,"dur":4.634,"who":"К103","name":"Рон","text":"Я не спал! Я сторожил вместе с помощником!","vocal":false},{"t":329.254,"dur":1.894,"who":"К105","name":"Филя","text":"Ха-ха-ха-ха!","vocal":true},{"t":331.248,"dur":2.643,"who":"К105","name":"Филя","text":"Ура, со́лнце вышло! Сегодня оно́ гре́ет.","vocal":false},{"t":334.191,"dur":3.377,"who":"К101","name":"Барсик","text":"Смотри́те, вот наш снеговик. Он блестит на со́лнце.","vocal":false},{"t":337.868,"dur":2.466,"who":"К101","name":"Барсик","text":"Если станет тепло, снег начнёт таять.","vocal":false},{"t":340.634,"dur":2.305,"who":"К103","name":"Рон","text":"А мой сторож? Он же снежный!","vocal":false},{"t":343.239,"dur":2.329,"who":"К104","name":"Топа","text":"Ой. Он тоже раста́ет?","vocal":false},{"t":345.868,"dur":2.327,"who":"К103","name":"Рон","text":"Не отдам! Он мой сторож!","vocal":false},{"t":348.494,"dur":2.642,"who":"К101","name":"Барсик","text":"Не знаю, Рон. Это новая загадка.","vocal":false},{"t":351.436,"dur":2.267,"who":"К101","name":"Барсик","text":"Завтра узнаем, куда уходят снеговики.","vocal":false},{"t":355.603,"dur":7.594,"who":"К103","name":"Рон","text":"Понравился мультик? Попроси маму или папу поставить лайк и подписаться на канал. До встречи в новой серии!","vocal":false}],"segs":[{"t0":0,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"noSnowman\":true,\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":53.222,"kind":"title","loc":""},{"t0":56.222,"kind":"scene","loc":"{\"id\":\"Л102\",\"name\":\"комната, день\",\"seed\":102,\"snowOut\":true,\"time\":\"day\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":140.585,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"noSnowman\":true,\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":205.469,"kind":"scene","loc":"{\"id\":\"Л101\",\"name\":\"зима, утро\",\"noSnowman\":true,\"seed\":101,\"time\":\"day\",\"type\":\"winter\",\"weather\":\"none\"}"},{"t0":232.31,"kind":"scene","loc":"{\"id\":\"Л103\",\"name\":\"кухня, вечер\",\"seed\":103,\"snowOut\":true,\"time\":\"evening\",\"type\":\"kitchen\",\"weather\":\"none\"}"},{"t0":256.372,"kind":"scene","loc":"{\"id\":\"Л104\",\"name\":\"комната, вечер\",\"seed\":104,\"snowOut\":true,\"time\":\"evening\",\"type\":\"room\",\"weather\":\"none\"}"},{"t0":295.093,"kind":"scene","loc":"{\"id\":\"Л105\",\"name\":\"зима, ночь\",\"noSnowman\":true,\"seed\":