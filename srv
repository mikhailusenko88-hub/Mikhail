#!/bin/bash
# srv — проверки сервера для «Команд» на iPhone (кнопки «Сервер»).
#   srv status — сервер, память, диск, VPN
#   srv bot    — последние заезды бота «Білесің бе?»
#   srv race mushel — выложить гонку прямо сейчас (cities | regions | mushel | names)
#   srv name Айгерім — добавить имя в следующий заезд с именами
#   srv comment — оставить первый комментарий под последним роликом
#   srv yt-login — войти в YouTube заново (с правом на комментарии)
#   srv speed  — скорость интернета самого сервера
#   srv update — обновить srv из GitHub
BOT=/root/kz-bot
case "${1:-status}" in
  status)
    echo "Сервер работает: $(uptime -p | sed 's/^up //')"
    echo "Нагрузка: $(cut -d' ' -f1 /proc/loadavg)"
    free -m | awk '/^Mem/{printf "Память: занято %d из %d МБ\n",$3,$2} /^Swap/{printf "Запасная память: занято %d из %d МБ\n",$3,$2}'
    df -h / | awk 'NR==2{print "Диск: занято "$3" из "$2}'
    echo "VPN:"
    docker ps --format '  {{.Names}} — {{.Status}}' 2>/dev/null | sed 's/Up /работает /'
    echo "TCP: $(sysctl -n net.ipv4.tcp_congestion_control)"
    ;;
  bot)
    if [ -f "$BOT/bot.log" ]; then
      grep -E "Заезд №|YouTube|комментарий|ошибка|Сбой|Killed|не собралась" "$BOT/bot.log" | tail -10 | cut -c1-200
    else
      echo "Не нашёл $BOT/bot.log"
    fi
    ;;
  race)
    L="${2:-cities}"
    case "$L" in cities|regions|mushel|names) ;; *) echo "Темы: cities | regions | mushel | names"; exit 1;; esac
    if pgrep -f "run_daily.py" >/dev/null; then echo "Бот уже делает ролик — подожди пару минут"; exit 0; fi
    PY=python3; [ -x "$BOT/.venv/bin/python" ] && PY="$BOT/.venv/bin/python"
    cd "$BOT" && nohup "$PY" run_daily.py --league "$L" >> bot.log 2>&1 &
    echo "Запустил: $L. Ролик выйдет минуты через 3–5. Проверить: srv bot"
    ;;
  comment)
    PY=python3; [ -x "$BOT/.venv/bin/python" ] && PY="$BOT/.venv/bin/python"
    cd "$BOT" && "$PY" race_bot.py comment
    ;;
  yt-login)
    PY=python3; [ -x "$BOT/.venv/bin/python" ] && PY="$BOT/.venv/bin/python"
    cd "$BOT" && "$PY" yt_upload.py --login-start
    ;;
  name)
    shift
    [ -n "${1:-}" ] || { echo "Напиши имя: srv name Айгерім"; exit 1; }
    echo "$*" >> "$BOT/names_requests.txt" && echo "Добавил: $* — будет в следующем заезде с именами"
    ;;
  speed)
    curl -s -o /dev/null -w "%{speed_download}" --max-time 15 "https://speed.cloudflare.com/__down?bytes=50000000" \
      | awk '{printf "Скорость сервера: %.0f Мбит/с\n", $1*8/1000000}'
    ;;
  update)
    curl -fsSL https://raw.githubusercontent.com/mikhailusenko88-hub/Mikhail/kz-bot/srv -o /usr/local/bin/srv.new \
      && chmod +x /usr/local/bin/srv.new && mv /usr/local/bin/srv.new /usr/local/bin/srv && echo "srv обновлён"
    ;;
  *)
    echo "Есть: srv status | srv bot | srv race <тема> | srv name <имя> | srv comment | srv yt-login | srv speed | srv update"
    ;;
esac
