  {
   "i": 38,
   "t0": 107.01,
   "t1": 108.25,
   "text": "А как тебя зовут?"
  },
  {
   "i": 39,
   "t0": 108.77,
   "t1": 110.57,
   "text": "Филя Хочешь с нами поиграть?"
  },
  {
   "i": 40,
   "t0": 110.97,
   "t1": 111.59,
   "text": "Просто так?"
  },
  {
   "i": 41,
