  {
   "i": 51,
   "t0": 142.15,
   "t1": 143.35,
   "text": "Ты прыгнул выше всех."
  },
  {
   "i": 52,
   "t0": 143.79,
   "t1": 145.25,
   "text": "Значит, вы выберете меня?"
  },
  {
   "i": 53,
   "t0": 146.69,
   "t1": 147.17,
   "text": "Для чего?"
  },
  {
   "i": 54,
   "t0": 148.07,
   "t1": 148.99,
   "text": "Ну, потом."
  },
  {
   "i": 55,
   "t0": 151.48,
   "t1": 152.32,
   "text": "Я умею делать кувырок."
  },
  {
   "i": 56,
   "t0": 152.88,
   "t1": 153.18,
   "text": "Как?"
  },
  {
   "i": 57,
   "t0": 156.86,
   "t1": 158.02,
   "text": "Кувырок я не умею."
  },
  {
   "i": 58,
   "t0": 158.34,
   "t1": 159.6,
   "text": "Его не обязательно уметь."
  },
  {
   "i": 59,
   "t0": 160.02,
   "t1": 161.54,
   "text": "Но вдруг это важнее прыжков?"
  },
  {
   "i": 60,
   "t0": 161.54,
   "t1": 164.12,
   "text": "Для игр с ничем вообще не нужны кувырки."
  },
  {
   "i": 61,
   "t0": 164.42,
   "t1": 165.32,
   "text": "Давай лучше мяч."
  },
  {
   "i": 62,
   "t0": 166.18,
   "t1": 167.72,
   "text": "Держи, это мой любимый."
  },
  {
   "i": 63,
   "t0": 173.26,
   "t1": 174.02,
   "text": "Укатился."
  },
  {
   "i": 64,
   "t0": 174.36,
   "t1": 174.8,
   "text": "Угу."
  },
  {
   "i": 65,
   "t0": 175.18,
   "t1": 175.42,
   "text": "Ой."
  },
  {
   "i": 66,
   "t0": 176.48,
   "t1": 176.82,
   "text": "Куда?"
  },
  {
   "i": 67,
   "t0": 178.89,
   "t1": 179.71,
   "text": "Пронул леса."
  },
  {
   "i": 68,
   "t0": 180.03,
   "t1": 182.55,
   "text": "Я слишком сильно пнул, прости."
  },
  {
   "i": 69,
   "t0": 184.21,
   "t1": 186.43,
   "text": "Я же сказал, что он любимый."
  },
  {
   "i": 70,
   "t0": 187.17,
   "t1": 188.45,
   "text": "Давайте сразу поищем."
  },
  {
   "i": 71,
   "t0": 188.83,
   "t1": 189.51,
   "text": "Я помогу."
  },
  {
   "i": 72,
   "t0": 189.91,
   "t1": 191.21,
   "text": "Ладно, только скорее."
  },
  {
   "i": 73,
   "t0": 197.9,
   "t1": 199.6,
   "text": "Подарок остался на поляне."
  },
  {
   "i": 74,
   "t0": 200.46,
   "t1": 202.9,
   "text": "Сейчас друзьям было важнее найти мяч."
