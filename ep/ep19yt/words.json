   "i": 99,
   "t0": 255.94,
   "t1": 256.54,
   "text": "Круглый."
  },
  {
   "i": 100,
   "t0": 256.84,
   "t1": 257.12,
   "text": "И мой."
  },
  {
   "i": 101,
   "t0": 257.68,
   "t1": 259.38,
   "text": "Последние приметы самое важное."
  },
  {
   "i": 102,
   "t0": 263.6,
   "t1": 265.08,
   "text": "Спасибо, что помогал."
  },
  {
   "i": 103,
   "t0": 265.88,
   "t1": 267.54,
   "text": "Как хорошо, что он нашёлся."
  },
  {
   "i": 104,
   "t0": 267.96,
   "t1": 269.66,
   "text": "Вы могли продолжить играть без меня."
  },
  {
   "i": 105,
   "t0": 270.18,
   "t1": 271.02,
   "text": "Но ты искал мяч."
  },
  {
   "i": 106,
   "t0": 271.4,
   "t1": 274.24,
   "text": "А играть одному с потерянный мяч совсем неудобно."
  },
  {
   "i": 107,
   "t0": 274.24,
   "t1": 275.74,
   "text": "Ха -ха -ха!"
  },
  {
   "i": 108,
   "t0": 276.5,
   "t1": 277.1,
   "text": "Мне"
  },
  {
   "i": 109,
   "t0": 278.6,
   "t1": 279.94,
   "text": "нужно вам кое -что сказать."
  },
  {
   "i": 110,
   "t0": 280.44,
   "t1": 281.2,
   "text": "Мы слушаем."
