  {
   "i": 112,
   "t0": 284.54,
   "t1": 285.06,
   "text": "Ого!"
  },
  {
   "i": 113,
   "t0": 285.32,
   "t1": 286.38,
   "text": "Наш тайный зритель!"
  },
  {
   "i": 114,
   "t0": 286.76,
   "t1": 287.9,
   "text": "Почему ты сразу не сказал?"
  },
  {
   "i": 115,
   "t0": 288.4,
   "t1": 291.0,
   "text": "Хотел посмотреть, кто из вас самый лучший друг."
  },
  {
   "i": 116,
   "t0": 291.4,
   "t1": 292.46,
   "text": "И кому подарить подарок?"
  },
  {
   "i": 117,
   "t0": 293.42,
   "t1": 297.0,
   "text": "А потом подумал, что сначала сам должен стать самым лучшим."
  },
  {
   "i": 118,
   "t0": 297.74,
   "t1": 299.28,
   "text": "Поэтому ты показывал прыжки."
  },
  {
   "i": 119,
   "t0": 299.7,
   "t1": 301.42,
   "text": "Да, но Рон умеет кувыркаться."
  },
  {
   "i": 120,
   "t0": 301.7,
   "t1": 302.62,
   "text": "Пик всё замечает."
  },
  {
   "i": 121,
   "t0": 302.76,
   "t1": 303.78,
   "text": "Ты всё придумываешь."
  },
  {
   "i": 122,
   "t0": 303.78,
   "t1": 305.62,
   "text": "А я потерял твой мяч."
  },
  {
   "i": 123,
   "t0": 306.1,
   "t1": 307.32,
   "text": "Зато ты остался со мной."
  },
  {
   "i": 124,
   "t0": 308.8,
   "t1": 309.7,
   "text": "Я запутался."
  },
  {
   "i": 125,
   "t0": 309.86,
   "t1": 310.92,
   "text": "Кого мне выбирать?"
  },
  {
   "i": 126,
   "t0": 312.75,
   "t1": 313.71,
   "text": "А зачем выбирать?"
  },
  {
   "i": 127,
   "t0": 314.11,
   "t1": 315.97,
   "text": "Разве можно дружить сразу со всеми?"
  },
  {
   "i": 128,
   "t0": 316.31,
   "t1": 317.49,
   "text": "Мы ведь уже играли вместе."
  },
  {
   "i": 129,
   "t0": 317.95,
   "t1": 319.19,
   "text": "И вместе искали мяч."
  },
  {
   "i": 130,
   "t0": 319.57,
   "t1": 322.41,
   "text": "А мне с вами."
  },
  {
   "i": 131,
   "t0": 322.95,
   "t1": 324.19,
   "text": "Тогда возвращаемся."
  },
  {
   "i": 132,
   "t0": 324.41,
   "t1": 325.79,
   "text": "Подарок там совсем один."
  },
  {
   "i": 133,
   "t0": 346.62,
   "t1": 348.58,
   "text": "Хотите узнать, что я вам подарил?"
  },
  {
   "i": 134,
   "t0": 349.04,
   "t1": 350.34,
   "text": "Я готов удивляться."
  },
  {
   "i": 135,
   "t0": 350.82,
   "t1": 351.9,
   "text": "Ты уже удивляешься."
  },
  {
   "i": 136,
   "t0": 351.9,
   "t1": 352.74,
   "text": "Правда?"
  },
  {
   "i": 137,
   "t0": 353.18,
   "t1": 355.9,
   "text": "Немного позже секрет подарка был раскрыт."
  },
  {
   "i": 138,
   "t0": 357.18,
   "t1": 358.56,
   "text": "Мой подарок – книга игр."
  },
  {
   "i": 139,
   "t0": 358.98,
   "t1": 360.8,
   "text": "Эта книга раньше была у моего дедушки."
  },
  {
   "i": 140,
   "t0": 361.3,
   "t1": 362.22,
   "text": "Он тоже любил играть?"
  },
  {
