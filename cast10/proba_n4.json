{"target": "n4", "title": "№4", "name": "svoy_golos", "slot": "kbd_eduard", "held": ["Оказывается, верблюд хранит в горбу не воду, а жир.", "Летучие мыши совсем не слепые, они отлично видят в сумерках.", "Этот мост строили почти пять тысяч дней, и он до сих пор стоит.", "Первый орёл, второй беркут, третий сокол.", "Учёные до сих пор спорят, зачем зебре полоски.", "Каждая минута стоит мозгу почти двух миллионов клеток.", "Заражённый муравей покидает гнездо и лезет на растение.", "С сорок девятого года здесь провели четыреста пятьдесят шесть взрывов.", "Он избавляется от сводных братьев в первые часы жизни.", "Ею переболела примерно треть людей на планете."], "f0_target": 84.1, "target_quality": {"match": 0.86, "utmos": 3.46}, "base": {"close": 0.4635, "sims": {"ecapa": 0.578, "wavlm": 0.947, "resem": 0.861}, "man": 0.2396, "mel": 0.773, "ritm": 0.562, "dur": 0.281, "razmah": 0.06, "rms": 1.973, "f0": 87.8, "pt": 0.74, "match": 0.96, "utmos": 3.56}, "table": [{"spe_from": "основа", "man_from": "основа", "rate": "medium", "close": 0.4635, "sims": {"ecapa": 0.578, "wavlm": 0.947, "resem": 0.861}, "man": 0.2396, "mel": 0.773, "ritm": 0.562, "dur": 0.281, "razmah": 0.06, "rms": 1.973, "f0": 87.8, "pt": 0.74, "match": 0.96, "utmos": 3.56}, {"spe_from": "opt_n4_1d", "man_from": "основа", "rate": "medium", "close": 0.8403, "sims": {"ecapa": 0.827, "wavlm": 0.986, "resem": 0.93}, "man": 0.2515, "mel": 0.784, "ritm": 0.595, "dur": 0.278, "razmah": 0.096, "rms": 1.918, "f0": 91.5, "pt": 1.46, "match": 0.938, "utmos": 3.48, "coef_path": [[5.137, 92.1], [6.677, 92.1]], "J": 0.9372}, {"spe_from": "opt_n4_1d", "man_from": "man_n4_1_fast", "rate": "fast", "close": 0.8922, "sims": {"ecapa": 0.842, "wavlm": 0.994, "resem": 0.944}, "man": 0.3887, "mel": 0.769, "ritm": 0.647, "dur": 0.026, "razmah": 0.053, "rms": 1.932, "f0": 88.1, "pt": 0.81, "match": 0.863, "utmos": 3.42, "coef_path": [[5.972, 91.7], [7.763, 91.7]], "J": 1.0547}, {"spe_from": "opt_n4_1d", "man_from": "man_n4_1_medium"