{"target": "n4", "title": "№4", "name": "svoy_golos", "slot": "kbd_eduard", "held": ["Оказывается, верблюд хранит в горбу не воду, а жир.", "Летучие мыши совсем не слепые, они отлично видят в сумерках.", "Этот мост строили почти пять тысяч дней, и он до сих пор стоит.", "Первый орёл, второй беркут, третий сокол.", "Учёные до сих пор спорят, зачем зебре полоски.", "Каждая минута стоит мозгу почти двух миллионов клеток.", "Заражённый муравей покидает гнездо и лезет на растение.", "С сорок девятого года здесь провели четыреста пятьдесят шесть взрывов.", "Он избавляется от сводных братьев в первые часы жизни.", "Ею переболела примерно треть людей на планете."], "f0_target": 84.1, "target_quality": {"match": 0.86, "utmos": 3.46}, "base": {"close": 0.4635, "sims": {"ecapa": 0.578, "wavlm": 0.947, "resem": 0.861}, "man": 0.2396, "mel": 0.773, "ritm": 0.562, "dur": 0.281, "razmah": 0.06, "rms": 1.973, "f0": 87.8, "pt": 0.74, "match": 0.96, "utmos": 3.56}, "table": [{"spe_from": "основа", "man_from": "основа", "rate": "medium", "close": 0.4635, "sims": {"ecapa": 0.578, "wavlm": 0.947, "resem": 0.861}, "man": 0.2396, "mel": 0.773, "ritm": 0.562, "dur": 0.281, "razmah": 0.06, "rms": 1.973, "f0": 87.8, "pt": 0.74, "match": 0.96, "utmos": 3.56}, {"spe_from": "opt_n4_1b", "man_from": "основа", "rate": "medium", "close": 0.8179, "sims": {"ecapa": 0.822, "wavlm": 0.986, "resem": 0.906}, "man": 0.2653, "mel": 0.797, "ritm": 0.602, "dur": 0.278, "razmah": 0.074, "rms": 1.839, "f0": 91.3, "pt": 1.42, "match": 0.909, "utmos": 3.39, "coef_path": [[5.137, 91.8], [6.677, 91.8]], "J": 0.911}, {"spe_from": "opt_n4_1b", "man_from": "man_n4_1_fast", "rate": "fast", "close": 0.8475, "sims": {"ecapa": 0.82, "wavlm": 0.992, "resem": 0.918}, "man": 0.3976, "mel": 0.778, "ritm": 0.659, "dur": 0.025, "razmah": 0.023, "rms": 1.857, "f0": 87.3, "pt": 0.64, "match": 0.822, "utmos": 3.28, "coef_path": [[5.972, 89.2], [7.763, 89.2]], "J": 0.9646}, {"spe_from": "opt_n4_1b", "man_from": "man_n4_1_medium",