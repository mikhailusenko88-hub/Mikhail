{"target": "pik", "title": "голос Apple — Пик (только мерка)", "name": "svoy_pik", "slot": "bak_ramilia", "held": ["Ночью на улице мороз. Всё замерзает.", "Он называется иней. Бывает, когда ночью сильный мороз.", "В воздухе есть вода. Совсем маленькие капельки. Их не видно.", "Да. Ночью они замерзают. И садятся на всё холодное.", "Они всю ночь стояли на морозе. Вот и примёрзли.", "А ночью мороз нарисует новые узоры. Прямо поверх.", "Это новая загадка. Завтра посмотрим на снежинки в лупу!", "Оказывается, верблюд хранит в горбу не воду, а жир.", "Летучие мыши совсем не слепые, они отлично видят в сумерках.", "Этот мост строили почти пять тысяч дней, и он до сих пор стоит."], "f0_target": 211.5, "target_quality": {"match": 1.0, "utmos": 2.58}, "base": {"close": 0.2105, "sims": {"ecapa": 0.373, "wavlm": 0.945, "resem": 0.738}, "man": 0.1925, "mel": 0.702, "ritm": 0.394, "dur": 0.215, "razmah": -0.023, "rms": 2.034, "f0": 207.6, "pt": -0.32, "match": 1.0, "utmos": 3.5}, "table": [{"spe_from": "основа", "man_from": "основа", "rate": "medium", "close": 0.2105, "sims": {"ecapa": 0.373, "wavlm": 0.945, "resem": 0.738}, "man": 0.1925, "mel": 0.702, "ritm": 0.394, "dur": 0.215, "razmah": -0.023, "rms": 2.034, "f0": 207.6, "pt": -0.32, "match": 1.0, "utmos": 3.5}, {"spe_from": "opt_pik_1d", "man_from": "основа", "rate": "medium", "close": 0.7364, "sims": {"ecapa": 0.691, "wavlm": 0.99, "resem": 0.906}, "man": 0.194, "mel": 0.69, "ritm": 0.425, "dur": 0.212, "razmah": -0.003, "rms": 2.017, "f0": 200.3, "pt": -0.94, "match": 0.979, "utmos": 3.65, "J": 0.8202}, {"spe_from": "opt_pik_1d", "man_from": "man_pik_1_fast", "rate": "fast", "close": 0.7404, "sims": {"ecapa": 0.698, "wavlm": 0.988, "resem": 0.914}, "man": 0.3884, "mel": 0.751, "ritm": 0.639, "dur": 0.048, "razmah": 0.021, "rms": 1.766, "f0": 203.6, "pt": -0.66, "match": 0.938, "utmos": 3.43, "J": 0.8778}, {"spe_from": "opt_pik_1d", "man_from": "man_pik_1_medium", "rate": "medium", "close": 0.743, "sims": {"ecapa": 0.689, "