{
 "dur": 345.838,
 "src": "ep-27t-540.mp4",
 "lines": [
  {
   "i": 0,
   "t": 1.5,
   "bdur": 2.42,
   "name": "S2",
   "text": "Гульд, камень утонул.",
   "vocal": false,
   "f0": 326,
   "soft": false
  },
  {
   "i": 1,
   "t": 4.0,
   "bdur": 2.8,
   "name": "S2",
   "text": "Смотрите, а вот лодка, большая, и не тонет.",
   "vocal": false,
   "f0": 349,
   "soft": false
  },
  {
   "i": 2,
   "t": 6.92,
   "bdur": 0.74,
   "name": "S2",
   "text": "Нечестно,",
   "vocal": false,
   "f0": 256,
   "soft": false
  },
  {
   "i": 3,
   "t": 7.9,
   "bdur": 3.04,
   "name": "S2",
   "text": "маленький камень тонет, а большая лодка плавает.",
   "vocal": false,
   "f0": 308,
   "soft": false
  },
  {
   "i": 4,
   "t": 11.12,
   "bdur": 0.96,
   "name": "S5",
   "text": "Почему так?",
   "vocal": false,
   "f0": 192,
   "soft": false
  },
  {
   "i": 5,
   "t": 12.58,
   "bdur": 1.98,
   "name": "S2",
   "text": "Ха-ха-ха!",
   "vocal": true,
   "f0": 353,
   "soft": false
  },
  {
   "i": 6,
   "t": 16.25,
   "bdur": 1.78,
   "name": "S2",
   "text": "Рон, а зонтик зачем?",
   "vocal": false,
   "f0": 304,
   "soft": false
  },
  {
   "i": 7,
   "t": 18.29,
   "bdur": 4.1,
   "name": "S2",
   "text": "Мы раскрываем секрет лодки, вдруг секрет окажется мокрым.",
   "vocal": false,
   "f0": 310,
   "soft": false
  },
  {
   "i": 8,
   "t": 22.43,
   "bdur": 2.5,
   "name": "S2",
   "text": "Даже кепку приготовился защищать.",
   "vocal": false,
   "f0": 302,
   "soft": false
  },
  {
   "i": 9,
   "t": 25.05,
   "bdur": 2.04,
   "name": "S2",
   "text": "Конечно, она плавать не умеет.",
   "vocal": false,
   "f0": 287,
   "soft": false
  },
  {
   "i": 10,
   "t": 27.92,
   "bdur": 3.22,
   "name": "S2",
   "text": "Может, лодка училась плавать, а камень прогуливал.",
   "vocal": false,
   "f0": 318,
   "soft": false
  },
  {
   "i": 11,
   "t": 30.94,
   "bdur": 1.54,
   "name": "S4",
   "text": "Ах-ха-ха!",
   "vocal": true,
   "f0": 227,
   "soft": false
  },
  {
   "i": 12,
   "t": 32.6,
   "bdur": 1.54,
   "name": "S3",
   "text": "Тогда кто учил лодку?",
   "vocal": false,
   "f0": 270,
   "soft": false
  },
  {
   "i": 13,
   "t": 35.99,
   "bdur": 1.62,
   "name": "S2",
   "text": "Очень терпеливая рыба.",
   "vocal": false,
   "f0": 319,
   "soft": false
  },
  {
   "i": 14,
   "t": 37.71,
   "bdur": 2.96,
   "name": "S2",
   "text": "Давайте найдем объяснение, которое можно проверить.",
   "vocal": false,
   "f0": 394,
   "soft": false
  },
  {
   "i": 15,
   "t": 45.51,
   "bdur": 2.24,
   "name": "S4",
   "text": "Вот точно такой же камень, как утонул.",
   "vocal": false,
   "f0": 221,
   "soft": false
  },
  {
   "i": 16,
   "t": 48.89,
   "bdur": 0.84,
   "name": "S2",
   "text": "Здравствуйте,",
   "vocal": false,
   "f0": 266,
   "soft": false
  },
  {
   "i": 17,
   "t": 49.91,
   "bdur": 1.84,
   "name": "S2",
   "text": "сегодня вопросов будет больше.",
   "vocal": false,
   "f0": 307,
   "soft": false
  },
  {
   "i": 18,
   "t": 52.09,
   "bdur": 3.48,
   "name": "S2",
   "text": "Он маленький, но тяжелый для своего размера.",
   "vocal": false,
   "f0": 274,
   "soft": false
  },
  {
   "i": 19,
   "t": 55.57,
   "bdur": 1.38,
   "name": "S6",
   "text": "А лодка большая,",
   "vocal": false,
   "f0": 161,
   "soft": false
  },
  {
   "i": 20,
   "t": 57.27,
   "bdur": 1.44,
   "name": "S6",
   "text": "и еще людей возит.",
   "vocal": false,
   "f0": 150,
   "soft": false
  },
  {
   "i": 21,
   "t": 58.85,
   "bdur": 2.22,
   "name": "S2",
   "text": "Значит, одного размера для ответа мало.",
   "vocal": false,
   "f0": 377,
   "soft": false
  },
  {
   "i": 22,
   "t": 61.78,
   "bdur": 1.52,
   "name": "S3",
   "text": "Из чего делают лодки?",
   "vocal": false,
   "f0": 240,
   "soft": false
  },
  {
   "i": 23,
   "t": 66.54,
   "bdur": 1.08,
   "name": "S6",
   "text": "Из дерева.",
   "vocal": false,
   "f0": 164,
   "soft": false
  },
  {
   "i": 24,
   "t": 67.66,
   "bdur": 1.88,
   "name": "S2",
   "text": "Разгадали, дерево плавает.",
   "vocal": false,
   "f0": 266,
   "soft": false
  },
  {
   "i": 25,
   "t": 69.34,
   "bdur": 2.52,
   "name": "S2",
   "text": "Но бывают и металлические корабли.",
   "vocal": false,
   "f0": 342,
   "soft": false
  },
  {
   "i": 26,
   "t": 71.88,
   "bdur": 2.7,
   "name": "S2",
   "text": "Ого, металлические, как ложка.",
   "vocal": false,
   "f0": 298,
   "soft": false
  },
  {
   "i": 27,
   "t": 74.84,
   "bdur": 3.42,
   "name": "S2",
   "text": "Да, обычная металлическая ложка тонет, а корабль может плавать.",
   "vocal": false,
   "f0": 373,
   "soft": false
  },
  {
   "i": 28,
   "t": 78.5,
   "bdur": 3.16,
   "name": "S2",
   "text": "Тогда надо искать другую подсказку.",
   "vocal": false,
   "f0": 292,
   "soft": false
  },
  {
   "i": 29,
   "t": 82.8,
   "bdur": 4.22,
   "name": "S6",
   "text": "Друзья отправились на кухню сравнить знакомые предметы.",
   "vocal": false,
   "f0": 165,
   "soft": false
  },
  {
   "i": 30,
   "t": 87.56,
   "bdur": 2.46,
   "name": "S2",
   "text": "Чем не корабль, даже длинный хвост есть.",
   "vocal": false,
   "f0": 317,
   "soft": false
  },
  {
   "i": 31,
   "t": 90.79,
   "bdur": 2.28,
   "name": "S6",
   "text": "А это похоже на круглую лодку.",
   "vocal": false,
   "f0": 161,
   "soft": false
  },
  {
   "i": 32,
   "t": 93.23,
   "bdur": 1.88,
   "name": "S2",
   "text": "У нее есть дно и стенки,",
   "vocal": false,
   "f0": 291,
   "soft": false
  },
  {
   "i": 33,
   "t": 95.29,
   "bdur": 1.76,
   "name": "S2",
   "text": "а внутри свободное место.",
   "vocal": false,
   "f0": 283,
   "soft": false
  },
  {
   "i": 34,
   "t": 97.57,
   "bdur": 1.74,
   "name": "S2",
   "text": "И обед далеко искать не надо.",
   "vocal": false,
   "f0": 313,
   "soft": false
  },
  {
   "i": 35,
   "t": 99.65,
   "bdur": 1.08,
   "name": "S2",
   "text": "Ах-ха-ха!",
   "vocal": true,
   "f0": 209,
   "soft": false
  },
  {
   "i": 36,
   "t": 100.53,
   "bdur": 1.96,
   "name": "S5",
   "text": "Если туда налить суп,",
   "vocal": false,
   "f0": 196,
   "soft": false
  },
  {
   "i": 37,
   "t": 102.69,
   "bdur": 1.96,
   "name": "S6",
   "text": "свободного места станет меньше.",
   "vocal": false,
   "f0": 161,
   "soft": false
  },
  {
   "i": 38,
   "t": 104.89,
   "bdur": 1.46,
   "name": "S2",
   "text": "Филя заметил важное отличие.",
   "vocal": false,
   "f0": 373,
   "soft": false
  },
  {
   "i": 39,
   "t": 106.35,
   "bdur": 1.58,
   "name": "S2",
   "text": "Корабль внутри тоже не сплошной.",
   "vocal": false,
   "f0": 397,
   "soft": false
  },
  {
   "i": 40,
   "t": 108.17,
   "bdur": 2.06,
   "name": "S3",
   "text": "Но почему это помогает ему плавать?",
   "vocal": false,
   "f0": 266,
   "soft": false
  },
  {
   "i": 41,
   "t": 111.56,
   "bdur": 1.06,
   "name": "S2",
   "text": "Пока не знаю.",
   "vocal": false,
   "f0": 277,
   "soft": false
  },
  {
   "i": 42,
   "t": 112.84,
   "bdur": 1.6,
   "name": "S2",
   "text": "У меня есть книга о кораблях.",
   "vocal": false,
   "f0": 379,
   "soft": false
  },
  {
   "i": 43,
   "t": 114.32,
   "bdur": 0.86,
   "name": "S2",
   "text": "Поищем ответ.",
   "vocal": false,
   "f0": 368,
   "soft": false
  },
  {
   "i": 44,
   "t": 115.5,
   "bdur": 3.42,
   "name": "S2",
   "text": "Хорошо, кастрюля все равно ничего не рассказывает.",
   "vocal": false,
   "f0": 304,
   "soft": false
  },
  {
   "i": 45,
   "t": 126.84,
   "bdur": 3.76,
   "name": "S2",
   "text": "Вода выталкивает погруженные в нее предметы вверх.",
   "vocal": false,
   "f0": 284,
   "soft": false
  },
  {
   "i": 46,
   "t": 130.58,
   "bdur": 0.96,
   "name": "S2",
   "text": "Даже камень?",
   "vocal": false,
   "f0": 326,
   "soft": false
  },
  {
   "i": 47,
   "t": 131.78,
   "bdur": 2.06,
   "name": "S2",
   "text": "Даже камень, но он держать его не может.",
   "vocal": false,
   "f0": 366,
   "soft": false
  },
  {
   "i": 48,
   "t": 138.5,
   "bdur": 1.8,
   "name": "S4",
   "text": "Корпус корабля делают полом.",
   "vocal": false,
   "f0": 216,
   "soft": false
  },
  {
   "i": 49,
   "t": 140.34,
   "bdur": 1.92,
   "name": "S4",
   "text": "Внутри остается место для воздуха.",
   "vocal": false,
   "f0": 213,
   "soft": false
  },
  {
   "i": 50,
   "t": 142.06,
   "bdur": 1.2,
   "name": "S6",
   "text": "Значит,",
   "vocal": false,
   "f0": 177,
   "soft": false
  },
  {
   "i": 51,
   "t": 143.7,
   "bdur": 2.46,
   "name": "S6",
   "text": "большой корабль не набит металлом целиком.",
   "vocal": false,
   "f0": 158,
   "soft": false
  },
  {
   "i": 52,
   "t": 146.36,
   "bdur": 2.6,
   "name": "S2",
   "text": "Да, он занимает много места воде и раздвигает ее.",
   "vocal": false,
   "f0": 377,
   "soft": false
  },
  {
   "i": 53,
   "t": 149.28,
   "bdur": 1.96,
   "name": "S4",
   "text": "А вода толкает корабль вверх.",
   "vocal": false,
   "f0": 227,
   "soft": false
  },
  {
   "i": 54,
   "t": 151.2,
   "bdur": 1.82,
   "name": "S2",
   "text": "И удерживает весь его вес.",
   "vocal": false,
   "f0": 295,
   "soft": false
  },
  {
   "i": 55,
   "t": 153.28,
   "bdur": 3.72,
   "name": "S4",
   "text": "Верно, если корабль не слишком тяжелый для своего размера.",
   "vocal": false,
   "f0": 211,
   "soft": false
  },
  {
   "i": 56,
   "t": 156.92,
   "bdur": 1.04,
   "name": "S2",
   "text": "Теперь понятно,",
   "vocal": false,
   "f0": 304,
   "soft": false
  },
  {
   "i": 57,
   "t": 158.12,
   "bdur": 1.74,
   "name": "S2",
   "text": "зачем ему столько места внутри.",
   "vocal": false,
   "f0": 313,
   "soft": false
  },
  {
   "i": 58,
   "t": 162.18,
   "bdur": 3.56,
   "name": "S6",
   "text": "Тогда в корабль можно складывать сколько угодно вещей.",
   "vocal": false,
   "f0": 165,
   "soft": false
  },
  {
   "i": 59,
   "t": 166.74,
   "bdur": 1.82,
   "name": "S2",
   "text": "Каждая вещь добавляет вес.",
   "vocal": false,
   "f0": 275,
   "soft": false
  },
  {
   "i": 60,
   "t": 168.78,
   "bdur": 2.94,
   "name": "S2",
   "text": "Верно, если перегрузить корабль, он может утонуть.",
   "vocal": false,
   "f0": 374,
   "soft": false
  },
  {
   "i": 61,
   "t": 171.72,
   "bdur": 1.9,
   "name": "S2",
   "text": "Даже если вещи очень нужные?",
   "vocal": false,
   "f0": 319,
   "soft": false
  },
  {
   "i": 62,
   "t": 173.42,
   "bdur": 1.62,
   "name": "S4",
   "text": "Даже тогда.",
   "vocal": false,
   "f0": 223,
   "soft": false
  },
  {
   "i": 63,
   "t": 175.02,
   "bdur": 2.4,
   "name": "S2",
   "text": "Придется оставить коллекцию камней дома.",
   "vocal": false,
   "f0": 311,
   "soft": false
  },
  {
   "i": 64,
   "t": 177.76,
   "bdur": 2.14,
   "name": "S6",
   "text": "А если внутрь попадет много воды?",
   "vocal": false,
   "f0": 168,
   "soft": false
  },
  {
   "i": 65,
   "t": 180.24,
   "bdur": 2.18,
   "name": "S2",
   "text": "Корабль тоже станет тяжелее.",
   "vocal": false,
   "f0": 289,
   "soft": false
  },
  {
   "i": 66,
   "t": 182.64,
   "bdur": 2.38,
   "name": "S2",
   "text": "Поэтому важно, чтобы корпус был целым.",
   "vocal": false,
   "f0": 377,
   "soft": false
  },
  {
   "i": 67,
   "t": 186.68,
   "bdur": 3.16,
   "name": "S2",
   "text": "Снаружи вода помогает, а внутри может мешать.",
   "vocal": false,
   "f0": 306,
   "soft": false
  },
  {
   "i": 68,
   "t": 190.74,
   "bdur": 3.1,
   "name": "S2",
   "text": "Кажется, я придумал, как проверить, что мы поняли.",
   "vocal": false,
   "f0": 334,
   "soft": false
  },
  {
   "i": 69,
   "t": 194.18,
   "bdur": 1.12,
   "name": "S6",
   "text": "Проведешь игру?",
   "vocal": false,
   "f0": 171,
   "soft": false
  },
  {
   "i": 70,
   "t": 195.64,
   "bdur": 0.92,
   "name": "S2",
   "text": "Попробую.",
   "vocal": false,
   "f0": 254,
   "soft": false
  },
  {
   "i": 71,
   "t": 198.7,
   "bdur": 1.38,
   "name": "S2",
   "text": "У нас будет капитан.",
   "vocal": false,
   "f0": 318,
   "soft": false
  },
  {
   "i": 72,
   "t": 201.72,
   "bdur": 2.02,
   "name": "S6",
   "text": "Капитан, Мишка готов слушать.",
   "vocal": false,
   "f0": 169,
   "soft": false
  },
  {
   "i": 73,
   "t": 203.96,
   "bdur": 1.12,
   "name": "S2",
   "text": "Я буду говорить.",
   "vocal": false,
   "f0": 304,
   "soft": false
  },
  {
   "i": 74,
   "t": 205.34,
   "bdur": 1.86,
   "name": "S2",
   "text": "Если согласны, кивните.",
   "vocal": false,
   "f0": 284,
   "soft": false
  },
  {
   "i": 75,
   "t": 207.0,
   "bdur": 2.48,
   "name": "S2",
   "text": "Если нет, покачайте головой.",
   "vocal": false,
   "f0": 290,
   "soft": false
  },
  {
   "i": 76,
   "t": 210.02,
   "bdur": 0.94,
   "name": "S3",
   "text": "Начинай.",
   "vocal": false,
   "f0": 252,
   "soft": false
  },
  {
   "i": 77,
   "t": 210.92,
   "bdur": 2.5,
   "name": "S2",
   "text": "Маленький предмет обязательно плавает.",
   "vocal": false,
   "f0": 287,
   "soft": false
  },
  {
   "i": 78,
   "t": 217.75,
   "bdur": 2.52,
   "name": "S2",
   "text": "Нет, маленький камень может утонуть.",
   "vocal": false,
   "f0": 302,
   "soft": false
  },
  {
   "i": 79,
   "t": 221.19,
   "bdur": 1.48,
   "name": "S6",
   "text": "Капитан согласен.",
   "vocal": false,
   "f0": 164,
   "soft": false
  },
  {
   "i": 80,
   "t": 222.85,
   "bdur": 2.9,
   "name": "S2",
   "text": "Вода толкает вверх только деревянные предметы.",
   "vocal": false,
   "f0": 290,
   "soft": false
  },
  {
   "i": 81,
   "t": 230.28,
   "bdur": 1.42,
   "name": "S2",
   "text": "Нет, металлические тоже.",
   "vocal": false,
   "f0": 366,
   "soft": false
  },
  {
   "i": 82,
   "t": 231.98,
   "bdur": 1.92,
   "name": "S2",
   "text": "Просто ложкой удержать не получается.",
   "vocal": false,
   "f0": 346,
   "soft": false
  },
  {
   "i": 83,
   "t": 234.62,
   "bdur": 0.76,
   "name": "S2",
   "text": "Ура!",
   "vocal": false,
   "f0": 299,
   "soft": false
  },
  {
   "i": 84,
   "t": 236.23,
   "bdur": 2.46,
   "name": "S2",
   "text": "Правильно, а теперь самый хитрый вопрос.",
   "vocal": false,
   "f0": 298,
   "soft": false
  },
  {
   "i": 85,
   "t": 240.37,
   "bdur": 3.44,
   "name": "S2",
