[{"name": "ef006", "text": "Сейчас узнаем, кто там!", "ipa": [[7, 6, "uzˈnajim"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff006", "text": "Сейчас узнаем, кто там!", "ipa": [[7, 6, "uzˈnajim"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef011", "text": "Может, это ключ от дома?", "ipa": [[19, 4, "ˈdoma"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff011", "text": "Может, это ключ от дома?", "ipa": [[19, 4, "ˈdoma"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef012", "text": "Смотрите! Волшебная дверь!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff012", "text": "Смотрите! Волшебная дверь!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef019", "text": "Рон! Мы уже на земле!", "ipa": [[8, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff019", "text": "Рон! Мы уже на земле!", "ipa": [[8, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef027", "text": "Странно! В лесу никого!", "ipa": [[11, 4, "lʲiˈsu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff027", "text": "Странно! В лесу никого!", "ipa": [[11, 4, "lʲiˈsu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef032", "text": "Смотрите! Какие необычные украшения!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff032", "text": "Смотрите! Какие необычные украшения!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef033", "text": "А почему везде страшные лица?", "ipa": [[24, 4, "ˈlʲitsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff033", "text": "А почему везде страшные лица?", "ipa": [[24, 4, "ˈlʲitsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef043", "text": "А из них делают пироги?", "ipa": [[16, 6, "pʲiraˈgʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff043", "text": "А из них делают пироги?", "ipa": [[16, 6, "pʲiraˈgʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef046", "text": "А вот это уже не пирог!", "ipa": [[10, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff046", "text": "А вот это уже не пирог!", "ipa": [[10, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef049", "text": "Смотрите! Огромная тыква!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff049", "text": "Смотрите! Огромная тыква!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef050", "text": "У неё светятся глаза!", "ipa": [[15, 5, "glaˈza"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff050", "text": "У неё светятся глаза!", "ipa": [[15, 5, "glaˈza"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef055", "text": "А я уже хотел убежать!", "ipa": [[4, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff055", "text": "А я уже хотел убежать!", "ipa": [[4, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef082", "text": "Я готов!", "ipa": [[2, 5, "gaˈtof"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff082", "text": "Я готов!", "ipa": [[2, 5, "gaˈtof"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef088", "text": "Смотрите! Ещё одна тыква!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff088", "text": "Смотрите! Ещё одна тыква!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef121", "text": "Смотрите! Впереди появилась дверь!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff121", "text": "Смотрите! Впереди появилась дверь!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef124", "text": "А кто стучит с другой стороны?", "ipa": [[22, 7, "staraˈnɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff124", "text": "А кто стучит с другой стороны?", "ipa": [[22, 7, "staraˈnɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef127", "text": "В лесу было тихо и тепло. Барсик гулял по поляне и смотрел на высокие деревья.", "ipa": [[2, 4, "lʲiˈsu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff127", "text": "В лесу было тихо и тепло. Барсик гулял по поляне и смотрел на высокие деревья.", "ipa": [[2, 4, "lʲiˈsu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef129", "text": "Смотрите, какой старый замок на двери!", "ipa": [[0, 8, "smaˈtrʲitʲi"], [10, 5, "kaˈkoj"], [23, 5, "zaˈmok"], [32, 5, "dvʲiˈrʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff129", "text": "Смотрите, какой старый замок на двери!", "ipa": [[0, 8, "smaˈtrʲitʲi"], [10, 5, "kaˈkoj"], [23, 5, "zaˈmok"], [32, 5, "dvʲiˈrʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef133", "text": "Вечером друзья вернулись домой. Пик уже спал, а Рон снял кепку и почесал за ухом.", "ipa": [[36, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff133", "text": "Вечером друзья вернулись домой. Пик уже спал, а Рон снял кепку и почесал за ухом.", "ipa": [[36, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef134", "text": "Какой чудесный был день!", "ipa": [[0, 5, "kaˈkoj"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff134", "text": "Какой чудесный был день!", "ipa": [[0, 5, "kaˈkoj"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef135", "text": "А Барсик закрыл глаза и улыбнулся: он знал, что тайна совсем рядом.", "ipa": [[16, 5, "glaˈza"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff135", "text": "А Барсик закрыл глаза и улыбнулся: он знал, что тайна совсем рядом.", "ipa": [[16, 5, "glaˈza"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef137", "text": "У реки стоял старый замок.", "ipa": [[2, 4, "rʲiˈkʲi"], [20, 5, "ˈzamak"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff137", "text": "У реки стоял старый замок.", "ipa": [[2, 4, "rʲiˈkʲi"], [20, 5, "ˈzamak"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef138", "text": "Смотрите, возле двери лежит золотой ключ!", "ipa": [[0, 8, "smaˈtrʲitʲi"], [16, 5, "dvʲiˈrʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff138", "text": "Смотрите, возле двери лежит золотой ключ!", "ipa": [[0, 8, "smaˈtrʲitʲi"], [16, 5, "dvʲiˈrʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef139", "text": "Мы весь день сидели дома, а у печи грелся кот.", "ipa": [[20, 4, "ˈdoma"], [30, 4, "pʲiˈtʃʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff139", "text": "Мы весь день сидели дома, а у печи грелся кот.", "ipa": [[20, 4, "ˈdoma"], [30, 4, "pʲiˈʧi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef142", "text": "Рон! Ты даже не спросил, какой торт!", "ipa": [[25, 5, "kaˈkoj"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff142", "text": "Рон! Ты даже не спросил, какой торт!", "ipa": [[25, 5, "kaˈkoj"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef147", "text": "Мои руки устали, а до горы ещё далеко.", "ipa": [[4, 4, "ˈrukʲi"], [9, 6, "usˈtalʲi"], [22, 4, "gaˈrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff147", "text": "Мои руки устали, а до горы ещё далеко.", "ipa": [[4, 4, "ˈrukʲi"], [9, 6, "usˈtalʲi"], [22, 4, "gaˈrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef150", "text": "Ой, там кто-то шевелится в кустах!", "ipa": [[15, 9, "ʃɨˈvʲelʲitsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff150", "text": "Ой, там кто-то шевелится в кустах!", "ipa": [[15, 9, "ʃɨˈvʲelʲitsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef162", "text": "Этот подарок самому лучшему другу.", "ipa": [[13, 6, "ˈsamamu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff162", "text": "Этот подарок самому лучшему другу.", "ipa": [[13, 6, "ˈsamamu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef165", "text": "Кто -то мог слушать из леса.", "ipa": [[23, 4, "ˈlʲesa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff165", "text": "Кто -то мог слушать из леса.", "ipa": [[23, 4, "ˈlʲesa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef210", "text": "Ну, потом.", "ipa": [[4, 5, "paˈtom"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff210", "text": "Ну, потом.", "ipa": [[4, 5, "paˈtom"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef223", "text": "Пронул леса.", "ipa": [[7, 4, "lʲiˈsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff223", "text": "Пронул леса.", "ipa": [[7, 4, "lʲiˈsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef236", "text": "Помнишь, какого цвета мяч в силе?", "ipa": [[16, 5, "ˈtsvʲeta"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff236", "text": "Помнишь, какого цвета мяч в силе?", "ipa": [[16, 5, "ˈtsvʲeta"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef251", "text": "Смотрите, красный мяч возле грёзы.", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff251", "text": "Смотрите, красный мяч возле грёзы.", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef272", "text": "А потом подумал, что сначала сам должен стать самым лучшим.", "ipa": [[2, 5, "paˈtom"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff272", "text": "А потом подумал, что сначала сам должен стать самым лучшим.", "ipa": [[2, 5, "paˈtom"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef283", "text": "Мы ведь уже играли вместе.", "ipa": [[8, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff283", "text": "Мы ведь уже играли вместе.", "ipa": [[8, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef289", "text": "Я готов удивляться.", "ipa": [[2, 5, "gaˈtof"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff289", "text": "Я готов удивляться.", "ipa": [[2, 5, "gaˈtof"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef290", "text": "Ты уже удивляешься.", "ipa": [[3, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff290", "text": "Ты уже удивляешься.", "ipa": [[3, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef318", "text": "Теперь будет моя загадка.", "ipa": [[13, 3, "maˈja"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff318", "text": "Теперь будет моя загадка.", "ipa": [[13, 3, "maˈja"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef321", "text": "Уже угадали?", "ipa": [[0, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff321", "text": "Уже угадали?", "ipa": [[0, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef329", "text": "Мы уже дружим, нам больше никто не нужен.", "ipa": [[3, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff329", "text": "Мы уже дружим, нам больше никто не нужен.", "ipa": [[3, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef330", "text": "Хорошо, что ты всё -таки пришёл?", "ipa": [[15, 3, "ˈfsʲo"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff330", "text": "Хорошо, что ты всё -таки пришёл?", "ipa": [[15, 3, "ˈfsʲo"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef341", "text": "Мы же ещё не все игры попробовали.", "ipa": [[13, 3, "ˈfsʲe"], [17, 4, "ˈigrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff341", "text": "Мы же ещё не все игры попробовали.", "ipa": [[13, 3, "ˈfsʲe"], [17, 4, "ˈigrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef351", "text": "Приходите утром, солнечный луч покажет дорогу.", "ipa": [[0, 9, "prʲixaˈdʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff351", "text": "Приходите утром, солнечный луч покажет дорогу.", "ipa": [[0, 9, "prʲixaˈdʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef354", "text": "Все вместе?", "ipa": [[0, 3, "ˈfsʲe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff354", "text": "Все вместе?", "ipa": [[0, 3, "ˈfsʲe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef355", "text": "Все вместе.", "ipa": [[0, 3, "ˈfsʲe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff355", "text": "Все вместе.", "ipa": [[0, 3, "ˈfsʲe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef359", "text": "Узнаем в следующей серии.", "ipa": [[0, 6, "uzˈnajim"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff359", "text": "Узнаем в следующей серии.", "ipa": [[0, 6, "uzˈnajim"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef376", "text": "Начало помнишь?", "ipa": [[0, 6, "naˈtʃʲala"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff376", "text": "Начало помнишь?", "ipa": [[0, 6, "naˈʧala"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef381", "text": "А зонтик подождет команду дома.", "ipa": [[26, 4, "ˈdoma"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff381", "text": "А зонтик подождет команду дома.", "ipa": [[26, 4, "ˈdoma"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef382", "text": "Нужно повернуть у большого дерева.", "ipa": [[27, 6, "ˈdʲerʲiva"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ff382", "text": "Нужно повернуть у большого дерева.", "ipa": [[27, 6, "ˈdʲerʲiva"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "ef383", "text": "Больших деревь