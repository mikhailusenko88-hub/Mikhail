[{"name": "cf006", "text": "Сейчас узнаем, кто там!", "ipa": [[7, 6, "ʊzˈnajɪm"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df006", "text": "Сейчас узнаем, кто там!", "ipa": [[7, 6, "uzˈnajim"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf011", "text": "Может, это ключ от дома?", "ipa": [[19, 4, "ˈdomə"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df011", "text": "Может, это ключ от дома?", "ipa": [[19, 4, "ˈdoma"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf012", "text": "Смотрите! Волшебная дверь!", "ipa": [[0, 8, "smɐˈtrʲitʲɪ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df012", "text": "Смотрите! Волшебная дверь!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf019", "text": "Рон! Мы уже на земле!", "ipa": [[8, 3, "ʊˈʒɛ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df019", "text": "Рон! Мы уже на земле!", "ipa": [[8, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf027", "text": "Странно! В лесу никого!", "ipa": [[11, 4, "lʲɪˈsu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df027", "text": "Странно! В лесу никого!", "ipa": [[11, 4, "lʲiˈsu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf032", "text": "Смотрите! Какие необычные украшения!", "ipa": [[0, 8, "smɐˈtrʲitʲɪ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df032", "text": "Смотрите! Какие необычные украшения!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf033", "text": "А почему везде страшные лица?", "ipa": [[24, 4, "ˈlʲitsə"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df033", "text": "А почему везде страшные лица?", "ipa": [[24, 4, "ˈlʲitsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf043", "text": "А из них делают пироги?", "ipa": [[16, 6, "pʲɪrɐˈgʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df043", "text": "А из них делают пироги?", "ipa": [[16, 6, "pʲiraˈgʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf046", "text": "А вот это уже не пирог!", "ipa": [[10, 3, "ʊˈʒɛ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df046", "text": "А вот это уже не пирог!", "ipa": [[10, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf049", "text": "Смотрите! Огромная тыква!", "ipa": [[0, 8, "smɐˈtrʲitʲɪ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df049", "text": "Смотрите! Огромная тыква!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf050", "text": "У неё светятся глаза!", "ipa": [[15, 5, "glɐˈza"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df050", "text": "У неё светятся глаза!", "ipa": [[15, 5, "glaˈza"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf055", "text": "А я уже хотел убежать!", "ipa": [[4, 3, "ʊˈʒɛ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df055", "text": "А я уже хотел убежать!", "ipa": [[4, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf082", "text": "Я готов!", "ipa": [[2, 5, "gɐˈtof"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df082", "text": "Я готов!", "ipa": [[2, 5, "gaˈtof"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf088", "text": "Смотрите! Ещё одна тыква!", "ipa": [[0, 8, "smɐˈtrʲitʲɪ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df088", "text": "Смотрите! Ещё одна тыква!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf121", "text": "Смотрите! Впереди появилась дверь!", "ipa": [[0, 8, "smɐˈtrʲitʲɪ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df121", "text": "Смотрите! Впереди появилась дверь!", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf124", "text": "А кто стучит с другой стороны?", "ipa": [[22, 7, "stərɐˈnɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df124", "text": "А кто стучит с другой стороны?", "ipa": [[22, 7, "staraˈnɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf127", "text": "В лесу было тихо и тепло. Барсик гулял по поляне и смотрел на высокие деревья.", "ipa": [[2, 4, "lʲɪˈsu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df127", "text": "В лесу было тихо и тепло. Барсик гулял по поляне и смотрел на высокие деревья.", "ipa": [[2, 4, "lʲiˈsu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf129", "text": "Смотрите, какой старый замок на двери!", "ipa": [[0, 8, "smɐˈtrʲitʲɪ"], [10, 5, "kɐˈkoj"], [23, 5, "zɐˈmok"], [32, 5, "dvʲɪˈrʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df129", "text": "Смотрите, какой старый замок на двери!", "ipa": [[0, 8, "smaˈtrʲitʲi"], [10, 5, "kaˈkoj"], [23, 5, "zaˈmok"], [32, 5, "dvʲiˈrʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf133", "text": "Вечером друзья вернулись домой. Пик уже спал, а Рон снял кепку и почесал за ухом.", "ipa": [[36, 3, "ʊˈʒɛ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df133", "text": "Вечером друзья вернулись домой. Пик уже спал, а Рон снял кепку и почесал за ухом.", "ipa": [[36, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf134", "text": "Какой чудесный был день!", "ipa": [[0, 5, "kɐˈkoj"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df134", "text": "Какой чудесный был день!", "ipa": [[0, 5, "kaˈkoj"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf135", "text": "А Барсик закрыл глаза и улыбнулся: он знал, что тайна совсем рядом.", "ipa": [[16, 5, "glɐˈza"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df135", "text": "А Барсик закрыл глаза и улыбнулся: он знал, что тайна совсем рядом.", "ipa": [[16, 5, "glaˈza"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf137", "text": "У реки стоял старый замок.", "ipa": [[2, 4, "rʲɪˈkʲi"], [20, 5, "ˈzamək"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df137", "text": "У реки стоял старый замок.", "ipa": [[2, 4, "rʲiˈkʲi"], [20, 5, "ˈzamak"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf138", "text": "Смотрите, возле двери лежит золотой ключ!", "ipa": [[0, 8, "smɐˈtrʲitʲɪ"], [16, 5, "dvʲɪˈrʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df138", "text": "Смотрите, возле двери лежит золотой ключ!", "ipa": [[0, 8, "smaˈtrʲitʲi"], [16, 5, "dvʲiˈrʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf139", "text": "Мы весь день сидели дома, а у печи грелся кот.", "ipa": [[20, 4, "ˈdomə"], [30, 4, "pʲɪˈtʃi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df139", "text": "Мы весь день сидели дома, а у печи грелся кот.", "ipa": [[20, 4, "ˈdoma"], [30, 4, "pʲiˈtʃi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf142", "text": "Рон! Ты даже не спросил, какой торт!", "ipa": [[25, 5, "kɐˈkoj"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df142", "text": "Рон! Ты даже не спросил, какой торт!", "ipa": [[25, 5, "kaˈkoj"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf147", "text": "Мои руки устали, а до горы ещё далеко.", "ipa": [[4, 4, "ˈrukʲɪ"], [9, 6, "ʊsˈtalʲɪ"], [22, 4, "gɐˈrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df147", "text": "Мои руки устали, а до горы ещё далеко.", "ipa": [[4, 4, "ˈrukʲi"], [9, 6, "usˈtalʲi"], [22, 4, "gaˈrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf150", "text": "Ой, там кто-то шевелится в кустах!", "ipa": [[15, 9, "ʃɨˈvʲelʲɪtsə"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df150", "text": "Ой, там кто-то шевелится в кустах!", "ipa": [[15, 9, "ʃɨˈvʲelʲitsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf162", "text": "Этот подарок самому лучшему другу.", "ipa": [[13, 6, "ˈsaməmʊ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df162", "text": "Этот подарок самому лучшему другу.", "ipa": [[13, 6, "ˈsamamu"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf165", "text": "Кто -то мог слушать из леса.", "ipa": [[23, 4, "ˈlʲesə"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df165", "text": "Кто -то мог слушать из леса.", "ipa": [[23, 4, "ˈlʲesa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf210", "text": "Ну, потом.", "ipa": [[4, 5, "pɐˈtom"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df210", "text": "Ну, потом.", "ipa": [[4, 5, "paˈtom"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf223", "text": "Пронул леса.", "ipa": [[7, 4, "lʲɪˈsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df223", "text": "Пронул леса.", "ipa": [[7, 4, "lʲiˈsa"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf236", "text": "Помнишь, какого цвета мяч в силе?", "ipa": [[16, 5, "ˈtsvʲetə"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df236", "text": "Помнишь, какого цвета мяч в силе?", "ipa": [[16, 5, "ˈtsvʲeta"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf251", "text": "Смотрите, красный мяч возле грёзы.", "ipa": [[0, 8, "smɐˈtrʲitʲɪ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df251", "text": "Смотрите, красный мяч возле грёзы.", "ipa": [[0, 8, "smaˈtrʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf272", "text": "А потом подумал, что сначала сам должен стать самым лучшим.", "ipa": [[2, 5, "pɐˈtom"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df272", "text": "А потом подумал, что сначала сам должен стать самым лучшим.", "ipa": [[2, 5, "paˈtom"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf283", "text": "Мы ведь уже играли вместе.", "ipa": [[8, 3, "ʊˈʒɛ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df283", "text": "Мы ведь уже играли вместе.", "ipa": [[8, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf289", "text": "Я готов удивляться.", "ipa": [[2, 5, "gɐˈtof"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df289", "text": "Я готов удивляться.", "ipa": [[2, 5, "gaˈtof"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf290", "text": "Ты уже удивляешься.", "ipa": [[3, 3, "ʊˈʒɛ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df290", "text": "Ты уже удивляешься.", "ipa": [[3, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf318", "text": "Теперь будет моя загадка.", "ipa": [[13, 3, "mɐˈja"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df318", "text": "Теперь будет моя загадка.", "ipa": [[13, 3, "maˈja"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf321", "text": "Уже угадали?", "ipa": [[0, 3, "ʊˈʒɛ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df321", "text": "Уже угадали?", "ipa": [[0, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf329", "text": "Мы уже дружим, нам больше никто не нужен.", "ipa": [[3, 3, "ʊˈʒɛ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df329", "text": "Мы уже дружим, нам больше никто не нужен.", "ipa": [[3, 3, "uˈʒe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf330", "text": "Хорошо, что ты всё -таки пришёл?", "ipa": [[15, 3, "ˈfsʲo"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df330", "text": "Хорошо, что ты всё -таки пришёл?", "ipa": [[15, 3, "ˈfsʲo"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf341", "text": "Мы же ещё не все игры попробовали.", "ipa": [[13, 3, "ˈfsʲe"], [17, 4, "ˈigrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df341", "text": "Мы же ещё не все игры попробовали.", "ipa": [[13, 3, "ˈfsʲe"], [17, 4, "ˈigrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf351", "text": "Приходите утром, солнечный луч покажет дорогу.", "ipa": [[0, 9, "prʲɪxɐˈdʲitʲɪ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df351", "text": "Приходите утром, солнечный луч покажет дорогу.", "ipa": [[0, 9, "prʲixaˈdʲitʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf354", "text": "Все вместе?", "ipa": [[0, 3, "ˈfsʲe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df354", "text": "Все вместе?", "ipa": [[0, 3, "ˈfsʲe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf355", "text": "Все вместе.", "ipa": [[0, 3, "ˈfsʲe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df355", "text": "Все вместе.", "ipa": [[0, 3, "ˈfsʲe"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf359", "text": "Узнаем в следующей серии.", "ipa": [[0, 6, "ʊzˈnajɪm"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df359", "text": "Узнаем в следующей серии.", "ipa": [[0, 6, "uzˈnajim"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf376", "text": "Начало помнишь?", "ipa": [[0, 6, "nɐˈtʃalə"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df376", "text": "Начало помнишь?", "ipa": [[0, 6, "naˈtʃala"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf381", "text": "А зонтик подождет команду дома.", "ipa": [[26, 4, "ˈdomə"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df381", "text": "А зонтик подождет команду дома.", "ipa": [[26, 4, "ˈdoma"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf382", "text": "Нужно повернуть у большого дерева.", "ipa": [[27, 6, "ˈdʲerʲɪvə"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df382", "text": "Нужно повернуть у большого дерева.", "ipa": [[27, 6, "ˈdʲerʲiva"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf383", "text": "Больших деревьев целый лес.", "ipa": [[0, 7, "bɐlʲˈʃɨx"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df383", "text": "Больших деревьев целый лес.", "ipa": [[0, 7, "balʲˈʃɨx"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf397", "text": "Смотрите, большая греза.", "ipa": [[0, 8, "smɐˈtrʲitʲɪ"], [10, 7, "bɐlʲˈʃajə"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df397", "text": "Смотрите, большая греза.", "ipa": [[0, 8, "smaˈtrʲitʲi"], [10, 7, "balʲˈʃaja"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf402", "text": "Веди нас, Филя.", "ipa": [[0, 4, "vʲɪˈdʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df402", "text": "Веди нас, Филя.", "ipa": [[0, 4, "vʲiˈdʲi"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf405", "text": "Замечайте цвета вокруг, они помогут разбудить радугу.", "ipa": [[10, 5, "tsvʲɪˈta"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df405", "text": "Замечайте цвета вокруг, они помогут разбудить радугу.", "ipa": [[10, 5, "tsvʲiˈta"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf407", "text": "Ты тоже иногда спишь во время игры?", "ipa": [[30, 4, "ɪˈgrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df407", "text": "Ты тоже иногда спишь во время игры?", "ipa": [[30, 4, "iˈgrɨ"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf409", "text": "Начнём искать цвета.", "ipa": [[14, 5, "tsvʲɪˈta"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df409", "text": "Начнём искать цвета.", "ipa": [[14, 5, "tsvʲiˈta"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "cf411", "text": "А вот жёлтый Трава зелёная Моя шерсть оранжевая Мой шар голубой А у барсика синий Ого!", "ipa": [[27, 3, "mɐˈja"]], "base": "female", "pitch": 1.207, "rate": 0.379}, {"name": "df411", "text": "А вот жёлтый Трава зелёная Моя шерсть оранжевая Мой шар голубой А у барсика синий Ого!", "ipa": [[27, 3, "maˈja"]], "